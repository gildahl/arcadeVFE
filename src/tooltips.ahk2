#Requires AutoHotkey v2.0

;========================================================================================
;Handle the tool-tips
;See https://www.autohotkey.com/boards/viewtopic.php?style=19&f=82&t=116086&p=517471
;========================================================================================
OnMouseEvent(wp, lp, msg, hwnd)
{
    ;increase this delay if there is flicker, which can happen on long tip text due to it
    ;taking longer to load the text than the time delay between mouse events
    static iDelay := 2

    try {
        if (!gcToolTip_Checkbox.Value)
            return
    }
    catch {
        return
    }


    static iCount := 0
    if (iCount < iDelay && msg != WM_MOUSELEAVE)
    {
        iCount++
        return
    }
    
    iCount := 0

    static TME_LEAVE := 0x2, onButtonHover := false

    if msg = WM_MOUSEMOVE && !onButtonHover
    {
        TRACKMOUSEEVENT := Buffer(8 + A_PtrSize * 2)
        NumPut('UInt', TRACKMOUSEEVENT.Size,
               'UInt', TME_LEAVE,
               'Ptr', hwnd,
               'Ptr', 10, TRACKMOUSEEVENT)

        DllCall('TrackMouseEvent', 'Ptr', TRACKMOUSEEVENT)
        
        try ToolTipContents := GuiCtrlFromHwnd(hwnd).TT,ToolTip(ToolTipContents)

        ;catch {
        ;   ToolTipContents:=""
        ;    ToolTip()
        ;}
    }

    if msg = WM_MOUSELEAVE
        ToolTip() ; outside gui
}