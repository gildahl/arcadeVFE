    /**
     * Creates an empty high score object
     * @param {String} sRomName - name of the rom (without extension) whose high scores this object will hold.
     */
    static HSOCreate(sRomName)
    {
        try {
            oHS := Map()
            oHS["ROM"] := sRomName
            oHS["TABLES"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Creating highscore object: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS
    }

    /**
     * Pushes a new table to a high score object at the next available index. 
     * @param oHS - ByRef: the high score object that will be modified
     * @param {String} sTitle - a title of the table (optional)
     * @returns {Integer} - index of the table just added
     */
    static HSOAddTable(&oHS, sTitle:="")
    {
        try
        {
            oHS["TABLES"].Push(Map())
            iSz := oHS["TABLES"].Length
            if (sTitle)
                oHS["TABLES"][iSz]["TITLE"] := sTitle

            oHS["TABLES"][iSz]["DATA"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"].Length
    }

    /**
     * Adds or updates the header for a designated high score object table
     * @param oHS - ByRef: the high score object that will be modified
     * @param iTable - the integer index of the table to be updated
     * @param xHeader - the header as either an aray or a pipe-delimited string
     *                  beginning with "SCORE" and "NAME". Do not include a RANK
     *                  column as this is a dynamic column that will be created
     *                  during output. For example: "SCORE|NAME|STAGE"
     * @returns {integer} - the index of the header line just added (aways 1)
     */
    static HSOAddTableHeader(&oHS, iTable, xHeader)
    {
        try 
        {
            if (Type(xHeader) == "String")
                aHeader := StrSplit(xHeader, "|")
            else
                aHeader := xHeader         

            if (oHS["TABLES"][iTable]["DATA"].Has(1))
                oHS["TABLES"][iTable]["DATA"][1] := aHeader ;modify header
            else
                oHS["TABLES"][iTable]["DATA"].Push(aHeader) ;add header
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table header: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return 1
    }

    /**
     * Get the index of the first discovered table that has the specified tag 
     * as a table title such as "<MARQUEE/>" for MARQUEE SCORECARD tables.
     * @param oHS - The high score object that will be searched
     * @param sTag  - The tag that will be searched for
     * @returns {integer} - the index of the tagged table, or zero if not found
     */
    static HSOGetTaggedTableId(oHS, sTag)
    {
        for i, sTable in oHS["TABLES"]
        {
            if (SubStr(sTable["TITLE"], 1, StrLen(sTag)) == sTag)
            {
                return i
            }
        }

        return 0
    }

    /**
     * Adds a high score to the designated high score object table. This function also sorts the
     * table by score after adding the score, and truncates the list if it exceeds iMaxRows.
     * @param oHS - ByRef: the high score object that will be modified
     * @param iTable - the integer index of the table to be updated
     * @param xScore - the score as an array or pipe-delimited string. Must have same number of 
     *                 fields as header with the first two fields always being the SCORE (with no
     *                 commas) and NAME followed by any additional fields defined in the header.
     *                 For example: "12300|DGD|First Level".
     * @param iMaxRows - Maximum number of rows allowed in table. If 0 (the default), the list is not limited.
     * @returns {integer} - the number of scores now in the table
     */
    static HSOAddTableScore(&oHS, iTable, xScore, iMaxRows:=0)
    {
        HEADER := 1
        SCORE_COLUMN := 1

        try 
        {
            if (Type(xScore) == "String")
                aScore := StrSplit(xScore, "|")
            else
                aScore := xScore

            if (!oHS["TABLES"][iTable]["DATA"].Has(HEADER))
                return 0 ;no header found, so can't accept scores
            else
                oHS["TABLES"][iTable]["DATA"].Push(aScore)

            ;Now sort the table by score
            sScoreList := ""
            for i, nScoreLine in oHS["TABLES"][iTable]["DATA"]
            {
                if (A_Index == 1) ; header
                    continue 

                sScoreList := sScoreList "|" nScoreLine[SCORE_COLUMN]
            }

            sScoreList := Trim(sScoreList, "| ")
            sOrderedScores := Sort(sScoreList, "D| N U R")
            aOrderedScores := StrSplit(sOrderedScores, "|")

            aNewScoreList := Array()
            aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][HEADER]) ;push the OG header

            for i, sOrderedScore in aOrderedScores
            {
                for j, sScore in oHS["TABLES"][iTable]["DATA"]
                {
                    if (sScore[SCORE_COLUMN] == sOrderedScore)
                    {
                        aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][j]) ;push the sorted scores
                        continue
                    }
                }
            }

            ;trim list down to no more than iMaxRows elements
            ;removing the lowest score entries to do so
            if (iMaxRows) ;if iMaxRows==0, the list is not limited
            {
                loop
                {
                    if (aNewScoreList.Length > iMaxRows + 1) ;+1 is so we include the header
                        aNewScoreList.Pop()
                    else
                        break
                }
            }

            ;replace the original score list with the sorted one
            oHS["TABLES"][iTable]["DATA"] := aNewScoreList
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table score: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"][iTable]["DATA"].Length - 1
    }

    /**
     * Convert the contents of a high score, *.high text file into an object.
     * @param sRomName - the rom (with no extension) whose high scores this object represents
     * @param sPathOr - the path where the *.high file is expected to be found
     * @param sHighScore - ByRef: returns the score in the rank 1 position
     * @param sHighInitials - ByRef: returns the name in the rank 1 position
     * @param sHighDate - ByRef: returns the date in the rank 1 position
     * @returns {Map} - the returned/deserialized object representation of the high score file
     *                  If it is not found, null ("") will be returned
     */
    static HSODeserializeHighFile(sRomName, &sPath:="", &sHighScore:="", &sHighName:="", &sHighDate:="")
    {
        try
        {
            sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file

            ;get the file contents
            if (FileExist(sPath "\" sHighFile)) 
            {
                sHighFileContents := FileRead(sPath "\" sHighFile)
            }
            else {
                g_oLog.LogLine("INFO: The highscore file " sPath "\" sHighFile " could not be found.`n")
                return ""
            }

            if (sHighFileContents)
                oHS := HighScore.HSODeserialize(sRomName, sHighFileContents, &sHighScore, &sHighName, &sHighDate)
            else
                oHS := ""
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Reading highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }
        
        return oHS
    }

    /**
     * Deserialize a string or array representation of a *.high high score
     * table and return it as an object.
     * @param sRomName - the rom that this high score table is for
     * @param xValue - overloaded to accept either an array or a string
     * @param sHighScore - ByRef: returns the score in the rank 1 position
     * @param sHighInitials - ByRef: returns the name in the rank 1 position
     * @param sHighDate - ByRef: returns the date in the rank 1 position
     * @returns {Object} - an oHS high score table object  
     */
    static HSODeserialize(sRomName, xValue, &sHighScore:="", &sHighName:="", &sHighDate:="") 
    {
        if (!sRomName || !xValue)
            return ""

        oHS := Map()
        iTableIdx := 1

        try 
        {
            if (Type(xValue) == "String")
            {
                xValue := Trim(xValue, "`r`n `r `n")
                aHighFileContents := StrSplit(xValue, "`r`n")
            }
            else
            {
                aHighFileContents := xValue
            }

            oHS["TABLES"] := Array()
            oHS["ROM"] := sRomName
            iTableRows := 0

            for i, sLine in aHighFileContents
            {
                if (A_Index == 1 || SubStr(sLine, 1, 1) == "#") 
                {
                    if (A_Index > 1)
                    {
                        iTableIdx++
                        iTableRows := 0
                    }

                    oHS["TABLES"].Push(Map())
                    oHS["TABLES"][iTableIdx]["DATA"] := Array()

                    ;if the line is a title, write it
                    if (SubStr(sLine, 1, 1) == "#")
                    {
                        oHS["TABLES"][iTableIdx]["TITLE"] := Trim(StrReplace(sLine, "#", ""))
                        continue
                    }
                }                

                if (iTableRows++ <= g_iMaxHSTableRows)
                {                   
                    if (sLine)
                    {
                        aContents := StrSplit(sLine, "|", "`r`n")

                        ;populate high score return values
                        if (aContents[1] = "1")
                        {
                            try sHighScore := aContents[2]
                            try sHighName := aContents[3]
                            try sHighDate := aContents[4]
                        }

                        aContents.RemoveAt(1) ;remove the RANK column
                        oHS["TABLES"][iTableIdx]["DATA"].Push(aContents)
                    }
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Reading highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS
    }

    /**
     * Write a high score object to a file in the same format as Hi2Txt so that it may be
     * read similarly.
     * @param oHS - the high score object to write
     * @param sRom - the name of the rom without an extension
     * @param sPath - the path to where to write the file
     */
    static HSOSerializeHighFile(oHS, sRom, sPath)
    {
        try {
            sFile := sPath "\" sRom ".high"
            try FileDelete(sFile)

            for i, aTable in oHS["TABLES"]
            {
                bLastTable := false
                if (A_Index == oHS["TABLES"].Length)
                    bLastTable := true

                if (aTable.Has("TITLE"))
                {
                    sTableName := "# " aTable["TITLE"]
                    FileAppend(sTableName "`r`n", sFile)
                }
                else if (i > 1)
                {
                    FileAppend("#`r`n", sFile)
                }

                for i, aScoreLine in aTable["DATA"]
                {
                    sOutputLine := ""
                    for i, aColumn in aScoreLine
                    {
                        sOutputLine := sOutputLine aScoreLine[i] "|"
                    }

                    if (A_Index == 1)
                        sOutputLine := "RANK|" sOutputLine
                    else
                        sOutputLine := String(A_Index - 1) "|" sOutputLine

                    sOutputLine := Trim(sOutputLine, "| ")

                    if (A_Index == aTable["DATA"].Length && bLastTable)
                        FileAppend(sOutputLine, sFile)
                    else
                        FileAppend(sOutputLine "`r`n", sFile)
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Writing highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }
    }
 
    /**
     * This function will create a leaderboard for this rom from either the MAME plug-in created
     * *.hi highscore file for this game, and/or from an arcadeVFE *.high alternate highscore file.
     * 
     * This data will be formatted as a text, monospace table structure that can be readily 
     * displayed by the GameInfo screen. 
     * 
     * The following shows the structure of the expected format of the source data from the 
     * *.hi and/or *.high files.
     * 
     * The title line must start with a # symbol and be followed by a space. Internal tables
     * (i.e. created by arcadeVFE) may use tags to identify the type of table such as
     * # <OFFICIAL/>   -- indicates an official highscore record table
     * # <MARQUEE/>  -- indicates a "marquee" highscore table     * 
     *
     * # TOP SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|92387|DGD|6|Corvette
     *  2|8630|DGD|3|Corvette
     *  3|7000|MDD|2|Carrier
     *  # TODAY'S SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|1000|XYZ|1|Row Boat
     *  2|2100|QED|3|Cruiser
     *  3|3212|MDD|2|Corvette
     * 
     * @param sRomName - rom name (with no extension) to create the leaderboard for.
     * @returns {Array} - the leaderboard table as an array of text lines.
     */
    static HSOCreateLeaderboard(sRomName)
    {
        ;The directive indicates what should be done if a game has both a *.hi file
        ;and a "marquee" style *.high file. 
        sDirective := "BOTH" ;could be "PREFER_HI", "PREFER_HIGH", or "BOTH"
        bUsedConsole := false
 
        HighScore.ClearScore()

        sHiFile := sRomName . ".hi" ;the native .hi file
        sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file

        ;search for *.hi files in all possible folders
        ;then set g_sHighScoreFolder to where it was found
        if (g_sArcadeString != "Other")
        {
            for i, sVer in Setup.GetMAMEVersions()
            {
                global g_sHighScoreFolder := ""

                if (FileExist(g_sATCHighScoreRootFolder "\mame" sVer "\hi\" sHiFile)) 
                {
                    global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame" sVer "\hi"
                    break
                }            
            }          
        }
        else 
        {
            ;Currently hi file support in "Other" arcades is only supported if this vfe.ini key is defined
            global g_sHighScoreFolder := IniRead(g_sIniFile, "Other", "HiFileFolder", "")
        }

        sRawHighScoreTable := aRawHighScoreTable := aStdoutTable := aRecordScoreTable := ""

        ;Read *.high file for the game if one exists 
        if (FileExist(g_sPlayerHighScoreFolder "\" sHighFile))
        {
            sRawHighScoreTable := FileRead(g_sPlayerHighScoreFolder '\' sHighFile)
            aRawHighScoreTable := StrSplit(sRawHighScoreTable, "`r`n")
        }

        ;Read *.hi file if it exists using the Hi2txt utility.
        if (FileExist(g_sHighScoreFolder "\" sHiFile))
        {
            sHi2txtCommand := '-hiscoredat "' g_sHiscoreDatFolder '\hiscore.dat" -r "' g_sHighScoreFolder '\' sHiFile '"'

            OG_DetectHiddenWindows := A_DetectHiddenWindows
            DetectHiddenWindows True

            ;These first three lines (and the later FreeConsole and ProcessClose)
            ;are needed to hide the console. Without this, a console window will
            ;flash briefly on screen during startup.
            try 
            {
                Run A_ComSpec,, "Hide", &com_pid
                if (!WinWait("ahk_pid " com_pid, , 5))
                {
                    g_oLog.LogLine("ERROR: Timeout error (exceeded 5 seconds). Could not attach to console`n")
                }
                DllCall("AttachConsole", "UInt", com_pid)
                bUsedConsole := true
            }
            catch as e
            {		
                g_oLog.LogLine("ERROR: Attaching console for GetHi2TxtScores(): " g_oLog.FormatErrorMessage(e) "`n")
                ExitApp -1
            }

            try
            {
                stdout := stderr := ""

                WshShell := ComObject("WScript.Shell")

                exec := WshShell.Exec(g_sHi2txtExe  " "  sHi2txtCommand)
                stdout := exec.StdOut.ReadAll()
                stderr := exec.StdErr.ReadAll()

                ;The *.hi file culd not be read
                if (stderr || !stdout) 
                {
                    stderr := StrReplace(stderr, "Error" , "Message") ;don't want this to trigger an error beep
                    stderr := StrReplace(stderr, "`r`n", "") ;don't need the extra linefeed data
                    g_oLog.LogLine("INFO: Hi2txt could not read high score file `"" . sHiFile . "`": " . stderr . ".`n")
                    this._aLeaderboard := ""
                }
                else ;process the output
                {
                    stdout := Trim(stdout, "`r`n `r `n")
                    ChangeEncoding(&stdout, "CP0", "UTF-8")
                    aStdoutTable := StrSplit(stdout, "`r`n", A_Space)
                }
            }
            catch as e
            {		
                g_oLog.LogLine("ERROR: Executing Hi2txt: " g_oLog.FormatErrorMessage(e) "`n")
                ExitApp -1
            }
        }

        ;Load any world record tables
        if (FileExist(g_sOfficialHighScoreFolder "\" sHighFile))
        {
            sRecordScoreTable := FileRead(g_sOfficialHighScoreFolder '\' sHighFile)
            aRecordScoreTable := StrSplit(sRecordScoreTable, "`r`n")
        }
        
        try 
        {
            ;No valid high score data of either type found, so return
            if (!aRawHighScoreTable && !aStdoutTable && !aRecordScoreTable) {
                g_oLog.LogLine("INFO: No high score data could be found for `"" sRomName "`".`n")

                if (bUsedConsole)
                    FreeConsole()

                return this._aLeaderboard := ""
            }

            ;combine output if sDirective == "BOTH" and both data is available for both
            if (aRawHighScoreTable && aStdoutTable && sDirective == "BOTH")
            {
                g_oLog.LogLine("INFO: Combining high score files " sHiFile " and " sHighFile ".`n")
                
                for i, sLine in aRawHighScoreTable
                {                    
                    if (A_Index == 1 && SubStr(sLine, 1, 1) != "#")
                        aStdoutTable.Push("#")
                    
                    aStdoutTable.Push(sLine)
                }

                aRawHighScoreTable := aStdoutTable
            }
            else if ((aRawHighScoreTable || aStdoutTable) && (sDirective == "PREFER_HI" || sDirective == "BOTH")) 
            {
                if (aStdoutTable) {   
                    aRawHighScoreTable := aStdoutTable
                    g_oLog.LogLine("INFO: Using high score file: " sHiFile ".`n")
                }
                else {   
                    g_oLog.LogLine("INFO: Using high score file: " sHighFile ".`n")
                }
            }
            else if ((aRawHighScoreTable || aStdoutTable) && (sDirective == "PREFER_HIGH" || sDirective == "BOTH"))
            {
                if (aRawHighScoreTable) {                
                    g_oLog.LogLine("INFO: Using high score file: " sHighFile ".`n")
                }
                else {   
                    aRawHighScoreTable := aStdoutTable
                    g_oLog.LogLine("INFO: Using high score file: " sHiFile ".`n")
                }
            }

            ;Add any world record scores
            if (aRecordScoreTable)
            {
                for i, sLine in aRecordScoreTable
                {                    
                    if (A_Index == 1 && SubStr(sLine, 1, 1) != "#")
                        aRecordScoreTable.Push("#")
                    
                    if (!aRawHighScoreTable)
                        aRawHighScoreTable := Array()

                    aRawHighScoreTable.Push(sLine)
                }
            }
    
            ;if aRawHighScoreTable was successfully created, create the high score table
            if (aRawHighScoreTable)
            { 
                aLeaderboard := Array()

                ;Deserialize the raw table into a structured high score object
                oHS := HighScore.HSODeserialize(sRomName, aRawHighScoreTable)

                iSubTableRows := 0
                HEADER := 1

                ;Fuzzy search columns for SCORE, NAME, and STAGE if they exist and have values.               
                for i, aTable in oHS["TABLES"] 
                { 
                    aTable["SCORE_COLUMN"] := 0

                    ;identify output columns
                    iScoreColumn := 0, bFound := false
                    for iColumn, sHeader in aTable["DATA"][HEADER] ;1 is the record containing the headers
                    { 
                        ;look for a column containing the text "SCORE" and values
                        ;Defender, for example, may only have scores in the "TODAYS SCORE" column
                        ;which this will resolve.
                        if (InStr(sHeader, "SCORE")) 
                        {
                            iProvisionalScoreColumn := iColumn

                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == HEADER) ;skip header
                                    continue
                               
                                iValue:= aTable["DATA"][A_Index][iColumn]
                                
                                ;The zero check is to allow a literal zero to qualify as a value
                                if (iValue == "0" || (iValue && IsNumber(iValue)))
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iScoreColumn := iColumn
                                break
                            }
                        }
                    }

                    aTable["SCORE_COLUMN"] := iScoreColumn := iScoreColumn ? iScoreColumn : iProvisionalScoreColumn

                    if (!iScoreColumn)
                    {
                        g_oLog.LogLine("WARNING: A required column header containing the text `"SCORE`" column not found in high score table.")
                    }

                    iNameColumn := iProvisionalNameColumn := 0, bFound := false
                    for iColumn, sHeader in aTable["DATA"][HEADER] 
                    { 
                        aTable["NAME_COLUMN"] := 0

                        ;look for a column containing the text "NAME"
                        ;Defender, for example, may only have names in the "TODAYS NAME" column
                        ;which this will resolve.
                        if (InStr(sHeader, "NAME")) 
                        {        
                            iProvisionalNameColumn := iColumn 
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == HEADER) ;skip header
                                    continue
                               
                                iValue := aTable["DATA"][A_Index][iColumn]
                                if (iValue)
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound) ;found a NAME column with a value
                            {
                                iNameColumn := iColumn 
                                break
                            }
                        }
                    }

                    aTable["NAME_COLUMN"] := iNameColumn := iNameColumn ? iNameColumn : iProvisionalNameColumn

                    iStageColumn := iProvisionalStageColumn := 0, bFound := false
                    for iColumn, sHeader in aTable["DATA"][HEADER] 
                    { 
                        aTable["STAGE_COLUMN"] := 0

                        if (InStr(sHeader, "STAGE")) 
                        {
                            iProvisionalStageColumn := iColumn
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == HEADER) ;skip header
                                    continue
                               
                                iValue := aTable["DATA"][A_Index][iColumn]
                                if (iValue)
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iStageColumn := iColumn 
                                break
                            }
                        }
                    }

                    aTable["STAGE_COLUMN"] := iStageColumn := iStageColumn ? iStageColumn : iProvisionalStageColumn

                    iLocationColumn := iProvisionalLocationColumn := 0, bFound := false
                    for iColumn, sHeader in aTable["DATA"][HEADER] 
                    { 
                        aTable["LOCATION_COLUMN"] := 0

                        if (InStr(sHeader, "LOCATION")) 
                        {
                            iProvisionalLocationColumn := iColumn
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == HEADER) ;skip header
                                    continue
                               
                                iValue := aTable["DATA"][A_Index][iColumn]
                                if (iValue)
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iLocationColumn := iColumn 
                                break
                            }
                        }
                    }

                    aTable["LOCATION_COLUMN"] := iLocationColumn := iLocationColumn ? iLocationColumn : iProvisionalLocationColumn
        
                    ;Format the score column with commas
                    for i, aLine in aTable["DATA"]
                    {
                        if (A_Index == HEADER) ;skip the header
                            continue

                        aLine[iScoreColumn] := IsNumber(aLine[iScoreColumn]) ? ThouSep(Number(aLine[iScoreColumn])) : aLine[iScoreColumn]
                    }

                    ;Create a column-width helper catalog for this 
                    ;table based on each column's longest string
                    aColumnWidths := Array()
                    Loop aTable["DATA"][HEADER].Length ;loop through each column in table
                    {
                        iWidth := 0
                        iColumn := A_Index
                        loop aTable["DATA"].Length ;Loop through each row in the column
                        {                        
                            ;find the widest string in the column  
                            if (StrLen(aTable["DATA"][A_Index][iColumn]) > iWidth)
                                iWidth := StrLen(aTable["DATA"][A_Index][iColumn])
                        }

                        aColumnWidths.Push(iWidth)
                    }

                    ;if there's a title field and value, push it into aLeaderboard
                    aSkipColumns := Array()
                    if (aTable.Has("TITLE") && aTable["TITLE"]) 
                    {
                        if (A_Index > 1)
                            aLeaderboard.Push("`n")

                        aLeaderboard.Push(aTable["TITLE"])

                        ;if columns in a table should be skipped, mark them here
                        if (InStr(aTable["TITLE"], "<OFFICIAL/>")) ;Locations are long so provisionally remove them
                            aSkipColumns.Push(iLocationColumn)
                    }
                    
                    ;Look-up whether the game needs to support non-monospace 
                    ;characters in the NAME column.
                    bWideChar := IniRead(g_sRomRefFile, "WideChar", sRomName, 0)
                    if (!bWideChar)
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - grid format
                        ; This method builds a grid that assumes a monospace
                        ; font is always being used.
                        ;******************************************************

                        ;create the top line
                        sLine := "┌" RepeatChar("─", 4) ;rank column
                        for iColumn, sHeader in aTable["DATA"][HEADER] {  
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue
                            sLine := sLine "┬" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┐")

                        ;create the header line
                        sLine := "│RANK"
                        for iColumn, sHeader in aTable["DATA"][HEADER] { 
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue
                            sLine := sLine "│" PadString(sHeader, aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "│")

                        ;create the header separator bar
                        sLine := "├" RepeatChar("─", 4) ;rank column
                        for iColumn, sHeader in aTable["DATA"][HEADER] {
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue
                            sLine := sLine "┼" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┤")

                        ;create the table rows
                        iRows := aTable["DATA"].Length-1
                        Loop iRows
                        {
                            sLine := PadString("│" String(A_Index), 5) ;the RANK
                            
                            for iColumn, sContent in aTable["DATA"][A_Index + HEADER]
                            {
                                if (IsValueInArray(aSkipColumns, iColumn))
                                    continue

                                ;tag the filed with <player>DGD</player> tags if it contains
                                ;player initials (i.e. the initals defined in the Initial Setup dialog)
                                if (iColumn == aTable["NAME_COLUMN"]) 
                                {
                                    ;decorate the value if it is a player name (GameInfo needs this)
                                    if (IsValueInArray(g_oInitials, Trim(sContent)))
                                    {
                                        sLine := "<player>" sLine "</player>"
                                    }
                                }

                                sLine := sLine "│" PadString(sContent, aColumnWidths[A_Index])
                            }
                            aLeaderboard.Push(sLine "│")
                        }

                        ;create the bottom line
                        sLine := "└" RepeatChar("─", 4) ;rank column
                        for iColumn, sHeader in aTable["DATA"][HEADER] {     
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue

                            sLine := sLine "┴" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┘")
                        ;******************************************************
                    }
                    else
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - gridless variant
                        ; This version has no column dividers and moves the NAME
                        ; column to the end to prevent format issues arising
                        ; from the presence of non-monospace characters.
                        ;******************************************************

                        ;create the top line
                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for iColumn, sHeader in aTable["DATA"][HEADER] 
                        {
                            ;skip this/these column(s)
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue

                            ;move this column to the end
                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameField
                        aLeaderboard.Push(sLine "─")

                        ;create the header line
                        ;moves the NAME column to the last column position
                        sLine := "RANK "
                        sNameField := ""
                        for iColumn, sHeader in aTable["DATA"][HEADER] 
                        {
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue

                            if (sHeader == "NAME")
                                sNameField := PadString(sHeader, aColumnWidths[A_Index])
                            else
                                sLine := sLine " " PadString(sHeader, aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameField
                        aLeaderboard.Push(sLine " ")

                        ;create the header separator line
                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for iColumn, sHeader in aTable["DATA"][HEADER] 
                        {
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue

                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine " " RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameField
                        aLeaderboard.Push(sLine " ")

                        ;create the table rows
                        ;moves the NAME column to the last column position so that non-monospace
                        ;characters won't disrupt alignment of other columns
                        iRows:= aTable["DATA"].Length-1
                        Loop iRows
                        {
                            sLine := PadString(String(A_Index), 5) ;the RANK
                            sNameField := ""

                            for iColumn, sContent in aTable["DATA"][A_Index + HEADER]
                            {
                                if (IsValueInArray(aSkipColumns, iColumn))
                                    continue

                                if (iColumn == aTable["NAME_COLUMN"]) 
                                {
                                    sNameField := PadString(sContent, aColumnWidths[A_Index])

                                    ;decorate the value if it is a player name (GameInfo needs this)
                                    if (IsValueInArray(g_oInitials, Trim(sContent)))
                                    {
                                        sNameField := "<player>" sNameField "</player>"
                                    }
                                }
                                else
                                    sLine := sLine " " PadString(sContent, aColumnWidths[A_Index])
                            }
                            sLine := sLine " " sNameField
                            aLeaderboard.Push(sLine " ")
                        }

                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for iColumn, sHeader in aTable["DATA"][HEADER] 
                        {
                            if (IsValueInArray(aSkipColumns, iColumn))
                                continue

                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameField
                        aLeaderboard.Push(sLine "─")
                        ;******************************************************
                    }
                }

                this._aLeaderboard := aLeaderboard

                ;set the top score global for the current game if one exists
                iHighestScore := iHighScore := 0
                sHighestName := ""
                sHighestStage := ""
                if (iScoreColumn)
                {
                    ;some games (like centiped) are missing highscore in the first ranks
                    ;so skip down to where they begin
                    iFirstHighScoreIdx := 0
                   
                    for i, aTable in oHS["TABLES"]
                    {
                        iScoreColumn := aTable["SCORE_COLUMN"]
                        iNameColumn := aTable["NAME_COLUMN"]
                        iStageColumn := aTable["STAGE_COLUMN"]

                        ;Don't include world record score
                        iTableTitle := ""
                        try iTableTitle := aTable["TITLE"]
                        if (iTableTitle == "<OFFICIAL/>")
                            break

                        loop aTable["DATA"].length ;go through each record
                        {             
                            if (A_Index == 1) ;skip header
                                continue              

                            try iHighScore := Number(StrReplace(aTable["DATA"][A_Index][iScoreColumn], ",", ""))
                    
                            if (iHighScore >= iHighestScore)
                            {
                                iHighestScore := Number(StrReplace(iHighScore, ",", ""))
                                sHighestName := iNameColumn ? aTable["DATA"][A_Index][iNameColumn] : ""
                                sHighestStage := iStageColumn ? aTable["DATA"][A_Index][iStageColumn] : ""

                                break
                            }

                        }
                    }

                    formatted_hi_score := HighScore.FormatHighScore("High Score", ThouSep(iHighestScore), sHighestName, sHighestStage)

                    this._sFormattedHighScore := formatted_hi_score
                    this._iHighScore := IsNumber(iHighestScore) ? Number(iHighestScore) : -1 ;-1 indicates no valid score recorded
                    this._sHighInitials := sHighestName
                    this._sHighStage := sHighestStage
                }
            }
        }
        catch as e
        {		
            g_oLog.LogLine("WARNING: Processing high scores: " . g_oLog.FormatErrorMessage(e) . "`n")
        }

        if (bUsedConsole)
            FreeConsole()

        return this._aLeaderboard

        FreeConsole()
        {
            DllCall("FreeConsole")
            ProcessClose com_pid 
            DetectHiddenWindows OG_DetectHiddenWindows
        }
    }
}