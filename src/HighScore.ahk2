    /**
     * Creates an empty high score object
     * @param {String} sRomName - name of the rom (without extension) whose high scores this object will hold.
     */
    static HSOCreate(sRomName)
    {
        try {
            oHS := Map()
            oHS["ROM"] := sRomName
            oHS["TABLES"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Creating highscore object: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS
    }

    /**
     * Adds a new table to a high score object at the next available index. 
     * @param oHS - ByRef: the high score object that will be modified
     * @param {String} sTitle - a title for the table (optional)
     * @returns {Integer} - index of the table just added
     */
    static HSOAddTable(&oHS, sTitle:="")
    {
        try
        {
            oHS["TABLES"].Push(Map())
            iSz := oHS["TABLES"].Length
            if (sTitle)
                oHS["TABLES"][iSz]["TITLE"] := sTitle

            oHS["TABLES"][iSz]["DATA"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"].Length
    }

    /**
     * Adds or updates the header for a designated high score object table
     * @param oHS - ByRef: the high score object that will be modified
     * @param iTable - the integer index of the table to be updated
     * @param sHeader - the header as a pipe-delimited string beginning with "SCORE" and "NAME". 
     *                  Do not include a RANK column as this will be created during output. For
     *                  example: "SCORE|NAME|STAGE"
     * @returns {integer} - the index of the header line just added (aways 1)
     */
    static HSOAddTableHeader(&oHS, iTable, sHeader)
    {
        try 
        {
            aHeader := StrSplit(sHeader, "|")

            if (oHS["TABLES"][iTable]["DATA"].Has(1))
                oHS["TABLES"][iTable]["DATA"][1] := aHeader ;modify header
            else
                oHS["TABLES"][iTable]["DATA"].Push(aHeader) ;add header
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table header: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return 1
    }

    /**
     * Adds a high score to the designated high score object table. This function also sorts the
     * table by score after adding the score, and truncates the list if it exceeds iMaxRows.
     * @param oHS - ByRef: the high score object that will be modified
     * @param iTable - the integer index of the table to be updated
     * @param sScore - the score as a pipe-delimited string. Must have same number of fields as header
     *                 with the first two fields always being the SCORE (with no commas) and NAME
     *                 followed by any additional fields defined in the header.
     *                 For example: "12300|DGD|First Level"
     * @param iMaxRows - Maximum number of rows allowed in table. If 0 (the default), the list is not limited.
     * @returns {integer} - the number of scores now in the table
     */
    static HSOAddTableScore(&oHS, iTable, sScore, iMaxRows:=0)
    {
        try 
        {
            aScore := StrSplit(sScore, "|")

            if (!oHS["TABLES"][iTable]["DATA"].Has(1))
                return 0 ;no header found
            else
                oHS["TABLES"][iTable]["DATA"].Push(aScore)

            ;Now sort the table by score
            sScoreList := ""
            for i, nScoreLine in oHS["TABLES"][iTable]["DATA"]
            {
                if (A_Index == 1) ; header
                    continue 

                sScoreList := sScoreList "|" nScoreLine[1]
            }

            sScoreList := Trim(sScoreList, "| ")
            sScoreList := Sort(sScoreList, "D| N U R")
            aScoreList := StrSplit(sScoreList, "|")

            aNewScoreList := Array()
            aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][1]) ;header

            for i, sOrderedScore in aScoreList
            {
                for i, sScore in oHS["TABLES"][iTable]["DATA"]
                {
                    if (sScore[1] == sOrderedScore)
                    {
                        aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][i])
                        continue
                    }
                }
            }

            ;trim list down to no more than iMaxRows elements
            ;removing the lowest score entries to do so
            if (iMaxRows) ;if iMaxRows==0, the list is not limited
            {
                loop
                {
                    if (aNewScoreList.Length > iMaxRows+1) ;+1 is so we include the header
                        aNewScoreList.Pop()
                    else
                        break
                }
            }

            oHS["TABLES"][iTable]["DATA"] := aNewScoreList
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table score: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"][iTable]["DATA"].Length - 1
    }

    /**
     * Convert the contents of a high score, *.high text file into an object.
     * @param sRomName - the rom (with no extension) whose high scores this object represents
     * @param sPathOrText - ByRef: this should be received blank, and will contain the path
     *                      to the *.high file found when the method returns.
     * @returns {Map} - the returned/deserialized object representation of the highscore file
     */
    static HSODeserializeHighFile(sRomName, &sPath:="")
    {
        try
        {
            sHighScoreFolder:= ""
            sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file

            ;search for the *.high file
            if (g_sArcadeString != "Other")
            {
                if (FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHighFile)) {
                    sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
                }
                else if (FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHighFile)) {
                    sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2014\hi"
                }            
            }
            else {
                ;Currently hi file support in "Other" arcades is only supported if this vfe.ini key is defined
                sHighScoreFolder := IniRead(g_sIniFile, "Other", "HiFileFolder", "")
            }

            sPath := sHighScoreFolder ;set the ByRef sPath to return

            ;get the file contents
            if (FileExist(sHighScoreFolder "\" sHighFile)) {
                sHighFileContents := FileRead(sHighScoreFolder "\" sHighFile)
            }
            else {
                g_oLog.LogLine("INFO: The highscore file " sHighScoreFolder "\" sHighFile " could not be found.`n")
                return ""
            }

            if (sHighFileContents)
                oHS := HighScore.HSODeserialize(sRomName, sHighFileContents)
            else
                oHS := ""
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Reading highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }
        
        return oHS
    }

    /**
     * Deserialize a string or array representation of a high score table and
     * return it as an object.
     * @param sRomName - the rom that this high score table is for
     * @param xValue - overloaded to accept either an array or a string
     * @returns {Object} - an oHS high score table object  
     */
    static HSODeserialize(sRomName, xValue) 
    {
        if (!sRomName || !xValue)
            return ""

        oHS := Map()
        iTableIdx := 1

        try 
        {
            if (Type(xValue) == "String")
            {
                xValue := Trim(xValue, "`r`n `r `n")
                aHighFileContents := StrSplit(xValue, "`r`n")
            }
            else
            {
                aHighFileContents := xValue
            }

            oHS["TABLES"] := Array()
            oHS["ROM"] := sRomName
            iTableRows := 0

            for i, sLine in aHighFileContents
            {
                if (A_Index == 1 || SubStr(sLine, 1, 1) == "#") 
                {
                    if (A_Index > 1)
                    {
                        iTableIdx++
                        iTableRows := 0
                    }

                    oHS["TABLES"].Push(Map())
                    oHS["TABLES"][iTableIdx]["DATA"] := Array()

                    ;if the line is a title, write it
                    if (SubStr(sLine, 1, 1) == "#")
                    {
                        ;if (Trim(StrReplace(sLine, "#", "")) == "#")
                        oHS["TABLES"][iTableIdx]["TITLE"] := Trim(StrReplace(sLine, "#", ""))

                        continue
                    }
                }                

                if (iTableRows++ <= g_iMaxHSTableRows)
                {                   
                    if (sLine)
                    {
                        aContents := StrSplit(sLine, "|", "`r`n")
                        aContents.RemoveAt(1) ;remove the RANK column
                        oHS["TABLES"][iTableIdx]["DATA"].Push(aContents)
                    }
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Reading highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS
    }

    /**
     * Write a high score object to a file in the same format as Hi2Txt so that it may be
     * read similarly.
     * @param oHS - the high score object to write
     * @param sRom - the name of the rom without an extension
     * @param sPath - the path to where to write the file
     */
    static HSOSerializeHighFile(oHS, sRom, sPath)
    {
        try {
            sFile := sPath "\" sRom ".high"
            try FileDelete(sFile)

            for i, aTable in oHS["TABLES"]
            {
                bLastTable := false
                if (A_Index == oHS["TABLES"].Length)
                    bLastTable := true

                if (aTable.Has("TITLE"))
                {
                    sTableName := "# " aTable["TITLE"]
                    FileAppend(sTableName "`r`n", sFile)
                }

                for i, aScoreLine in aTable["DATA"]
                {
                    sOutputLine := ""
                    for i, aColumn in aScoreLine
                    {
                        sOutputLine := sOutputLine aScoreLine[i] "|"
                    }

                    if (A_Index == 1)
                        sOutputLine := "RANK|" sOutputLine
                    else
                        sOutputLine := String(A_Index - 1) "|" sOutputLine

                    sOutputLine := Trim(sOutputLine, "| ")

                    if (A_Index == aTable["DATA"].Length && bLastTable)
                        FileAppend(sOutputLine, sFile)
                    else
                        FileAppend(sOutputLine "`r`n", sFile)
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Writing highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }
    }
 
    /**
     * This function will create a leaderboard for this rom from either the MAME plug-in created
     * *.hi highscore file for this game, and/or from an arcadeVFE *.high alternate highscore file.
     * 
     * This data will be formatted as a text, monospace table structure that can be readily 
     * displayed by the GameInfo screen. 
     * 
     * The following shows the structure of the expected format of the source data from the 
     * *.hi and/or *.high files.
     * 
     * if the line beginning with ! is a directive to indicate what should be done if there is
     * both a valid *.hi and valid *.high file for the rom.  "" will process both and present
     * output from both. "USE_HIGH" will only use the *.high file, and "PREFER_HI" will only use
     * the *.hi file.
     * 
     * ! USE_HIGH    <= May be empty, "USE_HIGH", or "PREFER_HI"
     * # TOP SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|92387|DGD|6|Corvette
     *  2|8630|DGD|3|Corvette
     *  3|7000|MDD|2|Carrier
     *  # TODAY'S SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|1000|XYZ|1|Row Boat
     *  2|2100|QED|3|Cruiser
     *  3|3212|MDD|2|Corvette
     * 
     * @param sRomName - rom name (with no extension) to create the leaderboard for.
     * @returns {Array} - the leaderboard table as an array of text lines.
     */
    static HSOCreateLeaderboard(sRomName)
    {
        sRawHighScoreTable := ""

        sDirective := "BOTH" ;could be "PREFER_HI", "USE_HIGH", or "BOTH"
 
        HighScore.ClearScore()

        sHiFile := sRomName . ".hi" ;the native .hi file
        sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file

        ;search for *.hi and *.high files in all possible folders
        ;then set g_sHighScoreFolder to where it was found
        if (g_sArcadeString != "Other")
        {
            if (FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHiFile) || FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHighFile)) {
                global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
            }
            ;as of ATC 3.6 we won't likely find *.hi files here, but we could find *.high files.
            else if (FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHiFile) || FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHighFile)) {
                global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2014\hi"
            }            
            else {
                ;don't bother reporting any missing *.high files since they aren't required.
                g_oLog.LogLine("INFO: Highscore file " sRomName ".hi was not found. Skipping highscore table.`n")
                return ""
            }
        }
        else {
            ;Currently hi file support in "Other" arcades is only supported if this vfe.ini key is defined
            g_sHighScoreFolder := IniRead(g_sIniFile, "Other", "HiFileFolder", "")
            if (!g_sHighScoreFolder)
                return ""
        }

        sHi2txtCommand := '-hiscoredat "' g_sHiscoreDatFolder '\hiscore.dat" -r "' g_sHighScoreFolder '\' sHiFile '"'

        OG_DetectHiddenWindows := A_DetectHiddenWindows
        DetectHiddenWindows True

        ;These first three lines (and the later FreeConsole and ProcessClose)
        ;are needed to hide the console. Without this, a console window will
        ;flash briefly on screen during startup.
        try 
        {
            Run A_ComSpec,, "Hide", &com_pid
            WinWait "ahk_pid " com_pid
            DllCall("AttachConsole", "UInt", com_pid)
        
            WshShell := ComObject("WScript.Shell")
        }
        catch as e
        {		
            g_oLog.LogLine("ERROR: Attaching console for GetHi2TxtScores(): " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp
        }

        try 
        {
            bError := false
            aRawHighScoreTable := stdout := sHiFileName := ""

            ;check to see if there is an alternative *.high file 
            if (FileExist(g_sHighScoreFolder '\' sHighFile))
            {
                sRawHighScoreTable := FileRead(g_sHighScoreFolder '\' sHighFile)
                aRawHighScoreTable := StrSplit(sRawHighScoreTable, "`r`n")
                sHiFileName := sHighFile
                if (SubStr(aRawHighScoreTable[1], 1, 1) == "!") 
                {
                    if (InStr(aRawHighScoreTable[1], "USE_HIGH"))
                    {
                        sDirective := "USE_HIGH"
                        g_oLog.LogLine("INFO: Forcing exclusive use of high score file: " sHighFile "`n")
                        
                    }
                    else if (InStr(aRawHighScoreTable[1], "PREFER_HI"))
                    {
                        sDirective := "PREFER_HI"
                    }
                    
                    aRawHighScoreTable.RemoveAt(1)
                }
            }

            ;if we're not forcing an alternative *.high file, try reading the normal *.hi file
            ;using the Hi2txt utility.
            if (sDirective == "BOTH" || sDirective == "PREFER_HI")
            {
                exec := WshShell.Exec(g_sHi2txtExe  " "  sHi2txtCommand)
                stdout := exec.StdOut.ReadAll()
                stderr := exec.StdErr.ReadAll()
            
                if (stderr || !stdout) ;could not read the *.hi file
                {
                    bError := true
                    stderr := StrReplace(stderr, "Error" , "Message") ;don't want this to trigger an error beep
                    stderr := StrReplace(stderr, "`r`n", "") ;don't need the extra linefeed data
                    g_oLog.LogLine("INFO: Failed to read high score file `"" . sHiFile . "`": " . stderr . ".`n")
                    this._aLeaderboard := ""
                }
                else
                {
                    stdout := Trim(stdout, "`r`n `r `n")
                    ChangeEncoding(&stdout, "CP0", "UTF-8")
                    aStdoutTable := StrSplit(stdout, "`r`n", A_Space)

                    ;combine output if sDirective == "BOTH"
                    if (aRawHighScoreTable && sDirective == "BOTH")
                    {
                        g_oLog.LogLine("INFO: Using high score files " sHiFile " and " sHighFile ".`n")
                        
                        for i, sLine in aRawHighScoreTable
                        {                    
                            if (A_Index == 1 && SubStr(sLine, 1, 1) != "#")
                                aStdoutTable.Push("#")
                            
                            aStdoutTable.Push(sLine)
                        }
                    }
                    else
                    {
                        g_oLog.LogLine("INFO: Using highscore file: " sHiFile ".`n")
                    }
         
                    aRawHighScoreTable := aStdoutTable
                    sHiFileName := sHiFile
                }
            }

            ;if a aRawHighScoreTable array was created, create the highscore table
            if (aRawHighScoreTable)
            { 
                aLeaderboard := Array()

                oHS := HighScore.HSODeserialize(sRomName, aRawHighScoreTable)

                iSubTableRows := 0

                ;Fuzzy search columns for SCORE, NAME, and STAGE if they exist and if they have values.
                ;Defender is a good example of having differently named columns (TODAYS SCORE)
                
                for i, aTable in oHS["TABLES"] 
                { 
                    aTable["SCORE_COLUMN"] := 0

                    ;identify output columns
                    iScoreColumn := 0, bFound := false
                    for i, sHeader in aTable["DATA"][1] ;1 is the record containing the headers
                    { 
                        if (InStr(sHeader, "SCORE")) {
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == 1) ;skip header
                                    continue
                               
                                iValue:= aTable["DATA"][A_Index][i]
                                if (iValue && IsNumber(iValue))
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iScoreColumn := A_Index
                                aTable["SCORE_COLUMN"] := iScoreColumn 
                                break
                            }
                        }
                    }

                    iNameColumn := 0, bFound := false
                    for i, sHeader in aTable["DATA"][1] ;1 is the record containing the headers
                    { 
                        aTable["NAME_COLUMN"] := 0

                        if (InStr(sHeader, "NAME")) {
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == 1) ;skip header
                                    continue
                               
                                iValue := aTable["DATA"][A_Index][i]
                                if (iValue)
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iNameColumn := A_Index
                                aTable["NAME_COLUMN"] := iNameColumn 
                                break
                            }
                        }
                    }

                    iStageColumn := 0, bFound := false
                    for i, sHeader in aTable["DATA"][1] ;1 is the record containing the headers
                    { 
                        aTable["STAGE_COLUMN"] := 0

                        if (InStr(sHeader, "STAGE")) {
                            
                            loop aTable["DATA"].length ;go through each record  
                            {
                                if (A_Index == 1) ;skip header
                                    continue
                               
                                iValue := aTable["DATA"][A_Index][i]
                                if (iValue)
                                {
                                    bFound := true
                                    break
                                }
                            }
                    
                            if (bFound)
                            {
                                iStageColumn := A_Index
                                aTable["STAGE_COLUMN"] := iStageColumn 
                                break
                            }
                        }
                    }
                    
                    for i, aLine in aTable["DATA"]
                    {
                        if (A_Index == 1) ;skip the header
                            continue

                        aLine[iScoreColumn] := IsNumber(aLine[iScoreColumn]) ? ThouSep(Number(aLine[iScoreColumn])) : aLine[iScoreColumn]
                    }

                    ;Create a column-width catalog for this table based on
                    ;each column's longest string
                    aColumnWidths := Array()
                    Loop aTable["DATA"][1].length ;visit each column
                    {
                        iSize := 0
                        idx := A_Index
                        loop aTable["DATA"].length ;go through each record
                        {                          
                            if (StrLen(aTable["DATA"][A_Index][idx]) > iSize)
                                iSize := StrLen(aTable["DATA"][A_Index][idx])
                        }
                        aColumnWidths.Push(iSize)
                    }

                    ;if there's a title field and value, push it into the aLeaderboard
                    if (aTable.Has("TITLE") && aTable["TITLE"]) 
                    {
                        if (A_Index > 1)
                            aLeaderboard.Push("`n")

                        aLeaderboard.Push(aTable["TITLE"])
                    }
                    
                    ;Look-up whether the game needs to support non-monospace 
                    ;characters in the NAME column.
                    bWideChar := IniRead(g_sRomRefFile, "WideChar", sRomName, 0)
                    if (!bWideChar)
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - grid
                        ; This method builds a grid that assumes a monospace
                        ; font is always being used.
                        ;******************************************************

                        ;create the top line
                        sLine := "┌" RepeatChar("─", 4) ;rank column
                        for i, sHeader in aTable["DATA"][1] {  
                            sLine := sLine "┬" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┐")

                        ;create the header line
                        sLine := "│RANK"
                        for i, sHeader in aTable["DATA"][1] { 
                            sLine := sLine "│" PadString(sHeader, aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "│")

                        ;create the header separator bar
                        sLine := "├" RepeatChar("─", 4) ;rank column
                        for i, sHeader in aTable["DATA"][1] {
                            sLine := sLine "┼" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┤")

                        ;create the table rows
                        iIterations := aTable["DATA"].Length-1
                        Loop iIterations
                        {
                            sLine := PadString("│" String(A_Index), 5)
                            for i, sContent in aTable["DATA"][A_Index + 1]
                            {
                                sLine := sLine "│" PadString(sContent, aColumnWidths[A_Index])
                            }
                            aLeaderboard.Push(sLine "│")
                        }

                        ;create the bottom line
                        sLine := "└" RepeatChar("─", 4) ;rank column
                        for i, sHeader in aTable["DATA"][1] {        
                            sLine := sLine "┴" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┘")
                        ;******************************************************
                    }
                    else
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - no grid variant
                        ; This version is used exclusively for titles in which
                        ; the NAME column may contain non-monospace characters.
                        ;******************************************************

                        ;create the top line
                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for i, sHeader in aTable["DATA"][1] {
                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameField
                        aLeaderboard.Push(sLine "─")

                        ;create the header line
                        ;moves the NAME column to the last column position
                        sLine := "RANK "
                        sNameField := ""
                        for i, sHeader in aTable["DATA"][1] {
                            if (sHeader == "NAME")
                                sNameField := PadString(sHeader, aColumnWidths[A_Index])
                            else
                                sLine := sLine " " PadString(sHeader, aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameField
                        aLeaderboard.Push(sLine " ")

                        ;create the header separator line
                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for i, sHeader in aTable["DATA"][1] {
                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine " " RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameField
                        aLeaderboard.Push(sLine " ")

                        ;create the table rows
                        ;moves the NAME column to the last column position so that non-monospace
                        ;characters won't disrupt alignment of other columns
                        iIterations := aTable["DATA"].Length-1
                        Loop iIterations
                        {
                            sLine := PadString(String(A_Index), 5)
                            sNameField := ""

                            for i, sContent in aTable["DATA"][A_Index + 1]
                            {
                                if (i == aTable["NAME_COLUMN"])
                                    sNameField := PadString(sContent, aColumnWidths[A_Index])
                                else
                                    sLine := sLine " " PadString(sContent, aColumnWidths[A_Index])
                            }
                            sLine := sLine " " sNameField
                            aLeaderboard.Push(sLine " ")
                        }

                        sLine := RepeatChar("─", 5) ;rank column
                        sNameField := ""
                        for i, sHeader in aTable["DATA"][1] {
                            if (sHeader == "NAME")
                                sNameField := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameField
                        aLeaderboard.Push(sLine "─")
                        ;******************************************************
                    }
                }

                this._aLeaderboard := aLeaderboard

                ;set the top score global for the current game if one exists
                iHighestScore := iHighScore := 0
                sHighestName := ""
                sHighestStage := ""
                if (iScoreColumn)
                {
                    ;some games (like centiped) are missing highscore in the first ranks
                    ;so skip down to where they begin
                    iFirstHighScoreIdx := 0
                   
                    for i, aTable in oHS["TABLES"]
                    {
                        iScoreColumn := aTable["SCORE_COLUMN"]
                        iNameColumn := aTable["NAME_COLUMN"]
                        iStageColumn := aTable["STAGE_COLUMN"]

                        loop aTable["DATA"].length ;go through each record
                        {             
                            if (A_Index == 1) ;skip header
                                continue              

                            try iHighScore := Number(StrReplace(aTable["DATA"][A_Index][iScoreColumn], ",", ""))
                    
                            if (iHighScore > iHighestScore)
                            {
                                iHighestScore := Number(StrReplace(iHighScore, ",", ""))
                                sHighestName := iNameColumn ? aTable["DATA"][A_Index][iNameColumn] : ""
                                sHighestStage := iStageColumn ? aTable["DATA"][A_Index][iStageColumn] : ""

                                break
                            }

                        }
                    }

                    formatted_hi_score := HighScore.FormatHighScore("High Score", ThouSep(iHighestScore), sHighestName, sHighestStage)

                    this._sFormattedHighScore := formatted_hi_score
                    this._iHighScore := IsNumber(iHighestScore) ? Number(iHighestScore) : -1 ;-1 indicates no valid score recorded
                    this._sHighInitials := sHighestName
                    this._sHighStage := sHighestStage
                }
            }
        }
        catch as e
        {		
            g_oLog.LogLine("WARNING: Processing high scores: " . g_oLog.FormatErrorMessage(e) . "`n")
        }

        DllCall("FreeConsole")
        ProcessClose com_pid 

        DetectHiddenWindows OG_DetectHiddenWindows

        return this._aLeaderboard
    }
}