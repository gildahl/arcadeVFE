#Requires AutoHotkey v2.0

class HighScore
{
    static _sFormattedHighScore := ""
    static _iHighScore := 0
    static _sHighInitials := ""
    static _sHighStage := ""
    static _aLeaderboard := ""

    static FormattedHighScore
    {
        get => this._sFormattedHighScore
    }

    static Score
    {
        get => this._iHighScore
    }

    static Initials
    {
        get => this._sHighInitials
    }

    static Stage
    {
        get => this._sHighStage
    }

    static ClearScore()
    {
        this._sFormattedHighScore := ""
        this._iHighScore := -1 ;-1 indicates no valid score recorded
        this._sHighInitials := ""
        this._sHighStage := ""
    }

    static FormatHighScore(sHiLabel, sHiScore, sHiName, sHiStage)
    {
        sHiScoreText := sHiScore
        if (Trim(sHiName) != "")
            sHiName := " by " . sHiName
        else 
            sHiName := ""

        if (sHiStage)
            sHiStage := " (Stage " . Trim(sHiStage) . ")" 

        return sHiLabel . ": " . sHiScoreText . sHiName . sHiStage
    }
 
    /**
     * This function will retrieve the leaderboard for this rom from either the MAME plugin created
     * *.hi highscore file for this game, or from an arcadeVFE *.high alternate highscore file.
     * 
     * This data will then returned as a monospace table structure that can be readily displayed by
     * the GameInfo screen. 
     * 
     * The following shows the structure of the optional *.high file (which mimics the structure
     * returned by Hi2txt from the *.hi files.)
     * 
     * if the ! EXCLUSIVE line is not present, the table will only be displayed if there is not
     * a working *.hi file. When it is present, the alt table will always be used. The # line
     * is an optional title for the table. The second table shown in the example is also optional.
     * 
     * ! EXCLUSIVE
     * # TOP SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|92387|DGD|6|Corvette
     *  2|8630|DGD|3|Corvette
     *  3|7000|MDD|2|Carrier
     *  # TODAY'S SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|1000|XYZ|1|Row Boat
     *  2|2100|QED|3|Cruiser
     *  3|3212|MDD|2|Corvette
     * 
     * @param sRomName - rom name with no extension
     * @returns {Array} - the leaderboard table
     */
    static ReadHighScores(sRomName)
    {
       sHiScore := sHiName := sHiStage := ""
 
        HighScore.ClearScore()

        mColumnMap := Map() 
        aTitles := Array()
        sHiFile := sRomName . ".hi"
        sHighFile := sRomName . ".high"
 
        sHi2txtCommand := '-hiscoredat "' g_sHiscoreDatFolder '\hiscore.dat" -r "' g_sHighScoreFolder '\' sHiFile '"'

        OG_DetectHiddenWindows := A_DetectHiddenWindows
        DetectHiddenWindows True

        ;These first three lines (and the later FreeConsole and ProcessClose)
        ;are needed to hide the console. Without this, a console window will
        ;flash briefly on screen during startup.
        try 
        {
            Run A_ComSpec,, "Hide", &com_pid
            WinWait "ahk_pid " com_pid
            DllCall("AttachConsole", "UInt", com_pid)
        
            WshShell := ComObject("WScript.Shell")
        }
        catch as e
        {		
            g_olog.LogLine("ERROR: Attaching console for GetHi2TxtScores(): " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp
        }

        try 
        {
            bError := false
            bUseAltsHighFile := false
            aRawScoreTable := stdout := ssHiFileName := ""

            ;check to see if there is an alternative *.high file 
            if (FileExist(g_sHighScoreFolder '\' sHighFile))
            {
                aRawScoreTable := StrSplit(FileRead(g_sHighScoreFolder '\' sHighFile), "`r`n")
                ssHiFileName := sHighFile
                if (Trim(aRawScoreTable[1]) == "! EXCLUSIVE")
                {
                    bUseAltsHighFile := true
                    g_oLog.LogLine("INFO: Forcing (! EXCLUSIVE) use of alternate highscore file: " sHighFile "`n")
                    aRawScoreTable.RemoveAt(1) ;remove the ! EXCLUSIVE line
                }
            }

            ;if we're not forcing an alternative *.high file, try reading the normal *.hi file
            ;using the Hi2txt utility.
            if (!bUseAltsHighFile)
            {
                exec := WshShell.Exec(g_sHi2txtExe  " "  sHi2txtCommand)
                stdout := exec.StdOut.ReadAll()
                stderr := exec.StdErr.ReadAll()
            
                if (stderr || !stdout) ;could not read the *.hi file
                {
                    bError := true
                    stderr := StrReplace(stderr, "Error" , "Message") ;don't want this to trigger an error beep
                    stderr := StrReplace(stderr, "`r`n", "") ;don't need the extra linefeed data
                    g_oLog.LogLine("INFO: Failed to read sHiFile `"" . sHiFile . "`": " . stderr . ".`n")
                    this._aLeaderboard := ""
                }
                else
                {
                    ChangeEncoding(&stdout, "CP0", "UTF-8")
                    aRawScoreTable := StrSplit(stdout, "`r`n", A_Space)
                    ssHiFileName := sHiFile
                }
            }

            ;if a aRawScoreTable array was created, create the highscore table
            if (aRawScoreTable)
            { 
                g_oLog.LogLine("INFO: Using highscore file: " ssHiFileName "`n")

                aLeaderboard := Array()

                ;Loop through each subtable (for example, gauntlet has 4 tables)
                ;Most games, however, have just one.
                Loop 
                {
                    iTableRows := 0
                    iSubTableRows := 0

                    if (SubStr(aRawScoreTable[1], 1, 1) == "#") {  ;a leading "#" indicates a table header
                        aTitles.Push(StrReplace(aRawScoreTable[1], "# ", ""))
                        aRawScoreTable.RemoveAt(1)
                    }
 
                    aHeaders := StrSplit(aRawScoreTable[1], "|")
                    nScoreCount := (aRawScoreTable.Length <= g_iMaxHSTableRows) || !g_iMaxHSTableRows ? aRawScoreTable.Length : g_iMaxHSTableRows+1
                    nHeaderCount := aHeaders.Length

                    ;Create a helper map holding the contents of each column
                    Loop nHeaderCount
                    {
                        headerLoop := A_Index
                        mColumnMap[aHeaders[headerLoop]] := Array()
                        
                        Loop nScoreCount
                        {
                            if (A_Index == 1)
                                continue
                            thisValue := StrSplit(aRawScoreTable[A_Index],"|")    
                            if (!thisValue.Has(1) || SubStr(thisValue[1], 1, 1) == "#")
                            {
                                if (thisValue.Has(1)) {
                                    if (thisValue[1] && SubStr(thisValue[1], 1, 1) == "#") {
                                        iSubTableRows := A_Index - 1
                                    }
                                }
                                else
                                    continue

                                break      
                            }             
                            if (thisValue.Length >= headerLoop)
                            {
                                mColumnMap[aHeaders[headerLoop]].Push(thisValue[headerLoop])
                            }
                        }
                    }

                    ;Format the numbers in the SCORE column
                    ;If the "SCORE" column does not exist (such as Wizard of Wor) or the SCORE column
                    ;is empty, then search for another possible column containing the word "SCORE"
                    sScoreHeader := "SCORE"
                    if (!mColumnMap.Has(sScoreHeader) || !mColumnMap[sScoreHeader][1])
                    {
                        for i, sHeader in aHeaders {
                            if (InStr(sHeader, "SCORE") && mColumnMap[sHeader][1]) {
                                sScoreHeader := sHeader
                                break
                            }
                        }
                    }

                    for i, score in mColumnMap[sScoreHeader]
                    {
                        mColumnMap[sScoreHeader][A_Index] := IsNumber(score) ? ThouSep(Number(score)) : mColumnMap[sScoreHeader][A_Index]
                    }

                    ;Calculate each column's width based on its longest string
                    aColumnWidths := Array()
                    for i, sHeader in aHeaders
                    {
                        size := StrLen(sHeader)
                        for k, content in mColumnMap[sHeader]
                        {
                            if (StrLen(content) > size)
                                size := StrLen(content)
                        }

                        aColumnWidths.Push(size)
                    }

                    ;push the title into the aLeaderboard output structure
                    if (aTitles.Has(A_Index))
                    {
                        if (A_Index > 1)
                            aLeaderboard.Push("`n")

                        aLeaderboard.Push(aTitles[A_Index])
                    }
                    
                    ;Look-up whether the game needs to support non-monospace 
                    ;characters in the NAME column.
                    bWideChar := IniRead(g_sRomRefFile, "WideChar", sRomName, 0)
                    if (!bWideChar)
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - grid
                        ; This method builds a grid that assumes a monospace
                        ; font is always being used.
                        ;******************************************************

                        ;create the top line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┬"
                            if (A_Index == 1)
                                cornerChar := "┌"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┐")

                        ;create the header line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            sLine := sLine "│" PadString(sHeader, aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "│")

                        ;create the header separator bar
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┼"
                            if (A_Index == 1)
                                cornerChar := "├"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┤")

                        ;create the table rows
                        Loop mColumnMap[aHeaders[1]].Length
                        {
                            sLine := ""
                            idx := A_Index
                            for i, sHeader in aHeaders
                            {
                                sLine := sLine "│" PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                            }
                            aLeaderboard.Push(sLine "│")
                        }

                        ;create the bottom line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┴"
                            if (A_Index == 1)
                                cornerChar := "└"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┘")
                        ;******************************************************
                    }
                    else
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - no grid variant
                        ; This version is used exclusively for titles in which
                        ; the NAME column may contain non-monospace characters.
                        ;******************************************************

                        ;create the top line
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameColumn
                        aLeaderboard.Push(sLine "─")

                        ;create the header line
                        ;moves the NAME column to the last column position
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := PadString(sHeader, aColumnWidths[A_Index])
                            else
                                sLine := sLine " " PadString(sHeader, aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameColumn
                        aLeaderboard.Push(sLine " ")

                        ;create the header separator line
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine " " RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameColumn
                        aLeaderboard.Push(sLine " ")

                        ;create the table rows
                        ;moves the NAME column to the last column position so that non-monospace
                        ;characters won't disrupt alignment of other columns
                        Loop mColumnMap[aHeaders[1]].Length
                        {
                            sLine := ""
                            sNameColumn := ""
                            idx := A_Index
                            for i, sHeader in aHeaders
                            {
                                if (sHeader == "NAME")
                                    sNameColumn := PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                                else
                                    sLine := sLine " " PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                            }
                            sLine := sLine " " sNameColumn
                            aLeaderboard.Push(sLine " ")
                        }

                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameColumn
                        aLeaderboard.Push(sLine "─")
                        ;******************************************************
                    }

                    ;Delete all processed rows so that we can continue with
                    ;the next high score table if one exists.
                    if (iSubTableRows)
                    {
                        Loop iSubTableRows {
                            aRawScoreTable.RemoveAt(1)
                        }      
                        iSubTableRows := 0                  
                    }
                    else
                        break
                }

                this._aLeaderboard := aLeaderboard

                ;set the top score global for the current game if one exists
                if (mColumnMap.Has(sScoreHeader))
                {
                    ;some games (like btimem) are missing highscore in the first ranks
                    ;so skip down to where they begin
                    iFirstHighScoreIdx := 0
                    for i, score in mColumnMap[sScoreHeader]
                    {
                        if (!mColumnMap[sScoreHeader][A_Index]) {
                            iFirstHighScoreIdx := A_Index
                        }
                        else {
                            iFirstHighScoreIdx := A_Index
                            break
                        }
                    }

                    if (mColumnMap[sScoreHeader][iFirstHighScoreIdx])
                    {
                        sHiScore := Trim(mColumnMap[sScoreHeader][iFirstHighScoreIdx])

                        if (mColumnMap.Has("NAME") && mColumnMap["NAME"][1])
                        {
                            if (Trim(mColumnMap["NAME"][iFirstHighScoreIdx]))
                                sHiName := Trim(mColumnMap["NAME"][iFirstHighScoreIdx])
                        }
                        else if (mColumnMap.Has("TODAYS NAME") && mColumnMap["TODAYS NAME"][1]) { ;exception for Defender
                            if (Trim(mColumnMap["TODAYS NAME"][iFirstHighScoreIdx]))
                                sHiName := Trim(mColumnMap["TODAYS NAME"][iFirstHighScoreIdx])
                        }

                        if (mColumnMap.Has("STAGE"))
                            if (Trim(mColumnMap["STAGE"][iFirstHighScoreIdx]))
                                sHiStage := Trim(mColumnMap["STAGE"][iFirstHighScoreIdx])

                        formatted_hi_score := HighScore.FormatHighScore("High Score", sHiScore, sHiName, sHiStage)

                        this._sFormattedHighScore := formatted_hi_score
                        this._iHighScore := IsNumber(sHiScore) ? Number(sHiScore) : -1 ;-1 indicates no valid score recorded
                        this._sHighInitials := sHiName
                        this._sHighStage := sHiStage
                    }
                    else
                    {
                        ;There was a high score table, but no high scores recorded (or all zero like theend)
                        if (iFirstHighScoreIdx > 0)
                        {
                            this._sFormattedHighScore := "High Scores"
                            this._iHighScore := -1
                            this._sHighInitials := ""
                            this._sHighStage := ""
                        }
                    }
                }
            }
        }
        catch as e
        {		
            g_oLog.LogLine("WARNING: Processing high scores: " . g_oLog.FormatErrorMessage(e) . "`n")
        }

        DllCall("FreeConsole")
        ProcessClose com_pid 

        DetectHiddenWindows OG_DetectHiddenWindows

        return this._aLeaderboard
    }
}