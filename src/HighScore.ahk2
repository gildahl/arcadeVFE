    val := HighScore.HighScoreObjectAddTableScore(&mHighFile, 1, "80000|MRN|3|Boat", 4)
    HighScore.WriteHighScores(mHighFile, "!example", sFolder )
    */

    ;Creating a new high score file from scratch
    ;Table titles (sTitle) are optional if there is only one table, but required
    ;if there is more than one table.
    /*
	oHS := HighScore.HighScoreObjectCreate("frenzy")
	iTable := HighScore.HighScoreObjectAddTable(&oHS, sTitle:="TEST")
	iHeader := HighScore.HighScoreObjectAddTableHeader(&oHS, iTable, "SCORE|NAME|FLOOR")
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "10|MRN|3rd", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "8|DGD|2nd", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "120|MDD|4th", 4)
	iTable := HighScore.HighScoreObjectAddTable(&oHS, sTitle:="TEST2")
	iHeader := HighScore.HighScoreObjectAddTableHeader(&oHS, iTable, "SCORE|NAME|FLOOR|VICINITY")
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "10286|MRN|1st|here", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "1238|RGT|3rd|there", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "126900|QED|4th|everywhere", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "86543|DGD|9th|left", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "98000|LYN|20th|right", 4)
	val := HighScore.HighScoreObjectAddTableScore(&oHS, iTable, "1000|QED|4th|up", 4)
	HighScore.WriteHighScores(oHS, "frenzy", "D:\Stand Alone\Arcade Time Capsule\RetroVRArcade\Plugins\save\mame2010\hi")
    */

    /**
     * Creates an empty highscore object
     * @param {Integer} iTables - number of high score tables to create
     * @param {String} sType - may be "EXCLUSIVE" or empty
     */
    static HighScoreObjectCreate(sRomName, sType:="")
    {
        try {
            oHS := Map()
            oHS["ROM"] := sRomName

            if (sType)
                oHS["DIRECTIVE"] := sType

            oHS["TABLES"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Creating highscore object: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS
    }

    /**
     * Adds a table to a highscore object. A title is optional.
     * @param oHS - the highscore object to modify
     * @param {String} sTitle - the optional table name
     * @returns {Integer} - the number of tables in the object 
     */
    static HighScoreObjectAddTable(&oHS, sTitle:="")
    {
        try
        {
            oHS["TABLES"].Push(Map())
            iSz := oHS["TABLES"].Length
            if (sTitle)
                oHS["TABLES"][iSz]["TITLE"] := sTitle

            oHS["TABLES"][iSz]["DATA"] := Array()
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"].Length
    }

    /**
     * Adds or updates the header for a highscore object table
     * @param oHS - the highscore object to modify
     * @param iTable - the table index
     * @param sHeader - the header as a pipe-delimited string beginning with "SCORE" and "NAME". 
     *                  Do not include a RANK column as this will be created automatically.
     * @returns {integer} - the index of the header line just added (aways 1)
     */
    static HighScoreObjectAddTableHeader(&oHS, iTable, sHeader)
    {
        try 
        {
            aHeader := StrSplit(sHeader, "|")

            if (oHS["TABLES"][iTable]["DATA"].Has(1))
                oHS["TABLES"][iTable]["DATA"][1] := aHeader
            else
                oHS["TABLES"][iTable]["DATA"].Push(aHeader)
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table header: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"][iTable]["DATA"].Length
    }

    /**
     * Adds a highscore to a highscore object table.
     * @param oHS - the highscore object to modify
     * @param iTable - the table index
     * @param sScore - the score as a pipe-delimited string. Must have same number of fields as header
     *                 with the first two fields always being the SCORE (with no commas) and NAME.
     * @param iMaxRows - Maximum number of rows allowed in table. If 0, the list is not limited.
     * @returns {integer} - the index of the score line just added 
     */
    static HighScoreObjectAddTableScore(&oHS, iTable, sScore, iMaxRows:=0)
    {
        try 
        {
            aScore := StrSplit(sScore, "|")

            if (!oHS["TABLES"][iTable]["DATA"].Has(1))
                return "" ;no header found
            else
                oHS["TABLES"][iTable]["DATA"].Push(aScore)

            ;Now sort the table by score
            sScoreList := ""
            for i, nScoreLine in oHS["TABLES"][iTable]["DATA"]
            {
                if (A_Index == 1) ; header
                    continue 

                sScoreList := sScoreList "|" nScoreLine[1]
            }

            sScoreList := Trim(sScoreList, "| ")
            sScoreList := Sort(sScoreList, "D| N U R")
            aScoreList := StrSplit(sScoreList, "|")

            aNewScoreList := Array()
            aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][1]) ;header

            for i, sOrderedScore in aScoreList
            {
                for i, sScore in oHS["TABLES"][iTable]["DATA"]
                {
                    if (sScore[1] == sOrderedScore)
                    {
                        aNewScoreList.Push(oHS["TABLES"][iTable]["DATA"][i])
                        continue
                    }
                }
            }

            ;trim list down to no more than iMaxRows elements
            ;removing the lowest score entries to do so
            if (iMaxRows) ;if iMaxRows==0, the list is not limited
            {
                loop
                {
                    if (aNewScoreList.Length > iMaxRows+1) ;+1 is so we include the header
                        aNewScoreList.Pop()
                    else
                        break
                }
            }

            oHS["TABLES"][iTable]["DATA"] := aNewScoreList
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Adding highscore table score: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return oHS["TABLES"][iTable]["DATA"].Length - 1
    }

    /**
     * Read an arcadeVFE *.high highscore file into an object
     * @param sRomName - the rom for this *.high file
     * @returns {Map} - an object representation of the highscore file
     */
    static ReadHighFile(sRomName, &sPath:="")
    {
        try
        {
            sHighScoreFolder:= ""
            sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file
            mHighFile := Map()

            if (g_sArcadeString != "Other")
            {
                if (FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHighFile)) {
                    sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
                }
                else if (FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHighFile)) {
                    sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2014\hi"
                }            
            }
            else {
                ;Currently hi file support in "Other" arcades is only supported if this vfe.ini key is defined
                sHighScoreFolder := IniRead(g_sIniFile, "Other", "HiFileFolder", "")
                if (!sHighScoreFolder)
                    return ""
            }

            sPath := sHighScoreFolder

            if (FileExist(sHighScoreFolder "\" sHighFile)) {
                sHighFileContents := FileRead(sHighScoreFolder "\" sHighFile)
            }
            else {
                g_oLog.LogLine("INFO: The highscore file " sHighScoreFolder "\" sHighFile " could not be found.`n")
                return ""
            }
        
            if (sHighFileContents)
            {
                sHighFileContents := Trim(sHighFileContents, "`r`n `r `n")
                aHighFileContents := StrSplit(sHighFileContents, "`r`n")

                iTableIdx := 0
                iRowIdx := 0
                bTableHasTitle := false
                mHighFile["TABLES"] := Array()

                mHighFile["ROM"] := sRomName

                for i, sLine in aHighFileContents
                {
                    if (SubStr(sLine, 1, 1) == "!") {
                        mHighFile["DIRECTIVE"] := Trim(StrReplace(sLine, "!", ""))
                    }
                    else if (SubStr(sLine, 1, 1) == "#")
                    {
                        bTableHasTitle := true
                        iTableIdx++
                        iRowIdx := 1
                        mHighFile["TABLES"].Push(Map())
                        mHighFile["TABLES"][iTableIdx]["TITLE"] := Trim(StrReplace(sLine, "#", ""))
                    }
                    else
                    {
                        if (!mHighFile["TABLES"][iTableIdx].Has("DATA"))
                        {
                            ;The title is optional, so if its missing, do the increments here.
                            if (!bTableHasTitle)
                            {
                                iTableIdx++
                                iRowIdx := 1
                                bTableHasTitle := false
                            }

                            mHighFile["TABLES"][iTableIdx]["DATA"] := Array()
                        }

                        aContents := StrSplit(sLine, "|", "`r`n")
                        aContents.RemoveAt(1) ;remove the RANK column
                        mHighFile["TABLES"][iTableIdx]["DATA"].Push(aContents)
                    }
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Reading highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        return mHighFile
    }

    /**
     * Write a highscore object to a file in the same format as Hi2Txt so that it may be
     * read similarly.
     * @param sRom - the name of the rom without an extension
     * @param oHS - the highscore object to write
     * @param sPath - the path to where to write the file
     */
    static WriteHighScores(oHS, sRom, sPath)
    {
        try {
            sFile := sPath "\" sRom ".high"
            try FileDelete(sFile)

            if oHS.Has("DIRECTIVE")
            {
                sDirective := "! " oHS["DIRECTIVE"]
                FileAppend(sDirective "`r`n", sFile)
            }

            for i, aTable in oHS["TABLES"]
            {
                bLastTable := false
                if (A_Index == oHS["TABLES"].Length)
                    bLastTable := true

                if (aTable.Has("TITLE"))
                {
                    sTableName := "# " aTable["TITLE"]
                    FileAppend(sTableName "`r`n", sFile)
                }

                for i, aScoreLine in aTable["DATA"]
                {
                    sOutputLine := ""
                    for i, aColumn in aScoreLine
                    {
                        sOutputLine := sOutputLine aScoreLine[i] "|"
                    }

                    if (A_Index == 1)
                        sOutputLine := "RANK|" sOutputLine
                    else
                        sOutputLine := String(A_Index - 1) "|" sOutputLine

                    sOutputLine := Trim(sOutputLine, "| ")

                    if (A_Index == aTable["DATA"].Length && bLastTable)
                        FileAppend(sOutputLine, sFile)
                    else
                        FileAppend(sOutputLine "`r`n", sFile)
                }
            }
        }
        catch as e
        {
            g_oLog.LogLine("ERROR: Writing highscore file: " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }
    }
 
    /**
     * This function will retrieve the leaderboard for this rom from either the MAME plugin created
     * *.hi highscore file for this game, or from an arcadeVFE *.high alternate highscore file.
     * 
     * This data will then returned as a monospace table structure that can be readily displayed by
     * the GameInfo screen. 
     * 
     * The following shows the structure of the optional *.high file (which mimics the structure
     * returned by Hi2txt from the *.hi files.)
     * 
     * if the ! EXCLUSIVE line is not present, the table will only be displayed if there is not
     * a working *.hi file. When it is present, the alt table will always be used. The # line
     * is an optional title for the table. The second table shown in the example is also optional.
     * 
     * ! EXCLUSIVE
     * # TOP SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|92387|DGD|6|Corvette
     *  2|8630|DGD|3|Corvette
     *  3|7000|MDD|2|Carrier
     *  # TODAY'S SCORES
     *  RANK|SCORE|NAME|STAGE|SHIP
     *  1|1000|XYZ|1|Row Boat
     *  2|2100|QED|3|Cruiser
     *  3|3212|MDD|2|Corvette
     * 
     * @param sRomName - rom name with no extension
     * @returns {Array} - the leaderboard table
     */
    static ReadHighScores(sRomName)
    {
       sHiScore := sHiName := sHiStage := ""
 
        HighScore.ClearScore()

        mColumnMap := Map() 
        aTitles := Array()
        sHiFile := sRomName . ".hi" ;the native .hi file
        sHighFile := sRomName . ".high" ;the arcadeVFE alternate .high file

        ;search for *.hi and *.high files in all possible folders
        ;then set g_sHighScoreFolder to where it was found
        if (g_sArcadeString != "Other")
        {
            if (FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHiFile) || FileExist(g_sATCHighScoreRootFolder "\mame2010\hi\" sHighFile)) {
                global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
            }
            ;as of ATC 3.6 we won't likely find *.hi files here, but we could find *.high files.
            else if (FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHiFile) || FileExist(g_sATCHighScoreRootFolder "\mame2014\hi\" sHighFile)) {
                global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2014\hi"
            }            
            else {
                ;don't bother reporting any missing *.high files since they aren't required.
                g_oLog.LogLine("INFO: Highscore file " sRomName ".hi was not found. Skipping highscore table.`n")
                return
            }
        }
        else {
            ;Currently hi file support in "Other" arcades is only supported if this vfe.ini key is defined
            g_sHighScoreFolder := IniRead(g_sIniFile, "Other", "HiFileFolder", "")
            if (!g_sHighScoreFolder)
                return
        }

        sHi2txtCommand := '-hiscoredat "' g_sHiscoreDatFolder '\hiscore.dat" -r "' g_sHighScoreFolder '\' sHiFile '"'

        OG_DetectHiddenWindows := A_DetectHiddenWindows
        DetectHiddenWindows True

        ;These first three lines (and the later FreeConsole and ProcessClose)
        ;are needed to hide the console. Without this, a console window will
        ;flash briefly on screen during startup.
        try 
        {
            Run A_ComSpec,, "Hide", &com_pid
            WinWait "ahk_pid " com_pid
            DllCall("AttachConsole", "UInt", com_pid)
        
            WshShell := ComObject("WScript.Shell")
        }
        catch as e
        {		
            g_oLog.LogLine("ERROR: Attaching console for GetHi2TxtScores(): " g_oLog.FormatErrorMessage(e) "`n")
            ExitApp
        }

        try 
        {
            bError := false
            bUseAltsHighFile := false
            aRawScoreTable := stdout := ssHiFileName := ""

            ;check to see if there is an alternative *.high file 
            if (FileExist(g_sHighScoreFolder '\' sHighFile))
            {
                aRawScoreTable := StrSplit(FileRead(g_sHighScoreFolder '\' sHighFile), "`r`n")
                ssHiFileName := sHighFile
                if (Trim(aRawScoreTable[1]) == "! EXCLUSIVE")
                {
                    bUseAltsHighFile := true
                    g_oLog.LogLine("INFO: Forcing (! EXCLUSIVE) use of alternate highscore file: " sHighFile "`n")
                    aRawScoreTable.RemoveAt(1) ;remove the ! EXCLUSIVE line
                }
            }

            ;if we're not forcing an alternative *.high file, try reading the normal *.hi file
            ;using the Hi2txt utility.
            if (!bUseAltsHighFile)
            {
                exec := WshShell.Exec(g_sHi2txtExe  " "  sHi2txtCommand)
                stdout := exec.StdOut.ReadAll()
                stderr := exec.StdErr.ReadAll()
            
                if (stderr || !stdout) ;could not read the *.hi file
                {
                    bError := true
                    stderr := StrReplace(stderr, "Error" , "Message") ;don't want this to trigger an error beep
                    stderr := StrReplace(stderr, "`r`n", "") ;don't need the extra linefeed data
                    g_oLog.LogLine("INFO: Failed to read sHiFile `"" . sHiFile . "`": " . stderr . ".`n")
                    this._aLeaderboard := ""
                }
                else
                {
                    ChangeEncoding(&stdout, "CP0", "UTF-8")
                    aRawScoreTable := StrSplit(stdout, "`r`n", A_Space)
                    ssHiFileName := sHiFile
                }
            }

            ;if a aRawScoreTable array was created, create the highscore table
            if (aRawScoreTable)
            { 
                g_oLog.LogLine("INFO: Using highscore file: " ssHiFileName "`n")

                aLeaderboard := Array()

                ;Loop through each subtable (for example, gauntlet has 4 tables)
                ;Most games, however, have just one.
                Loop 
                {
                    iTableRows := 0
                    iSubTableRows := 0

                    if (SubStr(aRawScoreTable[1], 1, 1) == "#") {  ;a leading "#" indicates a table header
                        aTitles.Push(StrReplace(aRawScoreTable[1], "# ", ""))
                        aRawScoreTable.RemoveAt(1)
                    }
 
                    aHeaders := StrSplit(aRawScoreTable[1], "|")
                    nScoreCount := (aRawScoreTable.Length <= g_iMaxHSTableRows) || !g_iMaxHSTableRows ? aRawScoreTable.Length : g_iMaxHSTableRows+1
                    nHeaderCount := aHeaders.Length

                    ;Create a helper map holding the contents of each column
                    Loop nHeaderCount
                    {
                        headerLoop := A_Index
                        mColumnMap[aHeaders[headerLoop]] := Array()
                        
                        Loop nScoreCount
                        {
                            if (A_Index == 1)
                                continue
                            thisValue := StrSplit(aRawScoreTable[A_Index],"|")    
                            if (!thisValue.Has(1) || SubStr(thisValue[1], 1, 1) == "#")
                            {
                                if (thisValue.Has(1)) {
                                    if (thisValue[1] && SubStr(thisValue[1], 1, 1) == "#") {
                                        iSubTableRows := A_Index - 1
                                    }
                                }
                                else
                                    continue

                                break      
                            }             
                            if (thisValue.Length >= headerLoop)
                            {
                                mColumnMap[aHeaders[headerLoop]].Push(thisValue[headerLoop])
                            }
                        }
                    }

                    ;Format the numbers in the SCORE column
                    ;If the "SCORE" column does not exist (such as Wizard of Wor) or the SCORE column
                    ;is empty, then search for another possible column containing the word "SCORE"
                    sScoreHeader := "SCORE"
                    if (!mColumnMap.Has(sScoreHeader) || !mColumnMap[sScoreHeader][1])
                    {
                        for i, sHeader in aHeaders {
                            if (InStr(sHeader, "SCORE") && mColumnMap[sHeader][1]) {
                                sScoreHeader := sHeader
                                break
                            }
                        }
                    }

                    for i, score in mColumnMap[sScoreHeader]
                    {
                        mColumnMap[sScoreHeader][A_Index] := IsNumber(score) ? ThouSep(Number(score)) : mColumnMap[sScoreHeader][A_Index]
                    }

                    ;Calculate each column's width based on its longest string
                    aColumnWidths := Array()
                    for i, sHeader in aHeaders
                    {
                        size := StrLen(sHeader)
                        for k, content in mColumnMap[sHeader]
                        {
                            if (StrLen(content) > size)
                                size := StrLen(content)
                        }

                        aColumnWidths.Push(size)
                    }

                    ;push the title into the aLeaderboard output structure
                    if (aTitles.Has(A_Index))
                    {
                        if (A_Index > 1)
                            aLeaderboard.Push("`n")

                        aLeaderboard.Push(aTitles[A_Index])
                    }
                    
                    ;Look-up whether the game needs to support non-monospace 
                    ;characters in the NAME column.
                    bWideChar := IniRead(g_sRomRefFile, "WideChar", sRomName, 0)
                    if (!bWideChar)
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - grid
                        ; This method builds a grid that assumes a monospace
                        ; font is always being used.
                        ;******************************************************

                        ;create the top line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┬"
                            if (A_Index == 1)
                                cornerChar := "┌"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┐")

                        ;create the header line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            sLine := sLine "│" PadString(sHeader, aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "│")

                        ;create the header separator bar
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┼"
                            if (A_Index == 1)
                                cornerChar := "├"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┤")

                        ;create the table rows
                        Loop mColumnMap[aHeaders[1]].Length
                        {
                            sLine := ""
                            idx := A_Index
                            for i, sHeader in aHeaders
                            {
                                sLine := sLine "│" PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                            }
                            aLeaderboard.Push(sLine "│")
                        }

                        ;create the bottom line
                        sLine := ""
                        for i, sHeader in aHeaders {
                            CornerChar := "┴"
                            if (A_Index == 1)
                                cornerChar := "└"
        
                            sLine := sLine cornerChar RepeatChar("─", aColumnWidths[A_Index])
                        }
                        aLeaderboard.Push(sLine "┘")
                        ;******************************************************
                    }
                    else
                    {
                        ;******************************************************
                        ; Build aLeaderboard highscore table - no grid variant
                        ; This version is used exclusively for titles in which
                        ; the NAME column may contain non-monospace characters.
                        ;******************************************************

                        ;create the top line
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameColumn
                        aLeaderboard.Push(sLine "─")

                        ;create the header line
                        ;moves the NAME column to the last column position
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := PadString(sHeader, aColumnWidths[A_Index])
                            else
                                sLine := sLine " " PadString(sHeader, aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameColumn
                        aLeaderboard.Push(sLine " ")

                        ;create the header separator line
                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine " " RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine " " sNameColumn
                        aLeaderboard.Push(sLine " ")

                        ;create the table rows
                        ;moves the NAME column to the last column position so that non-monospace
                        ;characters won't disrupt alignment of other columns
                        Loop mColumnMap[aHeaders[1]].Length
                        {
                            sLine := ""
                            sNameColumn := ""
                            idx := A_Index
                            for i, sHeader in aHeaders
                            {
                                if (sHeader == "NAME")
                                    sNameColumn := PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                                else
                                    sLine := sLine " " PadString(mColumnMap[sHeader][idx], aColumnWidths[A_Index])
                            }
                            sLine := sLine " " sNameColumn
                            aLeaderboard.Push(sLine " ")
                        }

                        sLine := ""
                        sNameColumn := ""
                        for i, sHeader in aHeaders {
                            if (sHeader == "NAME")
                                sNameColumn := RepeatChar("─", aColumnWidths[A_Index])
                            else
                                sLine := sLine "─" RepeatChar("─", aColumnWidths[A_Index])
                        }
                        sLine := sLine "─" sNameColumn
                        aLeaderboard.Push(sLine "─")
                        ;******************************************************
                    }

                    ;Delete all processed rows so that we can continue with
                    ;the next high score table if one exists.
                    if (iSubTableRows)
                    {
                        Loop iSubTableRows {
                            aRawScoreTable.RemoveAt(1)
                        }      
                        iSubTableRows := 0                  
                    }
                    else
                        break
                }

                this._aLeaderboard := aLeaderboard

                ;set the top score global for the current game if one exists
                if (mColumnMap.Has(sScoreHeader))
                {
                    ;some games (like btimem) are missing highscore in the first ranks
                    ;so skip down to where they begin
                    iFirstHighScoreIdx := 0
                    for i, score in mColumnMap[sScoreHeader]
                    {
                        if (!mColumnMap[sScoreHeader][A_Index]) {
                            iFirstHighScoreIdx := A_Index
                        }
                        else {
                            iFirstHighScoreIdx := A_Index
                            break
                        }
                    }

                    if (mColumnMap[sScoreHeader][iFirstHighScoreIdx])
                    {
                        sHiScore := Trim(mColumnMap[sScoreHeader][iFirstHighScoreIdx])

                        if (mColumnMap.Has("NAME") && mColumnMap["NAME"][1])
                        {
                            if (Trim(mColumnMap["NAME"][iFirstHighScoreIdx]))
                                sHiName := Trim(mColumnMap["NAME"][iFirstHighScoreIdx])
                        }
                        else if (mColumnMap.Has("TODAYS NAME") && mColumnMap["TODAYS NAME"][1]) { ;exception for Defender
                            if (Trim(mColumnMap["TODAYS NAME"][iFirstHighScoreIdx]))
                                sHiName := Trim(mColumnMap["TODAYS NAME"][iFirstHighScoreIdx])
                        }

                        if (mColumnMap.Has("STAGE"))
                            if (Trim(mColumnMap["STAGE"][iFirstHighScoreIdx]))
                                sHiStage := Trim(mColumnMap["STAGE"][iFirstHighScoreIdx])

                        formatted_hi_score := HighScore.FormatHighScore("High Score", sHiScore, sHiName, sHiStage)

                        this._sFormattedHighScore := formatted_hi_score
                        this._iHighScore := IsNumber(sHiScore) ? Number(sHiScore) : -1 ;-1 indicates no valid score recorded
                        this._sHighInitials := sHiName
                        this._sHighStage := sHiStage
                    }
                    else
                    {
                        ;There was a high score table, but no high scores recorded (or all zero like theend)
                        if (iFirstHighScoreIdx > 0)
                        {
                            this._sFormattedHighScore := "High Scores"
                            this._iHighScore := -1
                            this._sHighInitials := ""
                            this._sHighStage := ""
                        }
                    }
                }
            }
        }
        catch as e
        {		
            g_oLog.LogLine("WARNING: Processing high scores: " . g_oLog.FormatErrorMessage(e) . "`n")
        }

        DllCall("FreeConsole")
        ProcessClose com_pid 

        DetectHiddenWindows OG_DetectHiddenWindows

        return this._aLeaderboard
    }
}