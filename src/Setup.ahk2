#Requires AutoHotkey v2.0

#include Utility.ahk2

class Setup
{
    static mSetup := Map()
    static bAutoshow := false
    static oAuditLog := AppLog()

    /**
     * Create the initial setup dialog
     */
    static CreateSetupDialog()
    {
        global

        local nIconButtonWidth := 40
        local nButtonWidth := 70
        local sSetupTitle := "arcadeVFE " g_sCodeVersionMinor " - Initial Setup"

        Setup.mSetup.Width := 550
		Setup.mSetup.Height := 220
		Setup.mSetup.X := A_ScreenWidth / 2 - Setup.mSetup.Width / 2
		Setup.mSetup.Y := A_ScreenHeight / 2 - Setup.mSetup.Height / 2 - 75

        guiSetup := Gui("-MaximizeBox -MinimizeBox", sSetupTitle)

        guiSetup.OnEvent("Close", (*) => Setup.Setup_CloseButton_Click())

        gcArcadeLabel := guiSetup.AddText("x" 25 " y" 10 " w" 250, "Choose your arcade software.")
        gcArcadeDropDown := guiSetup.AddDropDownList("x" 25 " y" 25 " w" 320 " +BackgroundWhite",)
        gcArcadeDropDown.OnEvent("Change", (*) => Setup.ArcadeDropDown_Change())
        gcArcadeDropDown.TT := "Select the arcade software you will be using. Choose `"Other`" if`nnot using ATC or a version of ATC not listed. Some features`nare disabled when selecting `"Other`"."
        
        ;Add supported arcades to the list
        ;Arcades are supported via arcade-specific files in the \Arcade subfolder (minimally *.RomList.json)
        loop files g_sArcadeFolder "\*.RomList.json"
        {
            local sArcade := SubStr(A_LoopFileName, 1, InStr(A_LoopFileName, ".") + 1)
            gcArcadeDropDown.Add([sArcade])
        }        
        
        gcArcadeDropDown.Add(["Other"])

        gcApplicationEditLabel := guiSetup.AddText("x" 25 " y" 55 " w" 350, "Application Name")
        gcApplicationEdit := guiSetup.AddEdit("x" 25 " y" 70 " w" 155 " +BackgroundWhite",)
		gcApplicationEdit.OnEvent("Change", (*) => Setup.ApplicationEdit_Change())
		gcApplicationEdit.TT := "Enter the name of the executable for this arcade. Do not`ninclude the path. For example, `"RetroVRArcade.exe`"."

        gcInitialsComboBoxLabel := guiSetup.AddText("x" 370 " y" 9 " w" 75, "Player Initials")
        gcInitialsComboBox := guiSetup.AddComboBox("x" 370 " y" 24 " w" 75 " +BackgroundWhite",)
		gcInitialsComboBox.OnEvent("Change", (*) => Setup.InitialsComboBox_Change())
		gcInitialsComboBox.TT := "These initals are used to highlight your initials in the GameInfo`nleaderboards.`n`nEnter your arcade initials as you enter them into games. If you use`nmore than one set of initials (perhaps a longer version for games`nthat accept that), you should enter those as well."

        gcAddInitialsButton := guiSetup.AddButton("x" 448 " y" 22 " w" nIconButtonWidth)
		gcAddInitialsButton.OnEvent("Click", (*) => Setup.AddInitialsButton_Click())
		gcAddInitialsButton.TT := "Add these initials to the list."
		gcAddInitialsButton.Enabled := false
		GuiButtonIcon(gcAddInitialsButton, 'icons.dll', 127, 's16') ;add (+) icon

        gcRemoveInitialsButton := guiSetup.AddButton("x" 490 " y" 22 " w" nIconButtonWidth)
		gcRemoveInitialsButton.OnEvent("Click", (*) => Setup.RemoveInitialsButton_Click())
		gcRemoveInitialsButton.TT := "Delete the selected initals from the list."
        gcRemoveInitialsButton.Enabled := false
		GuiButtonIcon(gcRemoveInitialsButton, 'icons.dll', 130, 's16') ;remove (-) icon

        Setup.ReadInitials()

		gcApplicationBrowseButton := guiSetup.AddButton("x" 183 " y" 69 " w" nIconButtonWidth)
		gcApplicationBrowseButton.OnEvent("Click", (*) => Setup.ApplicationBrowseButton_Click())
        gcApplicationBrowseButton.TT := "Browse for the arcade system executable file."
        GuiButtonIcon(gcApplicationBrowseButton, 'imageres.dll', 206, 's16')

        gcROMMonitorFolderLabel := guiSetup.AddText("x" 25 " y" 100 " w" 350, "ROM folder to monitor")
        gcROMMonitorFolderEdit := guiSetup.AddEdit("x" 25 " y" 115 " w" 462 " +BackgroundWhite",)
        gcROMMonitorFolderEdit.OnEvent("Change", (*) => Setup.ROMMonitorFolderEdit_Change())
        gcROMMonitorFolderEdit.TT := "Enter the full path to the folder containing this arcade's MAME roms.`nThe files in this folder must have an extension of *.zip."

        gcROMMonitorFolderBrowseButton := guiSetup.AddButton("x" 490 " y" 114 " w" nIconButtonWidth)
		gcROMMonitorFolderBrowseButton.OnEvent("Click", (*) => Setup.ROMMonitorFolderBrowseButton_Click())
		gcROMMonitorFolderBrowseButton.TT := "Browse for the folder containing this arcade's MAME roms.`nThe files in this folder must have an extension of *.zip."
        GuiButtonIcon(gcROMMonitorFolderBrowseButton, 'imageres.dll', 206, 's16')

        gcAuditProgress := guiSetup.AddProgress("x" 25 " y" Setup.mSetup.Height - 70 " w" Setup.mSetup.Width - 50 " h" 20 " cBlue BackgroundSilver vAuditProgress") 
        gcAuditProgress.Visible := false

        gcCopyRomsButton := guiSetup.AddButton("x" 25 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Copy Roms...")
        gcCopyRomsButton.OnEvent("Click", (*) => Setup.CopyRomsButton_Click())
        gcCopyRomsButton.TT := "Copy roms from a source`nfolder to this rom folder."

        gcAuditButton := guiSetup.AddButton("x" 108 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Audit Roms...")
        gcAuditButton.OnEvent("Click", (*) => Setup.AuditButton_Click())
        gcAuditButton.TT := "Press to perform an audit for missing and bad roms.`nA report will display when complete.`n`nIf you need a list of all Arcade Time Capsule roms and`ntheir MAME versions, run this audit on an empty folder."

        gcConfigToolsButton := guiSetup.AddButton("x" 191 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Config Tools...")
        gcConfigToolsButton.OnEvent("Click", (*) => Setup.ConfigToolsButton_Click())
        gcConfigToolsButton.TT := "Copy roms from a source`nfolder to this rom folder."

        gcApplyButton := guiSetup.AddButton("x" 367 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Apply")
        gcApplyButton.OnEvent("Click", (*) => Setup.Setup_ApplyButton_Click())
        gcApplyButton.TT := "Press to save these settings."

        gcSetup_CloseButton := guiSetup.AddButton("x" 450 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Close")
        gcSetup_CloseButton.OnEvent("Click", (*) => Setup.Setup_CloseButton_Click())
 
        Setup.PopulateFields()

        ;Force display of the Setup dialog if any or all of its fields are empty after attempting to populate its
        ;fields from the vfe.ini file. This would be expected on an initial run.
        if (!gcArcadeDropDown.Text || !gcApplicationEdit.Text || !DirExist(gcROMMonitorFolderEdit.Text))
        {
            Setup.ShowSetupDialog()
            Setup.bAutoshow := true
        }

        ;****************************  Create the Copy Roms dialog ********************************
        guiCopyRoms := Gui("-MaximizeBox -MinimizeBox", "Copy Roms into ROM folder")

        guiCopyRoms.OnEvent("Close", (*) => Setup.CopyRomsCloseButton_Click())

        gcRomVersionLabel := guiCopyRoms.AddText("x" 30 " y" 10 " w" 250, "Rom version")
        gcRomVersionDropDown := guiCopyRoms.AddDropDownList("x" 30 " y" 25 " w" 100 " +BackgroundWhite",)
        gcRomVersionDropDown.OnEvent("Change", (*) => Setup.RomVersionDropDown_Change())
        gcRomVersionDropDown.TT := "Select the version of the roms you would like to copy,`nthen use the Browse button to select the folder that`nyou would like to copy them from."

        gcCopyRomsBrowseButton := guiCopyRoms.AddButton("x" 140 " y" 22 " w" 80 " h" 22, "Browse...")
        gcCopyRomsBrowseButton.OnEvent("Click", (*) => Setup.CopyRomsBrowseButton_Click())
        gcCopyRomsBrowseButton.TT := "Browse for the source folder from which you would like to copy`nthe roms of the selected version. These roms will be copied into`nthe arcade's rom folder, overwriting any existing files."

        gcCopyRomsCloseButton := guiCopyRoms.AddButton("x" 85 " y" 100 - 35 " w" 80 " h" 25, "Close")
        gcCopyRomsCloseButton.OnEvent("Click", (*) => Setup.CopyRomsCloseButton_Click())

        ;****************************  Create the Config Tools dialog ********************************
        guiConfigTools := Gui("-MaximizeBox -MinimizeBox", "Confg Tools")

        guiConfigTools.OnEvent("Close", (*) => Setup.ConfigToolsCloseButton_Click())

        gcConfigToolsBackupLabel := guiConfigTools.AddText("x0" " y" 5 " w" 250 " h" 30 " Center")

        gcConfigToolsBackupButton := guiConfigTools.AddButton("x" 40 " y" 42 " w" 80 " h" 25, "Backup")
        gcConfigToolsBackupButton.OnEvent("Click", (*) => Setup.gcConfigToolsBackupButton_Click())
        gcConfigToolsBackupButton.TT := "Press to backup all ATC *.cfg`ngame controller configuration files."

        gcConfigToolsRestoreButton := guiConfigTools.AddButton("x" 130 " y" 42 " w" 80 " h" 25, "Restore")
        gcConfigToolsRestoreButton.OnEvent("Click", (*) => Setup.gcConfigToolsRestoreButton_Click())
        gcConfigToolsRestoreButton.TT := "Press to restore all backed-up ATC *.cfg`ngame controller configuration files."

        gcConfigToolsDeleteButton := guiConfigTools.AddButton("x" 40 " y" 73 " w" 80 " h" 25, "Delete")
        gcConfigToolsDeleteButton.OnEvent("Click", (*) => Setup.gcConfigToolsDeleteButton_Click())
        gcConfigToolsDeleteButton.TT := "Press to delete all ATC *.cfg game controller`nconfiguration files, restoring the defaults."

        gcConfigToolsPatchButton := guiConfigTools.AddButton("x" 130 " y" 73 " w" 80 " h" 25, "Patch")
        gcConfigToolsPatchButton.OnEvent("Click", (*) => Setup.gcConfigToolsPatchButton_Click())
        gcConfigToolsPatchButton.TT := "Press to patch ATC *.cfg`ncontroller configuration files.`nSee documentation for more details."

        gcConfigToolsCloseButton := guiConfigTools.AddButton("x" 85 " y" 150 - 35 " w" 80 " h" 25, "Close")
        gcConfigToolsCloseButton.OnEvent("Click", (*) => Setup.ConfigToolsCloseButton_Click())
    }

    static PopulateFields()
    {
        global g_oArcadeRomList

        if (!gcArcadeDropDown.Text)
            try gcArcadeDropDown.Text := IniRead(g_sIniFile, "General", "Arcade", "Arcade Time Capsule 3.6")

        try gcApplicationEdit.Text := IniRead(g_sIniFile, gcArcadeDropDown.Text, "Application")
        try gcROMMonitorFolderEdit.Text := IniRead(g_sIniFile, gcArcadeDropDown.Text, "ROMFolder")            

        if (!gcApplicationEdit.Text && InStr(gcArcadeDropDown.Text, "Arcade Time Capsule"))
            gcApplicationEdit.Text := "RetroVRArcade.exe"      

        ;Set globals
        global g_sArcadeString := gcArcadeDropDown.Text
        global g_sApplicationName := gcApplicationEdit.Text
        global g_sROMMonitorFolder := gcROMMonitorFolderEdit.Text 
        global g_sDirectoryFile := g_sArcadeFolder "\" g_sArcadeString ".Directory.ini"
        global g_sFloorsFile := g_sArcadeFolder "\" g_sArcadeString ".Floors.json"

        global g_sATCFolder := g_sROMMonitorFolder "\..\..\.."
        global g_sATCHighScoreRootFolder := g_sATCFolder "\RetroVRArcade\Plugins\save"
        global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
       
        ;During startup, we reach this before the Settings dialog
        ;is created, so make sure we don't call these methods prematurely.
        if (IsSet(guiSettings))
        {
            Settings.ReadFloors()
        }

        local sRomListFile := g_sArcadeFolder "\" g_sArcadeString ".RomList.json"

        ;Initialize the global g_oArcadeRomList
        if (g_sArcadeString != "Other") ;skip if "Other"
        {
            if (FileExist(sRomListFile))
            {
                sJSON := FileRead(sRomListFile)
                g_oArcadeRomList := JSON.parse(sJSON)
            }
            else {
                g_oLog.LogLine("ERROR: Could not find rom list file: " sRomListFile "`n")
            }

            iCount := g_oArcadeRomList.Count
            if (iCount == 0)
                g_oLog.LogLine("ERROR: Arcade rom list is empty!`n")
        }

        gcCopyRomsButton.Enabled := gcAuditButton.Enabled := g_sArcadeString != "Other" && DirExist(gcROMMonitorFolderEdit.Text) ? true : false
        gcConfigToolsButton.Enabled := g_sArcadeString != "Other" && DirExist(g_sATCFolder "\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text "\..\..\..\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

        Setup.UpdateApplyButton()
    }

    static ConfigToolsButton_Click()
    {
        try guiSetup.Opt("+Disabled")

        guiConfigTools.Show("W" 250 " H" 150 " X" A_ScreenWidth / 2 - 250 / 2 " Y" A_ScreenHeight / 2 - 100 / 2 - 75)
        guiConfigTools.Opt("+Owner" guiSetup.Hwnd)

        gcConfigToolsBackupButton.Enabled := true

        ;only enable the restore button if there is something to restore
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup"))
        {
            sDate := FileRead(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup")
            gcConfigToolsBackupLabel.Text := "Last ATC cfg file backup performed on:`n" sDate
            gcConfigToolsRestoreButton.Enabled := true
            return
        }
        else
        {
            gcConfigToolsBackupLabel.Text := "Press Backup button now to`nbackup ATC cfg files."
        }
  
        gcConfigToolsRestoreButton.Enabled := false
    }

    static gcConfigToolsBackupButton_Click()
    {
        if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcConfigToolsBackupButton.TT
		gcConfigToolsBackupButton.TT := ""
		ToolTip()

        result := "Yes"
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup"))
            result := MsgBox("Performing this *.cfg file backup will overwrite any previous backups.`n`nAre you sure you would like to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform *.cfg file backup?", 36)
        else
            result := MsgBox("Performing this operation will create a backup of all ATC *.cfg controller configuration files.`n`nAre you ready to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform *.cfg file backup?", 36)

        if (result == "No")
        {
            gcConfigToolsBackupButton.TT := tempTT
            return
        }

        for i, sVer in Setup.GetMAMEVersions()
        {
            if (!DirExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\mame" sVer))
                CreateDirAndLog(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\mame" sVer)
        }

        bFilesBackedUp := false
        iFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {
            Loop files g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\cfg\*.cfg" 
            {
                bFilesBackedUp := true
                FileCopy(A_LoopFileFullPath, g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\mame" sVer, 1)
                iFilesCopied++
            }
        }

        if (iFilesCopied > 0)
        {
            MsgBox "Successfully backed-up " iFilesCopied " configuration files.", "Backup Completed", 64
            gcConfigToolsRestoreButton.Enabled := gcConfigToolsRestoreButton.Enabled ? true : bFilesBackedUp
            try FileDelete(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup")
            sTimestamp := FormatTime(A_Now, "ShortDate") " at " FormatTime(A_Now, "Time")
            FileAppend(sTimestamp, g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup")
            gcConfigToolsBackupLabel.Text := "Last ATC cfg file backup performed on:`n" sTimestamp
        }
        else
            MsgBox "No configuration files were found to back-up.", "Backup Unsuccessful", 16

        gcConfigToolsBackupButton.TT := tempTT
        return
    }

    static gcConfigToolsRestoreButton_Click()
    {
        if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcConfigToolsRestoreButton.TT
		gcConfigToolsRestoreButton.TT := ""
		ToolTip()

        result := "Yes"
        result := MsgBox("Performing this *.cfg file restore will overwrite existing files in ATC with the ones you had previously backed-up.`n`nAre you sure you would like to proceed?`nPress 'Yes' to restore now, or press 'No' to abort.", "Perform *.cfg file restore?", 36)

        if (result == "No")
        {
            gcConfigToolsRestoreButton.TT := tempTT
            return
        }

        iFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {        
            Loop files g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\mame" sVer "\*.cfg"
            {
                FileCopy(A_LoopFileFullPath, g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\cfg", 1)
                iFilesCopied++
            }
        }

        if (iFilesCopied > 0)
            MsgBox "Successfully restored " iFilesCopied " configuration files.", "Restore Completed", 64
        else
            MsgBox "There were no configuration files found to restore.", "Restore Unsuccessful", 16

        gcConfigToolsBackupButton.Enabled := true

        gcConfigToolsRestoreButton.TT := tempTT
        return
    }

    static gcConfigToolsDeleteButton_Click()
    {
        if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcConfigToolsDeleteButton.TT
		gcConfigToolsDeleteButton.TT := ""
		ToolTip()

        result := "Yes"
        result := MsgBox("Performing this *.cfg delete operation will delete all *.cfg files in ATC, effectively returning them to their defaults. Any backups you have made will not be affected and may still be restored later.`n`nAre you sure you would like to proceed?`nPress 'Yes' to reset now, or press 'No' to abort.", "Perform *.cfg file delete?", 36)

        if (result == "No")
        {
            gcConfigToolsDeleteButton.TT := tempTT
            return
        }

        iFilesDeleted := 0
        for i, sVer in Setup.GetMAMEVersions()
        {
            Loop files g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\cfg\*.cfg" 
            {
                FileDelete(A_LoopFileFullPath)
                iFilesDeleted++
            }
        }

        if (iFilesDeleted > 0)
            MsgBox "Successfully deleted " iFilesDeleted " configuration files.", "Delete Completed", 64
        else
            MsgBox "There were no configuration files found to delete.", "Delete Unsuccessful", 16

        gcConfigToolsBackupButton.Enabled := false
        gcConfigToolsDeleteButton.TT := tempTT
    }

    static gcConfigToolsPatchButton_Click()
    {
        ;Must force dismisal of ToolTip over browse window
		tempTT := gcConfigToolsPatchButton.TT
		gcConfigToolsPatchButton.TT := ""
		ToolTip()

        result := "Yes"
        result := MsgBox("This operation will copy configuration files into ATC that will make it easier to map a rotary joystick to games that use rotary joysticks. It is recommended that you perform a backup before applying this patch.`n`nAre you sure you would like to proceed?`nPress 'Yes' to reset now, or press 'No' to abort.", "Perform *.cfg file patch?", 36)

        if (result == "No")
        {
            gcConfigToolsPatchButton.TT := tempTT
            return
        }

        iFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {        
            Loop files g_sArcadeFolder "\" g_sArcadeString "\Patch\mame" sVer "\*.cfg"
            {
                FileCopy(A_LoopFileFullPath, g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\cfg", 1)
                iFilesCopied++
            }
        }

        if (iFilesCopied > 0)
        {
            MsgBox "Successfully patched " iFilesCopied " configuration files.", "Patch Completed", 64
            gcConfigToolsBackupButton.Enabled := true
        }
        else
            MsgBox "There were no patch files found to install.", "Patch Unsuccessful", 16

        gcConfigToolsPatchButton.TT := tempTT
        return
    }

    static ConfigToolsCloseButton_Click()
    {
        try guiSetup.Opt("-Disabled")
        guiConfigTools.Hide()
    }

    static CopyRomsBrowseButton_Click()
    {
        sSourceFolder := ""

        try sSourceFolder := IniRead(g_sIniFile, "General", gcRomVersionDropDown.Text "RomVersionFolder")

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcCopyRomsBrowseButton.TT
		gcCopyRomsBrowseButton.TT := ""
		ToolTip()

		sFolder := FileSelect("D", sSourceFolder)

        gcCopyRomsBrowseButton.TT := tempTT

        if (!sFolder) ;User cancelled
            return
		
        result := "Yes"
        result := MsgBox("Begin copy of " gcRomVersionDropDown.Text " roms from folder:`n   " sFolder "`n`nTo folder:`n   " gcROMMonitorFolderEdit.Text "`n`nDuplicate files will be overwritten. Are you sure you would like to proceed?", "Begin Copy", 36)

        if (result == "Yes")
        {
            try guiSetup.Opt("-Disabled")
            guiCopyRoms.Hide()

            gcAuditProgress.Visible := true

            ;As a future convenience, remember the folder that had been selected for this version of the roms
            try IniWrite(sFolder, g_sIniFile, "General", gcRomVersionDropDown.Text "RomVersionFolder")

            ;Copy each file in the rom list having the specified version
            iFilesCopied := 0
            for sRom, mInfo in g_oArcadeRomList
            {
                gcAuditProgress.Value := A_Index / g_oArcadeRomList.Count * 100 ;increment progress bar

                ;copy the rom
                if (mInfo["MAMEVersion"] == gcRomVersionDropDown.Text)
                    try FileCopy(sFolder "\" sRom ".zip", gcROMMonitorFolderEdit.Text, 1)

                ;copy folder (accompanying chd folder, for example)
                if (mInfo["HasFolder"] == "1" && mInfo["MAMEVersion"] == gcRomVersionDropDown.Text)
                    try DirCopy(sFolder "\" sRom, gcROMMonitorFolderEdit.Text "\" sRom, 1)

                iFilesCopied++
            }

            ;Reset all the rom access timestamps since they were just touched.
            FileSetTime DateAdd(A_Now, -7, "days"), g_sROMMonitorFolder "\*.zip", "A"

            gcAuditProgress.Visible := false
            gcAuditProgress.Value := 0

            if (iFilesCopied > 0)
                MsgBox "Successfully copied " iFilesCopied " rom files.", "Copy Completed", 64
            else
                MsgBox "There were rom files found to copy.", "Copy Unsuccessful", 16
        }

        return
    }

    static CopyRomsButton_Click()
    {
        try guiSetup.Opt("+Disabled")

        guiCopyRoms.Show("W" 250 " H" 100 " X" A_ScreenWidth / 2 - 250 / 2 " Y" A_ScreenHeight / 2 - 100 / 2 - 75)
        guiCopyRoms.Opt("+Owner" guiSetup.Hwnd)

        ;Delete contents of the list since user may have changed arcades
        gcRomVersionDropDown.Delete()

        sROMFolder := gcROMMonitorFolderEdit.Text

        gcRomVersionDropDown.Add(Setup.GetMAMEVersions())
        gcRomVersionDropDown.Value := 1
    }

    /**
     * Gets an array containing a list of all mame versions required
     * by the currently selected ATC arcade.
     * @returns {String | Array} 
     */
    static GetMAMEVersions()
    {
        static aVersions := ""

        if (aVersions)
            return aVersions
        
        ;Pull all unique MAME versions used by the rom list and
        ;populate the version list with these.
        oVersions := Map()
        for sRom, mInfo in g_oArcadeRomList {
            oVersions[mInfo["MAMEVersion"]] := 1 ;1 is just a dummy value; we're storing the versions in the index.
        }

        aVersions := Array()
        for ver, j in oVersions {
            aVersions.Push(ver)
        }

        return aVersions
    }

    static CopyRomsCloseButton_Click(*)
    {
        try guiSetup.Opt("-Disabled")
        guiCopyRoms.Hide()
    }
    
    static RomVersionDropDown_Change() 
    {
    }

    /**
     * Perform an audit for missing files as well as calling MAME's rom verification function
     */
    static AuditButton_Click() 
    {
        iErrorCount := 0
        gcAuditButton.Enabled := false
        gcSetup_CloseButton.Enabled := false
        gcAuditProgress.Visible := true
        Setup.oAuditLog.Init(g_sAuditFolder "\audit.txt", "arcadeVFE ROM File Audit")

        sROMFolder := gcROMMonitorFolderEdit.Text
        Setup.oAuditLog.LogLine("INFO: Start auditing ROM files in folder: " sROMFolder "\*.zip`n")
        Setup.oAuditLog.LogLine("INFO: Using curated arcade ROM list: `"" g_sArcadeString "`"`n")
        Setup.oAuditLog.LogLine("`n")

        OG_DetectHiddenWindows := A_DetectHiddenWindows
        DetectHiddenWindows True

        try 
        {
            ;This helps to keep the command window from popping up
            Run A_ComSpec,, "Hide", &com_pid
            WinWait "ahk_pid " com_pid
            DllCall("AttachConsole", "UInt", com_pid)

            WshShell := ComObject("WScript.Shell")
        }
        catch as e
        {		
            Setup.oAuditLog.LogLine("ERROR: Attaching console for GetHi2TxtScores(): " Setup.oAuditLog.FormatErrorMessage(e) "`n")
            ExitApp(-1)
        }

        ;Loop through each file in the rom list for this arcade, doing a version-specific validation of each.
        for sRom, mInfo in g_oArcadeRomList
        {
            gcAuditProgress.Value := A_Index / g_oArcadeRomList.Count * 100

            ;Missing file check
            if (!FileExist(sROMFolder "\" sRom ".zip"))
            {
                Setup.oAuditLog.LogLine("AUDIT " mInfo["MAMEVersion"] " ROM: " PadString(sRom, 8) "  : Rom File missing.`n")
                iErrorCount++
                continue
            }

            try 
            {
                ;Use specific versions of MAME to do the -verifyroms checks
                if (mInfo["MAMEVersion"] == "2010")
                    exec := WshShell.Exec(g_sMame2010  ' -rompath "' sROMFolder '" -verifyroms ' sRom)
                else if (mInfo["MAMEVersion"] == "2014")
                    exec := WshShell.Exec(g_sMame2014  ' -rompath "' sROMFolder '" -verifyroms ' sRom)

                stdout := Trim(StrReplace(exec.StdOut.ReadAll(), "`r`n", "; "), " " ";")
                stderr := exec.StdErr.ReadAll()
                if (stderr)
                {
                    stderr := StrReplace(stderr, "`r`n", "") ;don't need the extra linefeed data
                }

                ;Some roms work despite having a bad checksum. If the rom list contains one of these
                ;"bad" checksums, we will let it pass. 
                sChecksum := "$!$" ;a string not likely to be found
                if (mInfo.Has("Checksum"))
                    sChecksum := mInfo["Checksum"]

                ;Consider certain results as having passed the audit including:
                ; - results containing the text "good"
                ; - results containing a checksum matching the one in the rom list
                ; - results containing the text "<rom name> is best available"
                if (stdout && !InStr(stdout, "good") && !InStr(stdout, sChecksum) && !InStr(stdout, sRom " is best available"))
                {
                    ;if a blank was returned, presumably, this rom can't be audited by this version of mame.
                    if (!stdout)
                        stdout := " " PadString(sRom, 8) "  : Rom file is not supported in this version of MAME."

                    iErrorCount++
                    Setup.oAuditLog.LogLine("AUDIT " mInfo["MAMEVersion"] " ROM: " stdout "`n")
                }

                if (stderr)
                    Setup.oAuditLog.LogLine("AUDIT " mInfo["MAMEVersion"] " ROM: " stderr " (stderr)`n")
            }
            catch as e {
                Setup.oAuditLog.LogLine("ERROR: Calling -verifyroms, Rom: " sRom ", Message: " Setup.oAuditLog.FormatErrorMessage(e) "`n")
            }
        }

        DllCall("FreeConsole")
        ProcessClose com_pid 

        sAnomalyPhrase := "anomalies were found."
        if (iErrorCount == 1)
            sAnomalyPhrase := "anomaly was found."        

        Setup.oAuditLog.LogLine("`n")
        Setup.oAuditLog.LogLine("INFO: Completed audit of " g_oArcadeRomList.Count " rom files. " iErrorCount " " sAnomalyPhrase "`n")
        Setup.oAuditLog.LogLine("INFO: Please note that ROMs reporting anomalies may still work, but should be tested.`n")

        ;Reset all the rom access timestamps since mame just touched them all.
        FileSetTime DateAdd(A_Now, -7, "days"), g_sROMMonitorFolder "\*.zip", "A"

        gcAuditProgress.Visible := false
        gcAuditProgress.Value := 0

        Setup.oAuditLog.ShowLog()    

        gcAuditButton.Enabled := true
        gcSetup_CloseButton.Enabled := true

        DetectHiddenWindows OG_DetectHiddenWindows
    }

    static InitialsComboBox_Change(*)
    {
		;Update button states as needed
		if (gcInitialsComboBox.Text == "")
		{
			gcAddInitialsButton.Enabled := false
			gcRemoveInitialsButton.Enabled := false
			return
		}

		;Disable Add button and enable remove button if initials already exist
		aInitials := Array()
        try {
            aInitials := ControlGetItems(gcInitialsComboBox)
            for i, sInitial in aInitials
            {
                if (sInitial == gcInitialsComboBox.Text)
                {
                    gcAddInitialsButton.Enabled := false
                    gcRemoveInitialsButton.Enabled := true
                    return
                }
            }
        }

		;initials weren't found
		gcAddInitialsButton.Enabled := true
		gcRemoveInitialsButton.Enabled := false
    }

    static AddInitialsButton_Click(*)
    {
		if (gcInitialsComboBox.Text == "")
			return

		gcInitialsComboBox.Add([gcInitialsComboBox.Text])
		new_item := Setup.SaveInitials()

		gcRemoveInitialsButton.Enabled := true
        gcAddInitialsButton.Enabled := false
    }

    static RemoveInitialsButton_Click(*)
    {
		last := gcInitialsComboBox.Value
		try gcInitialsComboBox.Delete(gcInitialsComboBox.Value)

		try {
			gcInitialsComboBox.Value.Choose(last)
		}
		catch
		{
			try gcInitialsComboBox.Value.Choose(last-1)
		}

		Setup.SaveInitials()

        try gcInitialsComboBox.Value := 1

		if (gcInitialsComboBox.Text == "")
		{
			gcAddInitialsButton.Enabled := false
			gcRemoveInitialsButton.Enabled := false
		}
    }

    static SaveInitials()
    {
    	aInitials := Array()
		aInitials := ControlGetItems(gcInitialsComboBox)
		
		sJSON := JSON.stringify(aInitials)

		fInitialsFile := FileOpen(g_sInitialsFile, "w")

		fInitialsFile.Write(sJSON)
		fInitialsFile.Close()

		;Now rebuild the g_oInitials object
		sJSON := FileRead(g_sInitialsFile)
		global g_oInitials := JSON.parse(sJSON)

		return aInitials.Length
    }

    /**
	 * Read the machine vicinities from the arcade-specific JSON file
	 */
	static ReadInitials()
	{
		if (FileExist(g_sInitialsFile))
		{
			sJSON := FileRead(g_sInitialsFile)
			global g_oInitials := JSON.parse(sJSON)

			gcInitialsComboBox.Add(g_oInitials)
            
            try {
                gcInitialsComboBox.Value := 1
                gcRemoveInitialsButton.Enabled := true
            }
		}
	}

    static ShowSetupDialog()
    {
        try guiSettings.Opt("+Disabled")
        guiSetup.Opt("-Resize -MaximizeBox -MinimizeBox")
        guiSetup.Show("x" Setup.mSetup.X " y" Setup.mSetup.Y " w" Setup.mSetup.Width " h" Setup.mSetup.Height)

        g_oLog.LogLine("INFO: Showing Setup Dialog.`n")

        Setup.PopulateFields()
    }

    static Setup_CloseButton_Click(*)
    {
        ;get saved values
        sArcade := sApplication := sROMFolder := ""
        try sArcade := IniRead(g_sIniFile, "General", "Arcade")
        try sApplication := IniRead(g_sIniFile, sArcade, "Application")
        try sROMFolder := IniRead(g_sIniFile, sArcade, "ROMFolder")

        ;handle case where settings haven't been applied
        if(sArcade != gcArcadeDropDown.Text || sApplication != gcApplicationEdit.Text || sROMFolder != gcROMMonitorFolderEdit.Text)
        {
            result := "Yes"
            result := MsgBox("You have not applied these settings. Are you sure you want to exit?`n`nPress 'Yes' to exit without applying or 'No' to return to this screen.", "Close Initial Setup?", 36)
            if (result == "No")
                return
        }

        ;restore the settings
        try gcArcadeDropDown.Text := sArcade
        try gcApplicationEdit.Text := sApplication
        try gcROMMonitorFolderEdit.Text := sROMFolder

        ;Go directly to Settings dialog if settings saved/good and Setup dialog had been automatically shown
        if (Setup.bAutoshow && sArcade && sApplication && DirExist(sROMFolder))
        {
            guiSetup.Hide()
            global g_bCancelPoll := true
            Settings.RefreshList()
            g_oLog.LogLine("INFO: Showing Settings dialog.`n")
            guiSettings.Show("X" Settings.mMetrics.X " Y" Settings.mMetrics.Y " W" Settings.mMetrics.Width " H" Settings.mMetrics.Height)
            Setup.bAutoshow := false
            return
        }
        else if (Setup.bAutoshow)
            ExitApp(0)

        guiSettings.Opt("-Disabled")
        guiSetup.Hide()

        g_oLog.LogLine("INFO: Closed Setup dialog.`n")
    }

    static Setup_ApplyButton_Click(*)
    {
        if (gcArcadeDropDown.Text && gcApplicationEdit.Text && DirExist(gcROMMonitorFolderEdit.Text))
        {
            IniWrite(gcArcadeDropDown.Text, g_sIniFile, "General", "Arcade")

            ;if the rom folder was changed, reset the access dates
            sOGROMFolder := ""
            try sOGROMFolder := IniRead(g_sIniFile, "General", "ROMFolder")
            if (gcROMMonitorFolderEdit.Text != sOGROMFolder)
            {
                global g_sROMMonitorFolder := gcROMMonitorFolderEdit.Text 
                global g_sATCFolder := g_sROMMonitorFolder "\..\..\.."
                StartRomWatcher()
            }

            ;Also index these settings in their own section
            IniWrite(gcArcadeDropDown.Text, g_sIniFile, gcArcadeDropDown.Text, "Arcade")
            IniWrite(gcApplicationEdit.Text, g_sIniFile, gcArcadeDropDown.Text, "Application")
            IniWrite(gcROMMonitorFolderEdit.Text, g_sIniFile, gcArcadeDropDown.Text, "ROMFolder")

            ;Set globals
            global g_sArcadeString := gcArcadeDropDown.Text
            global g_sApplicationName := gcApplicationEdit.Text
            global g_sROMMonitorFolder := gcROMMonitorFolderEdit.Text 
            global g_sDirectoryFile := g_sArcadeFolder "\" g_sArcadeString ".Directory.ini"
            global g_sFloorsFile := g_sArcadeFolder "\" g_sArcadeString ".Floors.json"

            global g_sATCFolder := g_sROMMonitorFolder "\..\..\.."
            global g_sATCHighScoreRootFolder := g_sATCFolder "\RetroVRArcade\Plugins\save"
            global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
     
            Settings.FillRomList()
            Settings.SetRomInfo()
            gcApplyButton.Enabled := false

            if (!Setup.bAutoShow)
                guiSettings.Title := sSettingsTitle " - " g_sArcadeString " - " gcActionListNameEdit.Text

            ;Machine location editor is not supported for "Other" arcade
            ;Use try since this may be called before Settings is created
            try gcEditDirectoryCheckbox.Enabled := g_sArcadeString == "Other" ? false : true
            gcConfigToolsButton.Enabled := g_sArcadeString != "Other" && DirExist(g_sATCFolder "\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text "\..\..\..\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

            ;Save initials if a new one is ready to be saved
            if (gcAddInitialsButton.Enabled)
                Setup.AddInitialsButton_Click()

            g_oLog.LogLine("INFO: Setup Apply Button pressed.`n")
        }
    }

    static ROMMonitorFolderEdit_Change(*)
    {
        gcCopyRomsButton.Enabled := gcAuditButton.Enabled := g_sArcadeString != "Other" && DirExist(gcROMMonitorFolderEdit.Text) ? true : false
        gcConfigToolsButton.Enabled := g_sArcadeString != "Other" && DirExist(g_sATCFolder "\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text "\..\..\..\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

        Setup.UpdateApplyButton()
    }

    static ROMMonitorFolderBrowseButton_Click(*)
    {
		global gcROMMonitorFolderEdit, gcAssignButton

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcROMMonitorFolderBrowseButton.TT
		gcROMMonitorFolderBrowseButton.TT := ""
		ToolTip()

		sFolder := FileSelect("D", gcROMMonitorFolderEdit.Value)
        
        gcROMMonitorFolderBrowseButton.TT := tempTT

        if (!sFolder) ;User cancelled
            return	
        
        gcROMMonitorFolderEdit.Value := sFolder

        gcCopyRomsButton.Enabled := gcAuditButton.Enabled := g_sArcadeString != "Other" && DirExist(gcROMMonitorFolderEdit.Text) ? true : false
        gcConfigToolsButton.Enabled := g_sArcadeString != "Other" && DirExist(g_sATCFolder "\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text "\..\..\..\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

        Setup.UpdateApplyButton()
    }

    static ArcadeDropDown_Change(*)
    {
        Setup.PopulateFields()
    }

    Static ApplicationEdit_Change(*)
    {
        Setup.UpdateApplyButton()
    }

    static ApplicationBrowseButton_Click()
    {
        ;Must force dismisal of ToolTip over browse window
		tempTT := gcApplicationBrowseButton.TT
		gcApplicationBrowseButton.TT := ""
		ToolTip()
        
		sApplicationPath := FileSelect("S",,, "Executables (*.exe)")

        gcApplicationBrowseButton.TT := tempTT

        if (!sApplicationPath) ;User cancelled
            return	

        if (sApplicationPath)
        {
            SplitPath(sApplicationPath,,,&OutExt, &OutNameNoExt)
            gcApplicationEdit.Text := OutNameNoExt "." OutExt
        }

        Setup.UpdateApplyButton()
    }

    static UpdateApplyButton()
    {
        if (gcArcadeDropDown.Text && gcApplicationEdit.Text && DirExist(gcROMMonitorFolderEdit.Text))
            gcApplyButton.Enabled := true
        else 
            gcApplyButton.Enabled := false            
    }
}