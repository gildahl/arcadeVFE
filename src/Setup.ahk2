#Requires AutoHotkey v2.0

#include Utility.ahk2

class Setup
{
    static mSetup := Map()
    static bAutoshow := false
    static oAuditLog := AppLog()

    /**
     * Create the initial setup dialog
     */
    static CreateSetupDialog()
    {
        global

        local nIconButtonWidth := 40
        local nButtonWidth := 70
        local sSetupTitle := "arcadeVFE " g_sCodeVersionMinor " - Initial Setup"

        Setup.mSetup.Width := 550
		Setup.mSetup.Height := 220
		Setup.mSetup.X := A_ScreenWidth / 2 - Setup.mSetup.Width / 2
		Setup.mSetup.Y := A_ScreenHeight / 2 - Setup.mSetup.Height / 2 - 75

        guiSetup := Gui("-MaximizeBox -MinimizeBox", sSetupTitle)

        guiSetup.OnEvent("Close", (*) => Setup.Setup_CloseButton_Click())

        gcArcadeLabel := guiSetup.AddText("x" 25 " y" 10 " w" 250, "Choose your arcade software.")
        gcArcadeDropDown := guiSetup.AddDropDownList("x" 25 " y" 25 " w" 320 " +BackgroundWhite",)
        gcArcadeDropDown.OnEvent("Change", (*) => Setup.ArcadeDropDown_Change())
        gcArcadeDropDown.TT := "Select the arcade software you will be using. Choose `"Other`" if`nnot using ATC or a version of ATC not listed. Some features`nare disabled when selecting `"Other`"."
        
        ;Add supported arcades to the list
        ;Arcades are supported via arcade-specific files in the \Arcade subfolder (minimally *.RomList.json)
        loop files g_sArcadeFolder "\*.RomList.json"
        {
            local sArcade := SubStr(A_LoopFileName, 1, InStr(A_LoopFileName, ".") + 1)
            gcArcadeDropDown.Add([sArcade])
        }        
        
        gcArcadeDropDown.Add(["Other"])

        gcArcadeExeEditLabel := guiSetup.AddText("x" 25 " y" 55 " w" 350, "Arcade Executable Name")
        gcArcadeExeEdit := guiSetup.AddEdit("x" 25 " y" 70 " w" 155 " +BackgroundWhite",)
		gcArcadeExeEdit.OnEvent("Change", (*) => Setup.ArcadeExeEdit_Change())
		gcArcadeExeEdit.TT := "Enter the name of the executable for this arcade. Do not`ninclude the path. For example, `"RetroVRArcade.exe`"."

        gcInitialsComboBoxLabel := guiSetup.AddText("x" 370 " y" 9 " w" 75, "Player Initials")
        gcInitialsComboBox := guiSetup.AddComboBox("x" 370 " y" 24 " w" 75 " +BackgroundWhite",)
		gcInitialsComboBox.OnEvent("Change", (*) => Setup.InitialsComboBox_Change())
		gcInitialsComboBox.TT := "These initals are used to highlight your initials in the GameInfo`nleaderboards.`n`nEnter your arcade initials as you enter them into games. If you use`nmore than one set of initials (perhaps a longer version for games`nthat accept that), you should enter those as well."

        gcAddInitialsButton := guiSetup.AddButton("x" 448 " y" 22 " w" nIconButtonWidth)
		gcAddInitialsButton.OnEvent("Click", (*) => Setup.AddInitialsButton_Click())
		gcAddInitialsButton.TT := "Add these initials to the list."
		gcAddInitialsButton.Enabled := false
		GuiButtonIcon(gcAddInitialsButton, 'icons.dll', 127, 's16') ;add (+) icon

        gcRemoveInitialsButton := guiSetup.AddButton("x" 490 " y" 22 " w" nIconButtonWidth)
		gcRemoveInitialsButton.OnEvent("Click", (*) => Setup.RemoveInitialsButton_Click())
		gcRemoveInitialsButton.TT := "Delete the selected initals from the list."
        gcRemoveInitialsButton.Enabled := false
		GuiButtonIcon(gcRemoveInitialsButton, 'icons.dll', 130, 's16') ;remove (-) icon

        Setup.ReadInitials()

		gcArcadeExeBrowseButton := guiSetup.AddButton("x" 183 " y" 69 " w" nIconButtonWidth)
		gcArcadeExeBrowseButton.OnEvent("Click", (*) => Setup.ArcadeExeBrowseButton_Click())
        gcArcadeExeBrowseButton.TT := "Browse for the arcade system executable file."
        GuiButtonIcon(gcArcadeExeBrowseButton, 'imageres.dll', 206, 's16')

        gcROMMonitorFolderLabel := guiSetup.AddText("x" 25 " y" 100 " w" 350, "ROM folder to monitor")
        gcROMMonitorFolderEdit := guiSetup.AddEdit("x" 25 " y" 115 " w" 462 " +BackgroundWhite",)
        gcROMMonitorFolderEdit.OnEvent("Change", (*) => Setup.ROMMonitorFolderEdit_Change())
        gcROMMonitorFolderEdit.TT := "Enter the full path to the folder containing this arcade's MAME roms.`nThe files in this folder must have an extension of *.zip."

        gcROMMonitorFolderBrowseButton := guiSetup.AddButton("x" 490 " y" 114 " w" nIconButtonWidth)
		gcROMMonitorFolderBrowseButton.OnEvent("Click", (*) => Setup.ROMMonitorFolderBrowseButton_Click())
		gcROMMonitorFolderBrowseButton.TT := "Browse for the folder containing this arcade's MAME roms.`nThe files in this folder must have an extension of *.zip."
        GuiButtonIcon(gcROMMonitorFolderBrowseButton, 'imageres.dll', 206, 's16')

        gcSetupCopyRomsButton := guiSetup.AddButton("x" 25 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Copy Roms...")
        gcSetupCopyRomsButton.OnEvent("Click", (*) => Setup.CopyRomsButton_Click(guiSetup.Hwnd))
        gcSetupCopyRomsButton.TT := "Copy roms from a source`nfolder to this rom folder."

        gcSetupAuditProgress := guiSetup.AddProgress("x" 25 " y" Setup.mSetup.Height - 70 " w" Setup.mSetup.Width - 50 " h" 20 " cBlue BackgroundSilver vAuditProgress") 
        gcSetupAuditProgress.Visible := false

        gcSetupAuditButton := guiSetup.AddButton("x" 108 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Audit Roms...")
        gcSetupAuditButton.OnEvent("Click", (*) => Setup.AuditButton_Click(gcSetupAuditProgress))
        gcSetupAuditButton.TT := "Press to perform an audit for missing and bad roms.`nA report will display when complete.`n`nIf you need a list of all Arcade Time Capsule roms and`ntheir MAME versions, run this audit on an empty folder."

        gcFileToolsButton := guiSetup.AddButton("x" 191 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "File Tools...")
        gcFileToolsButton.OnEvent("Click", (*) => Setup.FileToolsButton_Click())
        gcFileToolsButton.TT := "Perform backup, restore, patch,`nand reset file functions."

        gcApplyButton := guiSetup.AddButton("x" 367 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Apply")
        gcApplyButton.OnEvent("Click", (*) => Setup.Setup_ApplyButton_Click())
        gcApplyButton.TT := "Press to save these settings."

        gcSetup_CloseButton := guiSetup.AddButton("x" 450 " y" Setup.mSetup.Height - 40 " w" 80 " h" 25, "Close")
        gcSetup_CloseButton.OnEvent("Click", (*) => Setup.Setup_CloseButton_Click())
 
        Setup.PopulateFields()

        ;Force display of the Setup dialog if any or all of its fields are empty after attempting to populate its
        ;fields from the vfe.ini file. This would be expected on an initial run.
        if (!gcArcadeDropDown.Text || !gcArcadeExeEdit.Text || !DirExist(gcROMMonitorFolderEdit.Text))
        {
            Setup.ShowSetupDialog()
            Setup.bAutoshow := true
        }

        ;****************************  Create the Copy Roms dialog ********************************
        guiCopyRoms := Gui("-MaximizeBox -MinimizeBox", "Copy Roms into ROM folder")

        guiCopyRoms.OnEvent("Close", (*) => Setup.CopyRomsCloseButton_Click())

        gcRomVersionLabel := guiCopyRoms.AddText("x" 30 " y" 10 " w" 250, "Rom version")
        gcRomVersionDropDown := guiCopyRoms.AddDropDownList("x" 30 " y" 25 " w" 100 " +BackgroundWhite",)
        gcRomVersionDropDown.OnEvent("Change", (*) => Setup.RomVersionDropDown_Change())
        gcRomVersionDropDown.TT := "Select the version of the roms you would like to copy,`nthen use the Browse button to select the folder that`nyou would like to copy them from."

        gcCopyRomsBrowseButton := guiCopyRoms.AddButton("x" 140 " y" 22 " w" 80 " h" 22, "Browse...")
        gcCopyRomsBrowseButton.OnEvent("Click", (*) => Setup.CopyRomsBrowseButton_Click())
        gcCopyRomsBrowseButton.TT := "Browse for the source folder from which you would like to copy`nthe roms of the selected version. These roms will be copied into`nthe arcade's rom folder, overwriting any existing files."

        gcCopyRomsCloseButton := guiCopyRoms.AddButton("x" 85 " y" 100 - 35 " w" 80 " h" 25, "Close")
        gcCopyRomsCloseButton.OnEvent("Click", (*) => Setup.CopyRomsCloseButton_Click())

        ;****************************  Create the Config Tools dialog ********************************
        Setup.FileTools := Map()
        Setup.FileTools.W := 730
		Setup.FileTools.H := 265
        
        guiFileTools := Gui("-MaximizeBox -MinimizeBox", "File Tools")

        guiFileTools.OnEvent("Close", (*) => Setup.FileToolsDialogCloseButton_Click())

        gcFileToolsProgress := guiFileTools.AddProgress("x" Setup.FileTools.W/2 - (Setup.FileTools.W - 50)/2 " y" Setup.FileTools.H - 70 " w" Setup.FileTools.W - 50 " h" 20 " cBlue BackgroundSilver vAuditProgress") 
        gcFileToolsProgress.Visible := false

        ;Backup ROM files and folders
        iGB_W := 220, iGB_X := 20, iGB_Y := 20, iGB_H := 160
        gcBackupROMsGroup := guiFileTools.AddGroupBox("X" iGB_X " Y" iGB_Y " H" iGB_H " W" iGB_W, "ROM Files (*.zip)")

        gcBackupROMsLabel := guiFileTools.AddText("x" iGB_X + 5 " y" iGB_Y + 25 " w" iGB_W - 10 " h" 30 " Center")

        gcBackupROMsButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 85 " y" iGB_Y + 70 " w" 80 " h" 25, "Backup")
        gcBackupROMsButton.OnEvent("Click", (*) => Setup.gcBackupROMsButton_Click())
        gcBackupROMsButton.TT := "Press to backup all ATC rom files."

        gcRestoreROMsButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 + 5 " y" iGB_Y + 70 " w" 80 " h" 25, "Restore")
        gcRestoreROMsButton.OnEvent("Click", (*) => Setup.gcRestoreROMsButton_Click())
        gcRestoreROMsButton.TT := "Press to restore all backed-up ATC rom files."

        gcCopyRomsButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 85 " y" iGB_Y + 110 " w" 80 " h" 25, "Copy...")
        gcCopyRomsButton.OnEvent("Click", (*) => Setup.CopyRomsButton_Click(guiFileTools.Hwnd))
        gcCopyRomsButton.TT := "Copy roms from a source`nfolder to the rom folder."

        gcAuditButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 + 5 " y" iGB_Y + 110 " w" 80 " h" 25, "Audit...")
        gcAuditButton.OnEvent("Click", (*) => Setup.AuditButton_Click(gcFileToolsProgress))
        gcAuditButton.TT := "Press to perform an audit for missing and bad roms.`nA report will display when complete.`n`nIf you need a list of all Arcade Time Capsule roms and`ntheir MAME versions, run this audit on an empty folder."

        ;Backup Config Files
        iGB_W := 220, iGB_X := iGB_X + iGB_W + 15, iGB_Y := 20, iGB_H := 160
        gcBackupConfigGroup := guiFileTools.AddGroupBox("X" iGB_X " Y" iGB_Y " H" iGB_H " W" iGB_W, "TAB Menu Controller Files (*.cfg)")

        gcBackupConfigLabel := guiFileTools.AddText("x" iGB_X + 5 " y" iGB_Y + 25 " w" iGB_W - 10 " h" 30 " Center")

        gcBackupConfigButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 85 " y" iGB_Y + 70 " w" 80 " h" 25, "Backup")
        gcBackupConfigButton.OnEvent("Click", (*) => Setup.gcBackupConfigButton_Click())
        gcBackupConfigButton.TT := "Press to backup all ATC *.cfg`nTAB menu configuration files."

        gcRestoreConfigButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 + 5 " y" iGB_Y + 70 " w" 80 " h" 25, "Restore")
        gcRestoreConfigButton.OnEvent("Click", (*) => Setup.gcRestoreConfigButton_Click())
        gcRestoreConfigButton.TT := "Press to restore all backed-up ATC *.cfg`nTAB menu configuration files."

        gcResetConfigButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 85 " y" iGB_Y + 110 " w" 80 " h" 25, "Reset")
        gcResetConfigButton.OnEvent("Click", (*) => Setup.gcResetConfigButton_Click())
        gcResetConfigButton.TT := "Press to delete all ATC *.cfg TAB menu`nconfiguration files, restoring the defaults."

        gcPatchConfigButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 + 5 " y" iGB_Y + 110 " w" 80 " h" 25, "Patch")
        gcPatchConfigButton.OnEvent("Click", (*) => Setup.gcPatchConfigButton_Click())
        gcPatchConfigButton.TT := "Press to patch ATC *.cfg`nTAB menu configuration files.`nSee documentation for more details."

        ;Backup High Score Files 
        iGB_W := 220, iGB_X := iGB_X + iGB_W + 15, iGB_Y := 20, iGB_H := 160
        gcBackupHSGroup := guiFileTools.AddGroupBox("X" iGB_X " Y" iGB_Y " H" iGB_H " W" iGB_W, "High Score Files (*.hi and *.nv)")

        gcBackupHSLabel := guiFileTools.AddText("x" iGB_X + 5 " y" iGB_Y + 25 " w" iGB_W - 10 " h" 30 " Center")

        gcBackupHSButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 85 " y" iGB_Y + 70 " w" 80 " h" 25, "Backup")
        gcBackupHSButton.OnEvent("Click", (*) => Setup.gcBackupHSButton_Click())
        gcBackupHSButton.TT := "Press to backup all ATC high score (*.hi) and machine state (*.nv) files."

        gcRestoreHSButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 + 5 " y" iGB_Y + 70 " w" 80 " h" 25, "Restore")
        gcRestoreHSButton.OnEvent("Click", (*) => Setup.gcRestoreHSButton_Click())
        gcRestoreHSButton.TT := "Press to restore all backed-up ATC *.hi high`nscore and all *.nv machine state files."

        gcResetHSButton := guiFileTools.AddButton("x" iGB_X + iGB_W/2 - 40 " y" iGB_Y + 110 " w" 80 " h" 25, "Reset")
        gcResetHSButton.OnEvent("Click", (*) => Setup.gcResetHSButton_Click())
        gcResetHSButton.TT := "Press to delete all ATC *.hi high score and all *.nv machine state files.`nThis will restore all machines to their default states.`n`nA backup is recommended before performing this action."

        ;Dialog close
        gcBackupDialogCloseButton := guiFileTools.AddButton("x" Setup.FileTools.W/2 - 40 " y" Setup.FileTools.H - 40 " w" 80 " h" 25, "Close")
        gcBackupDialogCloseButton.OnEvent("Click", (*) => Setup.FileToolsDialogCloseButton_Click())
    }

    static ShowSetupDialog()
    {
        try guiSettings.Opt("+Disabled")
        guiSetup.Opt("-Resize -MaximizeBox -MinimizeBox")
        guiSetup.Show("x" Setup.mSetup.X " y" Setup.mSetup.Y " w" Setup.mSetup.Width " h" Setup.mSetup.Height)

        g_oLog.LogLine("INFO: Showing Setup Dialog.`n")

        Setup.PopulateFields()
    }

    static PopulateFields()
    {
        global g_oArcadeRomList

        if (!gcArcadeDropDown.Text)
            try gcArcadeDropDown.Text := IniRead(g_sIniFile, "General", "Arcade", "Arcade Time Capsule 3.6")

        try gcArcadeExeEdit.Text := IniRead(g_sIniFile, gcArcadeDropDown.Text, "Application")
        try gcROMMonitorFolderEdit.Text := IniRead(g_sIniFile, gcArcadeDropDown.Text, "ROMFolder")            

        if (!gcArcadeExeEdit.Text && InStr(gcArcadeDropDown.Text, "Arcade Time Capsule"))
            gcArcadeExeEdit.Text := "RetroVRArcade.exe"      

        ;Set globals
        global g_sArcadeString := gcArcadeDropDown.Text
        global g_sArcadeExeName := gcArcadeExeEdit.Text
        global g_sROMMonitorFolder := gcROMMonitorFolderEdit.Text 
        global g_sDirectoryFile := g_sArcadeFolder "\" g_sArcadeString ".Directory.ini"
        global g_sFloorsFile := g_sArcadeFolder "\" g_sArcadeString ".Floors.json"

        global g_sATCFolder := g_sROMMonitorFolder "\..\..\.."
        global g_sATCHighScoreRootFolder := g_sATCFolder "\RetroVRArcade\Plugins\save"
        global g_sHighScoreFolder := g_sATCHighScoreRootFolder "\mame2010\hi"
       
        ;During startup, we reach this before the Settings dialog
        ;is created, so make sure we don't call these methods prematurely.
        if (IsSet(guiSettings))
        {
            Settings.ReadFloors()
        }

        local sRomListFile := g_sArcadeFolder "\" g_sArcadeString ".RomList.json"

        ;Initialize the global g_oArcadeRomList
        if (g_sArcadeString != "Other") ;skip if "Other"
        {
            if (FileExist(sRomListFile))
            {
                sJSON := FileRead(sRomListFile)
                g_oArcadeRomList := JSON.parse(sJSON)
            }
            else {
                g_oLog.LogLine("ERROR: Could not find rom list file: " sRomListFile "`n")
            }

            iCount := g_oArcadeRomList.Count
            if (iCount == 0)
                g_oLog.LogLine("ERROR: Arcade rom list is empty!`n")
        }

        gcSetupCopyRomsButton.Enabled := gcSetupAuditButton.Enabled := g_sArcadeString != "Other" && DirExist(gcROMMonitorFolderEdit.Text) ? true : false
        gcFileToolsButton.Enabled := g_sArcadeString != "Other" && DirExist(g_sATCFolder "\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text "\..\..\..\RetroVRArcade\Plugins\save") && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

        Setup.UpdateApplyButton()
    }

    static FileToolsButton_Click()
    {
        try guiSetup.Opt("+Disabled")

        guiFileTools.Show("W" Setup.FileTools.W " H" Setup.FileTools.H " X" A_ScreenWidth / 2 - Setup.FileTools.W / 2 " Y" A_ScreenHeight / 2 - Setup.FileTools.H)
        guiFileTools.Opt("+Owner" guiSetup.Hwnd)

        ;Update config file status text
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup"))
        {
            sDate := FileRead(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup")
            gcBackupConfigLabel.Text := "Last backup performed on:`n" sDate
        }
        else 
        {
            gcBackupConfigLabel.Text := "Press Backup button now to`nbackup ATC cfg files."
        }

        ;Update high score file status text
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup")) 
        {
            sDate := FileRead(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup")
            gcBackupHSLabel.Text := "Last backup performed on:`n" sDate
        }
        else 
        {
             gcBackupHSLabel.Text := "Press Backup button now to backup`nATC high score and nvram files."
        }

        ;Update ROM file status text
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup")) 
        {
            sDate := FileRead(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup")
            gcBackupROMsLabel.Text := "Last backup performed on:`n" sDate
        }
        else 
        {
             gcBackupROMsLabel.Text := "Press Backup button now to backup`nATC rom files and chd folders."
        }

        Setup.UpdateFileToolsButtonStates()
    }

    static UpdateFileToolsButtonStates()
    {
        ;******************************************
        ; config file tasks
        ;****************************************** 
        gcBackupConfigButton.Enabled := true

        ;only enable the config restore, delete, and patch buttons if there is a backup
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\cfg\.backup"))
        {
            gcRestoreConfigButton.Enabled := true
            gcResetConfigButton.Enabled := true
            gcPatchConfigButton.Enabled := true
        }
        else
        {
            gcRestoreConfigButton.Enabled := false
            gcResetConfigButton.Enabled := false
            gcPatchConfigButton.Enabled := false
        }

        ;******************************************
        ; high score file tasks
        ;******************************************       
        gcBackupHSButton.Enabled := true

        ;only enable the high score restore and reset buttons if there is a backup
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup") && g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\.backup")
        {
            gcRestoreHSButton.Enabled := true
            gcResetHSButton.Enabled := true
        }
        else
        {
            gcRestoreHSButton.Enabled := false
            gcResetHSButton.Enabled := false
        }

        ;******************************************
        ; ROM file file tasks
        ;******************************************  
         gcCopyRomsButton.Enabled := gcAuditButton.Enabled := g_sArcadeString != "Other" && DirExist(gcROMMonitorFolderEdit.Text) ? true : false

        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup"))
        {
            gcRestoreROMsButton.Enabled := true
        }
        else
        {
            gcRestoreROMsButton.Enabled := false
        }
    }

    static gcBackupROMsButton_Click()
    {
        if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcBackupROMsButton.TT
		gcBackupROMsButton.TT := ""
		ToolTip()

        result := "Yes"
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup"))
            result := MsgBox("Performing this ROM file backup will overwrite any previous backups.`n`nAre you sure you would like to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform ROM backup?", 36 " Owner" guiFileTools.Hwnd)
        else
            result := MsgBox("Performing this operation will create a backup of all ATC *.zip ROM files and *.chd file folders.`n`nAre you ready to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform ROM backup?", 36 " Owner" guiFileTools.Hwnd)

        if (result == "No")
        {
            gcBackupROMsButton.TT := tempTT
            return
        }

        ;Delete and create the folders
        for i, sVer in Setup.GetMAMEVersions()
        {
            try DirDelete(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer)
            CreateDirAndLog(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer)
        }

        guiFileTools.Opt("+Disabled")
        gcFileToolsProgress.Visible := true

        iFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {
            for sRom, mInfo in g_oArcadeRomList
            {
                gcFileToolsProgress.Value := iFilesCopied / g_oArcadeRomList.Count * 100 ;increment progress bar

                ;copy the rom
                if (mInfo["MAMEVersion"] == sVer)
                {
                    try FileCopy(g_sATCFolder "\RetroVRArcade\Content\Roms\" sRom ".zip", g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer, 1)
                    iFilesCopied++
                }

                ;copy folder (accompanying chd folder, for example)
                if (mInfo["HasFolder"] == "1" && mInfo["MAMEVersion"] == sVer)
                {
                    try DirCopy(g_sATCFolder "\RetroVRArcade\Content\Roms\" sRom, g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer "\" sRom, 1)
                    iFilesCopied++
                }
            }
        }

        gcFileToolsProgress.Value := 100
        Sleep 500
        gcFileToolsProgress.Visible := false
        gcFileToolsProgress.Value := 0

        guiFileTools.Opt("-Disabled")

        if (iFilesCopied > 0)
        {
            MsgBox("Successfully backed-up " iFilesCopied " ROM files.", "Backup Completed", 64 " Owner" guiFileTools.Hwnd)

            try FileDelete(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup")

            sTimestamp := FormatTime(A_Now, "ShortDate") " at " FormatTime(A_Now, "Time")
            FileAppend(sTimestamp, g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\.backup")

            gcBackupROMSLabel.Text := "Last backup performed on:`n" sTimestamp

            Setup.UpdateFileToolsButtonStates()
        }
        else
            MsgBox "No ROM files were found to back-up.", "Backup Unsuccessful", 16

        gcBackupROMsButton.TT := tempTT

        return
    }

    static gcRestoreROMsButton_Click()
    {
       if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcRestoreROMsButton.TT
		gcRestoreROMsButton.TT := ""
		ToolTip()

        result := "Yes"
        result := MsgBox("Performing this ROM file restore will overwrite existing files in ATC with the ones you had previously backed-up.`n`nAre you sure you would like to proceed?`nPress 'Yes' to restore now, or press 'No' to abort.", "Perform ROM file restore?", 36 " Owner" guiFileTools.Hwnd)

        if (result == "No")
        {
            gcRestoreROMsButton.TT := tempTT
            return
        }

        guiFileTools.Opt("+Disabled")
        gcFileToolsProgress.Visible := true

        iFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {        
            for sRom, mInfo in g_oArcadeRomList
            {
                gcFileToolsProgress.Value := iFilesCopied / g_oArcadeRomList.Count * 100 ;increment progress bar

                ;copy the rom
                if (mInfo["MAMEVersion"] == sVer)
                {
                    try FileCopy(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer "\" sRom ".zip", g_sATCFolder "\RetroVRArcade\Content\Roms", 1)
                    iFilesCopied++
                }

                ;copy folder (accompanying chd folder, for example)
                if (mInfo["HasFolder"] == "1" && mInfo["MAMEVersion"] == sVer)
                {
                    try DirCopy(g_sArcadeFolder "\" g_sArcadeString "\Backup\roms\mame" sVer "\" sRom, g_sATCFolder "\RetroVRArcade\Content\Roms\" sRom, 1)
                    iFilesCopied++
                }
            }
        }

        gcFileToolsProgress.Value := 100
        Sleep 500
        gcFileToolsProgress.Visible := false
        gcFileToolsProgress.Value := 0

        guiFileTools.Opt("-Disabled")

        if (iFilesCopied > 0)
            MsgBox("Successfully restored " iFilesCopied " ROM files.", "Restore Completed", 64 " Owner" guiFileTools.Hwnd)
        else
            MsgBox("There were no ROM files found to restore.", "Restore Unsuccessful", 16 " Owner" guiFileTools.Hwnd)

        gcBackupROMsButton.Enabled := true

        gcRestoreROMsButton.TT := tempTT
        return
    }

    static gcBackupHSButton_Click()
    {
        if (!DirExist(g_sROMMonitorFolder))
            return

        ;Must force dismisal of ToolTip over browse window
		tempTT := gcBackupHSButton.TT
		gcBackupHSButton.TT := ""
		ToolTip()

        result := "Yes"
        if (FileExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup"))
            result := MsgBox("Performing this high score file backup will overwrite any previous backups.`n`nAre you sure you would like to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform high score file backup?", 36 " Owner" guiFileTools.Hwnd)
        else
            result := MsgBox("Performing this operation will create a backup of all ATC high score and and nvram files.`n`nAre you ready to proceed?`nPress 'Yes' to backup now, or press 'No' to abort.", "Perform high score file backup?", 36 " Owner" guiFileTools.Hwnd)

        if (result == "No")
        {
            gcBackupHSButton.TT := tempTT
            return
        }

        ;Create the backup folders if needed
        for i, sVer in Setup.GetMAMEVersions()
        {
            if (!DirExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\mame" sVer))
                CreateDirAndLog(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\mame" sVer)

            if (!DirExist(g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\mame" sVer))
                CreateDirAndLog(g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\mame" sVer)
        }

        ;Delete files in backup folders
        for i, sVer in Setup.GetMAMEVersions()
        {
            Loop files g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\mame" sVer "\*.hi??" 
            {
                FileDelete(A_LoopFileFullPath)
            }

            Loop files g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\mame" sVer "\*.nv"
            {
                FileDelete(A_LoopFileFullPath)
            }
        }

        iHiFilesCopied := iHighFilesCopied := iNvramFilesCopied := 0
        for i, sVer in Setup.GetMAMEVersions()
        {
            ;Backup *.hi files
            Loop files g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\hi\*.hi" 
            {
                FileCopy(A_LoopFileFullPath, g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\mame" sVer, 1)
                iHiFilesCopied++
            }

            ;Backup *.nvram files
            Loop files g_sATCFolder "\RetroVRArcade\Plugins\save\mame" sVer "\nvram\*.nv" 
            {
                FileCopy(A_LoopFileFullPath, g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\mame" sVer, 1)
                iNvramFilesCopied++
            }
        }

        iFilesBackedUp := iHiFilesCopied + iHighFilesCopied + iNvramFilesCopied

        if (iFilesBackedUp > 0)
        {
            MsgBox("Successfully backed-up " iHiFilesCopied " *.hi files, and " iNvramFilesCopied " *.nv files.", "Backup Completed", 64 " Owner" guiFileTools.Hwnd)

            try FileDelete(g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup")
            try FileDelete(g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\.backup")

            sTimestamp := FormatTime(A_Now, "ShortDate") " at " FormatTime(A_Now, "Time")

            FileAppend(sTimestamp, g_sArcadeFolder "\" g_sArcadeString "\Backup\hi\.backup")
            FileAppend(sTimestamp, g_sArcadeFolder "\" g_sArcadeString "\Backup\nvram\.backup")

            gcBackupHSLabel.Text := "Last backup performed on:`n" sTimestamp

            Setup.UpdateFileToolsButtonStates()
        }
        else
            MsgBox("No files were found to back-up.", "Backup Unsuccessful", 16 " Owner" guiFileTools.Hwnd)

        gcBackupHSButton.TT := tempTT
        return
    }

