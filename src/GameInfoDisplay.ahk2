#Requires AutoHotkey v2.0

;This class supports the display of a game image and information overlay.
class GameInfoDisplay
{
	__New()
	{
		this._currentPage := 1
		this._totalPages := 0
		this._pages := Map()
		this._hideNavTriangles := false
		this._active := false
		this._rom := ""
	}

	CreateGameInfoScreen(sRom)
	{
		this.guiGameInfo := Gui(, "eipGui - guiGameInfo")
		this.guiGameInfo.Opt("-Caption -DPIScale")
		this.guiGameInfo.BackColor := "Black" 

		this.guiGameInfo.SetFont("cWhite s50")
		this.gcGameInfoPleaseWait := this.guiGameInfo.AddText("w" A_ScreenWidth " Center", "Preparing Game Information.`nPlease wait...")

		this.gcGameInfoPleaseWait.GetPos(&label_posX, &label_posY, &label_posW, &label_posH)
        label_xpos := A_ScreenWidth / 2 - label_posW / 2 ;center label horizontally

		this._rom := sRom
		sLogoFile := ""
		if (FileExist(g_sLogoFolder "\" sRom ".png")) ;logos are only in .png format
			sLogoFile := g_sLogoFolder "\" sRom ".png"

		if (sLogoFile)
		{
			this.gcGameInfoLogo := this.guiGameInfo.AddPicture("BackgroundTrans", sLogoFile)

			;Display logo
            this.gcGameInfoLogo.GetPos(&logo_posX, &logo_posY, &logo_posW, &logo_posH)

            ;The following code ensures that the logo fits in its designated position
            ;on the screen and keeps its aspect ratio
            if (logo_posH > A_ScreenHeight / 4) ;keep logo to no more than 1/4 the screen height
            {
                logoH := A_ScreenHeight / 4
                logoW := Floor(logo_posW * logoH/logo_posH)
            }
            else
            {
                logoH := logo_posH
                logoW := logo_posW
            }

            if (logoW > A_ScreenWidth / 2) ;keep logo to no more than 1/2 the screen width
            {
                origLogoW := logoW
                logoW := A_ScreenWidth / 2
                logoH := Floor(logoW * logoH/origLogoW)
            }        
            
			;Position the label and logo on the screen
            screen_topThird := A_ScreenHeight * (1/3)
			screen_centerH := A_ScreenHeight / 2
            screen_centerW := A_ScreenWidth / 2

			label_ypos := screen_topThird - label_posH / 2
			label_xpos := screen_centerW - label_posW / 2

			logo_ypos := screen_centerH
			logo_xpos := screen_centerW - logoW / 2
            
            this.gcGameInfoPleaseWait.Move(label_xpos, label_ypos)
            this.gcGameInfoLogo.Move(logo_xpos, logo_ypos, logoW, logoH)
		}
		else
		{
			this.gcGameInfoPleaseWait.Move(,A_ScreenHeight / 3)
		}

		this.gcGameInfoProgress := this.guiGameInfo.AddProgress("x" A_ScreenWidth * (3/8) " y" A_ScreenHeight * (6/8) " w" A_ScreenWidth / 4 " h" 40)
		this.gcGameInfoProgress.Value := 3 ;start at 3%

		this.ShowGameInfoScreen()
	}

	ShowGameInfoScreen()
	{
		;The "AlwaysOnTop and NA options here are critical to ensuring that the game information window
		;sits on top of the emulator (such as ATC), but does not take the focus (otherwise trackball and
		;spinner games will stop seeing the mouse). User mouse clicks or motion controller clicks can also
		;do this. 0x08000000 (WS_EX_NOACTIVATE), prevents mouse clicks from re-activating the screen and
		;the +E prefix indicates that extended styles are being applied.
		this.guiGameInfo.Opt("+AlwaysOnTop +E0x08000000") 
		this.guiGameInfo.Show("W" A_ScreenWidth " H" A_ScreenHeight " X0 Y0 NA")

		this._active := true
		g_oLog.LogLine("INFO: Showing GameInfo screen.`n")
	}

	/**
	 * Add a GameInfo page. The "info" type is two-column text data. All other types are images 
	 * (such as "cabinets", "flyers", etc.) that can be added by simply adding new subfolders
	 * containing rom-named *.png or *.jpg images to the \GameInfo\Assets folder. 
	 * 
	 * @param pageType - "info", "native" or an image type ("controls", "highscore", etc.)
	 * @param bVisible - whether this page is currently displayable
	 * @param control1 - image types require one control
	 * @param {string} control2 - "info" requires a second control since it has two columns
	 */
	AddPage(pageType, bVisible, control1, control2:="")
	{
		pages := this._pages

		this._totalPages++

		if (pageType != "info") ;adds an image type page (like a control panel map)
		{
			page := Map()
			page["type"] := pageType
			page["visible"] := bVisible
			page["control1"] := control1 ;the image control

			idx := this._totalPages
			pages[idx] := page
		}
		else if (pageType == "info") ;adds a page of mame.xml/mameinfo.dat text
		{
			page := Map()
			page["type"] := "info"
			page["visible"] := bVisible
			page["control1"] := control1 ;the left column edit control
			page["control2"] := control2 ;the right column edit control
			page["control1FormattedText"] := Array() ;array holding formatted text overlay controls
			page["control2FormattedText"] := Array() ;array holding formatted text overlay controls


			idx := this._totalPages
			pages[idx] := page
		}		

		this._pages := pages
	}

	/**
	 * Gets the logical start page by skipping over any invisible
	 * pages until a visible one is found.
	 * 
	 * @returns {number} 
	 */
	GetPageStart()
    {
		pageStart := this._currentPage := 1

		if (this._pages[pageStart]["visible"] == false)
			pageStart := this.GetPageNext()

		return pageStart
	}

	;Get the next logical page number
	GetPageNext()
	{
		loop
		{
			pageNext := ++this._currentPage

			if (pageNext > this._totalPages)
			{
				pageNext := 1
				this._currentPage := 1
			}

			;skip any pages that are not presently visible
			if (this._pages[pageNext]["visible"] == true || A_Index > this._totalPages)
				break
		}

		return pageNext
	}

	;Get the previous logical page number
	GetPagePrevious()
	{
		loop
		{
			pagePrev := --this._currentPage
			if (pagePrev < 1)
			{
				pagePrev := this._totalPages
				this._currentPage := pagePrev
			}

			;skip any pages that are not presently visible
			if (this._pages[pagePrev]["visible"] == true || A_Index > this._totalPages)
				break
		}

		return pagePrev
	}

	/**
	 * Page Navigation
	 * 
	 * "start" - Go to page 1 (for the first time - skips hide operation);
	 * "r"     - go one page to the right;
	 * "l"     - go one page to the left;
	 * "hide"  - hide the currently displayed page
	 * 
	 * @param directive - "start", "r", "l", or "hide"
	 * @returns {void} 
	 */
	GoPage(directive)
	{
		if (!this._active)
			return

		pages := this._pages ;the page collection

		;don't need to flip pages if there is 0 or 1 page in the collection
		if ((directive == "r" || directive == "l") && pages.Count <= 1)
			return

		;Hide the current page
		if (directive != "start") ;page is already blank for "start" so skip
		{
			thisPage := this._currentPage			
			pageType := pages[thisPage]["type"]

			if (pageType != "info") ;if image type
			{
				this.guiGameInfo.BackColor := "Black"
			
				try	(this.%pages[thisPage]["control1"]%).Visible := false
			}
			else if (pageType == "info")
			{
				this.guiGameInfo.BackColor := g_color_edit_bg				
				ShowPages()
			}
		}

		Switch directive 
		{
			case "hide":
				this.guiGameInfo.BackColor := "Black" 
				HidePages()
				return
			case "start":
				newPage := this.GetPageStart()
			case "r":
				HidePages()
				newPage := this.GetPageNext()
			case "l":
				HidePages()
				newPage := this.GetPagePrevious()
		}

		ShowPages()
		{
			thisPage := this._currentPage

			(this.%pages[thisPage]["control1"]%).Visible := true
			(this.%pages[thisPage]["control2"]%).Visible := true	

			for i, j in pages[thisPage]["control1FormattedText"]
				j.Visible := true
			for i, j in pages[thisPage]["control2FormattedText"]
				j.Visible := true
		}

		HidePages()
		{
			;hide the main edit controls
			try (this.%pages[thisPage]["control1"]%).Visible := false
			try (this.%pages[thisPage]["control2"]%).Visible := false

			;Hide any formatting overlay controls
			if (pages[thisPage]["type"] == "info")
			{
				for i, j in pages[thisPage]["control1FormattedText"]
					j.Visible := false
				for i, j in pages[thisPage]["control2FormattedText"]
					j.Visible := false
			}
		}
	 
		pageType := pages[newPage]["type"]

		;Show the new page
		if (pageType != "info") ;if an image type
		{
			this.guiGameInfo.BackColor := "Black" ;0x1F1F1F			
			(this.%pages[newPage]["control1"]%).Visible := true
		}
		else if (pageType == "info")
		{
			this.guiGameInfo.BackColor := g_color_edit_bg			
			ShowPages()
		}

		this._currentPage := newPage
	}

	;Call this between each game
	Clear()
	{
		this._currentPage := 1
		this._totalPages := 0
		this._pages := Map()

		try this.guiGameInfo.Destroy()

		this._active := false
	}
	
	/**
	 * ;Creates the actual image and info pages for each asset type
	 * @param assetType - either "info" or a folder name that is a subfolder in .\GameInfo\Assets
	 * @param {String} sType - file extension of image file (only for images)
	 */
	CreateGameInfoPage(assetType, sType:="")
	{
		global g_oMameData

		info_text := ""
		bPageVisible := true
		iProgressLinesPerPage := 0

		if (assetType == "info")
		{
			;*********************************
			; Info display
			;*********************************

			edit_margin := 45 ;this is 5 greater than the width of the navigation triangles
			edit_width := A_ScreenWidth // 2 - edit_margin
			edit_height := A_ScreenHeight			

			;These two "test" controls are used to discover the height of a single row in the edit control
			;-E0x200 hides the border (corresponds to WS_EX_CLIENTEDGE)
			;-Hdr removes column header
			iGameInfoFontSize := IniRead(g_sIniFile, "General", "GameInfoFontSize", g_iDefaultGameInfoFontSize)
			this.guiGameInfo.SetFont("s" iGameInfoFontSize, "Tahoma")
			this.guiGameInfo_Test1 := this.guiGameInfo.AddEdit("x0 y0 Hidden -VScroll -HScroll -E0x200 vTest1 R1") ;A one row edit control
			Tst1 := this.guiGameInfo_Test1.Hwnd

			;GuiControlGet, sz1, Pos, Test1
			this.guiGameInfo_Test1.GetPos(&sz1X, &sz1Y, &sz1sW, &sz1H)
			this.guiGameInfo_Test2 := this.guiGameInfo.AddEdit("x0 y0 Hidden -VScroll -HScroll -E0x200 vTest2 R2") ;A two row edit control
			Tst2 := this.guiGameInfo_Test2.Hwnd

			this.guiGameInfo_Test2.GetPos(&sz2X, &sz2Y, &sz2sW, &sz2H)
			ht := sz2H - sz1H ;the delta between the two test edit controls gives us the line height

			screen_lines := A_ScreenHeight // ht ;number of lines available for the screen height

			;get the history for the current game
			if (!IsObject(g_oMameData))
				g_oMameData := MAMEData(g_sMameInfoFile, g_sMameHistoryFile)

			mame_history_text := g_oMameData.GetHistory(this._rom)

			;some games in the history.xml defer to the base rom for a full desciption
			sBaseRom := IniRead(g_sBaseRomsFile, "BaseRoms", this._rom, "")
			mame_baserom_history_text := sBaseRom ? g_oMameData.GetHistory(sBaseRom) : ""
			if (mame_baserom_history_text)
				mame_baserom_history_text := "`n`n`n===== Base ROM Game Information =====`n`n" mame_baserom_history_text

			mame_info_text := g_oMameData.GetInfo(this._rom)
			if (mame_info_text)
				mame_info_text := "`n`n`n===== MAME Development History =====`n`n" mame_info_text

			if (!mame_history_text && !mame_info_text && !mame_baserom_history_text)
			{
				oGameInfo := ReadListXML.GetXMLMetaInfo(g_sGamesXMLFile, this._rom)
				info_text := "There is no information available for the game: " oGameInfo["description"] " (" this._rom ")"
			}
			else
				info_text := mame_history_text . mame_baserom_history_text . mame_info_text

			ChangeEncoding(&info_text, "CP0", "UTF-8")

			;Replace "En Dash" characters with "Hyphen-Minus" to avoid display issues.
			info_text := StrReplace(info_text, "–", "-")

			;Replace linefeeds with carriage return/linefeed
			info_text := StrReplace(info_text, "`n", "`r`n")

			if (info_text)
			{  
				;Add the first control
				this.guiGameInfo_GameInfo1 := this.guiGameInfo.AddEdit("x" edit_margin " y0 h" . edit_height . " w" . edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo1")
				hwndInfo1 := this.guiGameInfo_GameInfo1.Hwnd

				;These pages are just strings that will be double-deref'ed when called. 
				this.AddPage("info", true, "guiGameInfo_GameInfo1", "guiGameInfo_GameInfo2")

				;add history to first edit control. The number of lines can't be determined until
				;after this text is added due to word wrapping, proportional spacing, etc.
				this.guiGameInfo_GameInfo1.Text := info_text

				;Each loop populates a single edit control; every two edit controls form a page.
				;(basically, each edit control is one column of a two column text display)
				Loop
				{
					;As long as an edit control's text exceeds the on-screen capacity, copy
					;the overflow from that "src" control to the next "dest" control.
					srcIdx := A_Index
					destIdx := A_Index + 1

					;This is an odd/even check
					;if odd, margin is 0; if even, margin is at the middle (edit_width)
					x_pos := ((A_Index & 1) != 0) ? edit_width + edit_margin : edit_margin

					;Add page to GameInfoDisplay object every time we create a new odd (left) edit control
					if (x_pos == edit_margin)
						this.AddPage("info", true, "guiGameInfo_GameInfo" . destIdx, "guiGameInfo_GameInfo" . destIdx+1)

					;Create new dest control to accept the overflow
					this.guiGameInfo_GameInfo%destIdx% := this.guiGameInfo.AddEdit("x" . x_pos . " y0 h" . edit_height . " w" edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo%" . destIdx . "%")
					this.hwndInfo%destIdx% := this.guiGameInfo_GameInfo%destIdx%.Hwnd

					;SendMessage commands need the hwnd
					try {
						hwndSrc := this.guiGameInfo_GameInfo%srcIdx%.Hwnd
					}
					catch {
						hwndSrc := ""
					}

					try {
						hwndDest := this.guiGameInfo_GameInfo%destIdx%.Hwnd
					}
					catch {
						hwndDest := ""
					}
					
					;Get the full line count from the src control. Select all text that overflows the 
					;screen and cut/paste it into the new dest edit control.					
					total_lines := EditGetLineCount(hWndSrc)

					delta := total_lines - screen_lines ;this is the number of lines of overflow
	
					;Cut/Paste the overflow text from src to dest edit control
					if (delta > 0)
					{
						;winuser.h: https://gitlab.winehq.org/pali/wine/-/blob/wine-0.9.23/include/winuser.h?ref_type=tags
						ErrorLevel := SendMessage(0xBB, screen_lines-1, 0,,"ahk_id " . hwndSrc)  ; EM_LINEINDEX
						if (ErrorLevel == "FAIL")
							g_oLog.LogLine("WARNING: SendMessage EM_LINEINDEX failed in CreateGameInfoPage().`n")	
						offset := ErrorLevel ;this is the character # that starts the last displayable line

						;we use the lines on first page to estimate the approximate
						;lines-per-page for use with the the progress bar
						if (!iProgressLinesPerPage)
							iProgressLinesPerPage := offset

						ErrorLevel := SendMessage(0xB1, offset, -1,,"ahk_id " . hwndSrc)  ; EM_SETSEL  Note, the -1 selects to the end of the text
						if (ErrorLevel == "FAIL")
							g_oLog.LogLine("WARNING: SendMessage EM_SETSEL failed in CreateGameInfoPage().`n")
						success := ErrorLevel ;now select all the overflow text

						ErrorLevel := SendMessage(0x300,0,0,,"ahk_id " . hwndSrc)   ; WM_CUT    ;Cut overflow text from src edit control
						if (ErrorLevel == "FAIL")
							g_oLog.LogLine("WARNING: SendMessage EM_CUT failed in CreateGameInfoPage().`n")
						if !ClipWait(5) 
							g_oLog.LogLine("WARNING: Could not save to clipboard in CreateGameInfoPage().`n")
						Sleep 300 ;required, to avoid side-effects (partial data in screens)

						ErrorLevel := SendMessage(0x302,0,0,,"ahk_id " . hwndDest)  ; WM_PASTE  ;Paste this text into the dest edit control
						if (ErrorLevel == "FAIL")
							g_oLog.LogLine("WARNING: SendMessage EM_PASTE failed in CreateGameInfoPage().`n")
						Sleep 100 ;give paste a little extra time (leaving this out can cause partial or no paste issues)
						A_Clipboard := "" ;clear the clipboard						

						;Now get the full line count from the control we just pasted into, then get the delta 
						;to see if we need to continue.
						total_lines := EditGetLineCount(hWndDest)

						delta := total_lines - screen_lines ;this is the number of lines of overflow text
						;if there's no more overflow text left, then we're done.
						;otherwise, we continue the loop to create more edit controls.
						if (delta <= 0)
						{
							;make sure there are two edit controls on the screen
							if (x_pos == edit_margin) ;last control created was on the left side, so create empty one on the right.
							{
								destIdx++

								this.guiGameInfo_GameInfo%destIdx% := this.guiGameInfo.AddEdit("x" . edit_width . " y0 h" . edit_height . " w" . edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo%" . destIdx . "%")
								this.hwndInfo%destIdx% := this.guiGameInfo_GameInfo%destIdx%.Hwnd
							}
							
							break
						}

						iProgVal := Floor(iProgressLinesPerPage * A_Index / StrLen(info_text) * 100)
						this.gcGameInfoProgress.Value := iProgVal > 2 ? iProgVal : 3 ;start at 3% 
					}
					else
						break
				}
				
				;The edit control doesn't offer any options for formatting or coloring by individual
				;line/word/character, so do this using overlays.
				pages := this._pages								
				Loop pages.Count
				{
					iLineNum := 0
					sText := ""
				
					iLeftHwnd := this.guiGameInfo_GameInfo%A_Index * 2 - 1%.Hwnd
					iRightHwnd := this.guiGameInfo_GameInfo%A_Index * 2%.Hwnd
					iPage := A_Index

					FormatPage(iLeftHwnd, "control1FormattedText")
					FormatPage(iRightHwnd, "control2FormattedText")

				}

				;This function handles the specific formatting requests
				FormatPage(iHwnd, sControlType)
				{
					Loop EditGetLineCount(iHwnd)
					{
						iLineNum := A_Index	
						idx := iPage "_" iLineNum
						sText := EditGetLine(iLineNum, iHwnd)

						if (iPage == 1 && iLineNum == 1 && sControlType == "control1FormattedText")
						{
							CreateFormattedOverlay(idx, sControlType)
							this.gcFormattedText%idx%.Value := sText
							this.gcFormattedText%idx%.SetFont("italic")
						}

						if (iPage == 1 && iLineNum == 3 && sControlType == "control1FormattedText")
						{
							CreateFormattedOverlay(idx, sControlType)
							this.gcFormattedText%idx%.Value := sText
							this.gcFormattedText%idx%.SetFont("cWhite underline bold", "Verdana")
						}

						if (InStr(sText, "Bugs:", 1) || InStr(sText, "NOTE:", 1) || InStr(sText, "HOW TO PLAY:", 1) || InStr(sText, "STORY:",1) || InStr(sText, "LEVELS:", 1)
							InStr(sText, "SETUP:", 1) || InStr(sText, "TEST MODE:", 1) || InStr(sText, "WIP:", 1) || InStr(sText, "* CONSOLES:", 1) ||
						    InStr(sText, "* OTHERS:", 1) || InStr(sText, "* COMPUTERS:", 1) || InStr(sText, "* HANDHELDS:", 1) || InStr(sText, "* TODO:", 1) ||
							InStr(sText, "* GLITCH:", 1) || InStr(sText, "- TRIVIA -", 1) || InStr(sText, "- UPDATES -", 1) || InStr(sText, "- SCORING -", 1) || 
							InStr(sText, "- CAST OF CHARACTERS -", 1) || InStr(sText, "- STAFF -", 1) || InStr(sText, "- CONTRIBUTE -", 1) || InStr(sText, "- TECHNICAL -", 1) || 
							InStr(sText, "- TIPS AND TRICKS -", 1) || InStr(sText, "- SERIES -", 1) || InStr(sText, "- PORTS -", 1)) 
						{		
							CreateFormattedOverlay(idx, sControlType)
							this.gcFormattedText%idx%.Value := sText
							this.gcFormattedText%idx%.SetFont("cWhite", "Verdana")
						}

						if (InStr(sText, "=====")) 
						{		
							CreateFormattedOverlay(idx, sControlType)
							this.gcFormattedText%idx%.Value := Trim(sText, " =")
							this.gcFormattedText%idx%.SetFont("cWhite bold", "Verdana")
						}						
					}
				}

				;Creates the overlay edit control and positions it on the host control
				CreateFormattedOverlay(idx, sControlType)
				{				
					margin := sControlType == "control1FormattedText" ? edit_margin : edit_width + edit_margin	
					this.gcFormattedText%idx% := this.guiGameInfo.AddEdit("c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 R1") ;A one row edit control
					pages[iPage][sControlType].Push(this.gcFormattedText%idx%) 
					yPos := ht * (iLineNum - 1)
					this.gcFormattedText%idx%.Move(margin, yPos, edit_width - edit_margin, ht)
				}

				iProg := this.gcGameInfoProgress.Value
				this.gcGameInfoProgress.Value := 100

				if (iProg == 100)
					Sleep 100
				else
					Sleep 500

				this.gcGameInfoPleaseWait.Visible := false
				this.gcGameInfoProgress.Visible := false

				try this.gcGameInfoLogo.Visible := false
			}
		}
		else ;assetType not "info", so must be an image type
		{
			asset_full_path := g_sAssetsFolder "\" assetType "\" this._rom "." sType

			this.guiGameInfo_GameImage%assetType% := this.guiGameInfo.AddPicture("BackgroundTrans Hidden vGameImage%" . assetType . "%", asset_full_path)		
			this.guiGameInfo_GameImage%assetType%.GetPos(&game_image_posX, &game_image_posY, &game_image_posW, &game_image_posH)
	
			;This is the enlargement limit to keep low res images from
			;becoming unreasonably pixelated
			nMaxEnlarge := 1.5

			image_width := game_image_posW * nMaxEnlarge
			image_width := image_width >= A_ScreenWidth ? A_ScreenWidth : image_width

			;Resize the image to fit on the screen while preserving aspect ratio
			;image_width := A_ScreenWidth
			image_height := image_width * game_image_posH / game_image_posW
	
			if (image_height > A_ScreenHeight)
			{
				image_height := A_ScreenHeight
				image_width := image_height * game_image_posW / game_image_posH
			}
			
			;center image
			image_x := Floor(A_ScreenWidth / 2 - image_width / 2)
			image_y := Floor(A_ScreenHeight / 2 - image_height / 2)
	
			this.guiGameInfo_GameImage%assetType%.Move(image_x, image_y, image_width, image_height)
	
			;Add this control to the oGameControl collection manager
			this.AddPage(assetType, bPageVisible, "guiGameInfo_GameImage" . assetType)
		}
	}

	HasContent()
	{
		tp := this._totalPages
		if (tp > 0)
			return true
		
		return false
	}

	CurrentPage
	{
		get => this._currentPage
	}

	CurrentPageType
	{
		get => this._pages[this._currentPage]["type"]
	}

	Active
	{
		get => this._active
	}
}

ChangeEncoding(&sStr, sFrom, sTo)
{
	buf := Buffer(StrPut(sStr, sFrom))
    StrPut(sStr, buf, sFrom)
    sStr := StrGet(buf, sTo)
}