#Requires AutoHotkey v2.0

;This class supports the display of a game image and information overlay.
class GameInfoDisplay
{
	__New()
	{
		this._currentPage := 1
		this._totalPages := 0
		this._pages := Map()
		this._active := false
		this._rom := ""
		this._ScreenWidth := A_ScreenWidth
		this._ScreenHeight := A_ScreenHeight	
		this._boundsLeft := 0
		this._boundsRight := 0
		this._boundsTop := 0
		this._boundsBottom := 0
		this._sNextStyle := ""
		this._bLineGroup := false
	}

	CreateGameInfoScreen(sRom)
	{
		iMonitorCount := SysGet(80)
		global g_iMonitor := iMonitorCount < g_iMonitor ? 1 : g_iMonitor

		;Get the relative bounds of the monitor we will be using for GameInfo.
		;For multimonitor support, note that we only need to move the gui to the
		;designated monitor's coordinates and not the controls since the control 
		;positions are always relative to the parent gui.
		try {
			MonitorGet(g_iMonitor, &boundsLeft, &boundsTop, &boundsRight, &boundsBottom) ;boundsLeft=2560, boundsTop=0, boundsRight=4480, boundsBottom=1200
			this._boundsLeft := boundsLeft
			this._boundsRight := boundsRight
			this._boundsTop := boundsTop
			this._boundsBottom := boundsBottom
			this._ScreenWidth := boundsRight - boundsLeft
			this._ScreenHeight := boundsBottom - boundsTop
		}
		catch
		{
			g_oLog.LogLine("WARNING: Monitor=" g_iMonitor ", in " g_sIniFile " is invalid on this system. Using monitor 1 instead. Please specify a monitor number that exists on this machine.")
		}

		;Create the main GameInfo screen
		this.guiGameInfo := Gui(, "vfeGui - guiGameInfo")
		this.guiGameInfo.Opt("-Caption -DPIScale")
		this.guiGameInfo.BackColor := "Black" 

		;Also create an overlay to protect the GameInfo screen from mouse clicks
		this.guiGameInfoOverlay := Gui(, "vfeGui - guiGameInfoOverlay")
		this.guiGameInfoOverlay.Opt("-Caption -DPIScale")

		this.guiGameInfo.SetFont("cWhite s50")
		this.gcGameInfoPleaseWait := this.guiGameInfo.AddText("w" this._ScreenWidth " Center", "Preparing Game Information.`nPlease wait...")

		this.gcGameInfoPleaseWait.GetPos(&label_posX, &label_posY, &label_posW, &label_posH)
        label_xpos := this._ScreenWidth / 2 - label_posW / 2 ;center label horizontally

		this._rom := sRom
		sLogoFile := ""
		if (FileExist(g_sLogoFolder "\" sRom ".png")) ;logos are only in .png format
			sLogoFile := g_sLogoFolder "\" sRom ".png"

		if (sLogoFile)
		{
			this.gcGameInfoLogo := this.guiGameInfo.AddPicture("BackgroundTrans", sLogoFile)

			;Display logo
            this.gcGameInfoLogo.GetPos(&logo_posX, &logo_posY, &logo_posW, &logo_posH)

            ;The following code ensures that the logo fits in its designated position
            ;on the screen and keeps its aspect ratio
            if (logo_posH > this._ScreenHeight / 4) ;keep logo to no more than 1/4 the screen height
            {
                logoH := this._ScreenHeight / 4
                logoW := Floor(logo_posW * logoH/logo_posH)
            }
            else
            {
                logoH := logo_posH
                logoW := logo_posW
            }

            if (logoW > this._ScreenWidth / 2) ;keep logo to no more than 1/2 the screen width
            {
                origLogoW := logoW
                logoW := this._ScreenWidth / 2
                logoH := Floor(logoW * logoH/origLogoW)
            }        
            
			;Position the label and logo on the screen
            screen_topThird := this._ScreenHeight * (1/3)
			screen_centerH := this._ScreenHeight / 2
            screen_centerW := this._ScreenWidth / 2

			label_ypos := screen_topThird - label_posH / 2
			label_xpos := screen_centerW - label_posW / 2

			logo_ypos := screen_centerH
			logo_xpos := screen_centerW - logoW / 2
            
            this.gcGameInfoPleaseWait.Move(label_xpos, label_ypos)
            this.gcGameInfoLogo.Move(logo_xpos, logo_ypos, logoW, logoH)
		}
		else
		{
			this.gcGameInfoPleaseWait.Move(,this._ScreenHeight / 3)
		}

		this.gcGameInfoProgress := this.guiGameInfo.AddProgress("x" this._ScreenWidth * (3/8) " y" this._ScreenHeight * (6/8) " w" this._ScreenWidth / 4 " h" 40)
		this.gcGameInfoProgress.Value := 3 ;start at 3%

		this.ShowGameInfoScreen()
	}

	ShowGameInfoScreen()
	{
		;The "AlwaysOnTop and NA options here are critical to ensuring that the game information window
		;sits on top of the emulator (such as ATC), but does not take the focus (otherwise trackball and
		;spinner games will stop seeing the mouse). User mouse clicks or motion controller clicks can also
		;do this. 0x08000000 (WS_EX_NOACTIVATE), prevents mouse clicks from re-activating the screen and
		;the +E prefix indicates that extended styles are being applied.
		this.guiGameInfo.Opt("+AlwaysOnTop +E0x08000000") 
		this.guiGameInfo.Show("X" this._boundsLeft " Y" this._boundsTop "W" this._ScreenWidth " H" this._ScreenHeight " NA")

		;This overlay protects the underlying screen from receiving mouse clicks
		this.guiGameInfoOverlay.Opt("+AlwaysOnTop +E0x08000000") 
		this.guiGameInfoOverlay.Opt("+Owner" this.guiGameInfo.Hwnd)
		this.guiGameInfoOverlay.Show("X" this._boundsLeft " Y" this._boundsTop "W" this._ScreenWidth " H" this._ScreenHeight " NA")
		WinSetTransparent(1, "ahk_id " this.guiGameInfoOverlay.Hwnd) ;don't set this completely transparent (0) or mouse clicks will leak through

		global g_guiGameInfoOverlayHwnd := this.guiGameInfoOverlay.Hwnd

		this._active := true
		g_oLog.LogLine("INFO: Showing GameInfo screen.`n")
	}

	GetBounds(&X:=0, &Y:=0, &W:=0, &H:=0)
	{
		X := this._boundsLeft
		Y := this._boundsTop
		W := this._ScreenWidth
		H := this._ScreenHeight
	}

		;Call this between each game
	Clear()
	{
		this._currentPage := 1
		this._totalPages := 0
		this._pages := Map()

		try this.guiGameInfo.Destroy()
		try this.guiGameInfoOverlay.Destroy()

		this._active := false
		g_oLog.LogLine("INFO: GameInfo screen destroyed.`n")
	}

	/**
	 * Add a GameInfo page. The "info" type is two-column text data. All other types are images 
	 * (such as "cabinets", "flyers", etc.) that can be added by simply adding new subfolders
	 * containing rom-named *.png or *.jpg images to the \GameInfo\Assets folder. 
	 * 
	 * @param pageType - "info", "native" or an image type ("controls", "highscore", etc.)
	 * @param bVisible - whether this page is currently displayable
	 * @param control1 - image types require one control
	 * @param {string} control2 - "info" requires a second control since it has two columns
	 */
	AddPage(pageType, bVisible, control1, control2:="")
	{
		pages := this._pages

		this._totalPages++

		if (pageType != "info") ;adds an image type page (like a control panel map)
		{
			page := Map()
			page["type"] := pageType
			page["visible"] := bVisible
			page["control1"] := control1 ;the image control

			idx := this._totalPages
			pages[idx] := page
		}
		else if (pageType == "info") ;adds a page of mame.xml/mameinfo.dat text
		{
			page := Map()
			page["type"] := "info"
			page["visible"] := bVisible
			page["control1"] := control1 ;the left column edit control
			page["control2"] := control2 ;the right column edit control
			page["control1Fields"] := Array() ;array holding formatted field overlay controls
			page["control2Fields"] := Array() ;array holding formatted field overlay controls

			idx := this._totalPages
			pages[idx] := page
		}		

		this._pages := pages
	}

	/**
	 * Gets the logical start page by skipping over any invisible
	 * pages until a visible one is found.
	 * 
	 * @returns {number} 
	 */
	GetPageStart()
    {
		pageStart := this._currentPage := 1

		if (this._pages[pageStart]["visible"] == false)
			pageStart := this.GetPageNext()

		return pageStart
	}

	;Get the next logical page number
	GetPageNext()
	{
		loop
		{
			pageNext := ++this._currentPage

			if (pageNext > this._totalPages)
			{
				pageNext := 1
				this._currentPage := 1
			}

			;skip any pages that are not presently visible
			if (this._pages[pageNext]["visible"] == true || A_Index > this._totalPages)
				break
		}

		return pageNext
	}

	;Get the previous logical page number
	GetPagePrevious()
	{
		loop
		{
			pagePrev := --this._currentPage
			if (pagePrev < 1)
			{
				pagePrev := this._totalPages
				this._currentPage := pagePrev
			}

			;skip any pages that are not presently visible
			if (this._pages[pagePrev]["visible"] == true || A_Index > this._totalPages)
				break
		}

		return pagePrev
	}

	/**
	 * Page Navigation
	 * 
	 * "start" - Go to page 1 (for the first time - skips hide operation);
	 * "r"     - go one page to the right;
	 * "l"     - go one page to the left;
	 * "hide"  - hide the currently displayed page
	 * 
	 * @param directive - "start", "r", "l", or "hide"
	 * @returns {void} 
	 */
	GoPage(directive)
	{
		if (!this._active)
			return

		pages := this._pages ;the page collection

		;don't need to flip pages if there is 0 or 1 page in the collection
		if ((directive == "r" || directive == "l") && pages.Count <= 1)
			return

		Switch directive 
		{
			case "hide":
				this.guiGameInfo.BackColor := "Black" 
				HidePages()
				return
			case "start":
				newPage := this.GetPageStart()
			case "r":
				HidePages()
				newPage := this.GetPageNext()
			case "l":
				HidePages()
				newPage := this.GetPagePrevious()
		}

		ShowPages()
		{
			thisPage := this._currentPage

			(this.%pages[thisPage]["control1"]%).Visible := true	

			if (pages[thisPage]["type"] == "info")
			{
				(this.%pages[thisPage]["control2"]%).Visible := true

				for i, field in pages[thisPage]["control1Fields"]
					field.Visible := true
				for i, field in pages[thisPage]["control2Fields"]
					field.Visible := true
			}
		}

		HidePages()
		{
			thisPage := this._currentPage

			;hide the main edit controls
			try (this.%pages[thisPage]["control1"]%).Visible := false

			;Hide any field controls
			if (pages[thisPage]["type"] == "info")
			{
				try (this.%pages[thisPage]["control2"]%).Visible := false

				for i, field in pages[thisPage]["control1Fields"]
					field.Visible := false
				for i, field in pages[thisPage]["control2Fields"]
					field.Visible := false
			}
		}
	 
		pageType := pages[newPage]["type"]

		;Show the new page
		if (pageType != "info") ;if an image type
		{
			this.guiGameInfo.BackColor := "Black" ;0x1F1F1F			
			(this.%pages[newPage]["control1"]%).Visible := true
		}
		else if (pageType == "info")
		{
			this.guiGameInfo.BackColor := g_color_edit_bg			
			ShowPages()
		}
	}

	/**
	 * ;Creates the actual image and info pages for each asset type
	 * @param assetType - either "info" or a folder name that is a subfolder in .\GameInfo\Assets
	 * @param {String} sType - file extension of image file (only for images)
	 */
	CreateGameInfoPage(assetType, sType:="")
	{
		global g_oMameData

		info_text := ""
		bPageVisible := true
		iProgressLinesPerPage := 0
		iLineIndex := 0
		bDone := false

		if (assetType == "info")
		{
			;*********************************
			; Info display
			;*********************************

			edit_margin := 45 ;this is 5 greater than the width of the navigation triangles
			edit_width := this._ScreenWidth // 2 - edit_margin
			edit_height := this._ScreenHeight			

			;These two "test" controls are used to discover the height of a single row in the edit control
			;-E0x200 hides the border (corresponds to WS_EX_CLIENTEDGE)
			this.guiGameInfo.SetFont("s" g_iGameInfoFontSize, "Tahoma")
			this.guiGameInfo_Test1 := this.guiGameInfo.AddEdit("x0 y0 Hidden -VScroll -HScroll -E0x200 vTest1 R1") ;A one row edit control
			Tst1 := this.guiGameInfo_Test1.Hwnd

			this.guiGameInfo_Test1.GetPos(&sz1X, &sz1Y, &sz1sW, &sz1H)
			this.guiGameInfo_Test2 := this.guiGameInfo.AddEdit("x0 y0 Hidden -VScroll -HScroll -E0x200 vTest2 R2") ;A two row edit control
			Tst2 := this.guiGameInfo_Test2.Hwnd

			this.guiGameInfo_Test2.GetPos(&sz2X, &sz2Y, &sz2sW, &sz2H)
			ht := sz2H - sz1H ;the delta between the two test edit controls gives us the line height

			screen_lines := this._ScreenHeight // ht ;number of lines available for the screen height

			;get high score table for the current game
			leader_board := ""
			aLeaderboard := ""
			if (g_sArcadeString != "Other")
			{
				aLeaderboard := HighScore.ReadHighScores(this._rom)
				if (aLeaderboard) ;will be empty if no highscores
				{
					leader_board := HighScore.FormattedHighScore "`n`n"

					;since the length of a row is variable and we never want the unformatted linelength to
					;force a linebreak, at this stage we only write the rows as indexes in the form
					;<row>1</row>
					;<row>2</row>
					;etc.
					;Then, at the time of formatting where we have the opportunity to reduce the font size
					;if necessary, we will replace these with the actual text from aLeaderboard.
					for i, sLBLine in aLeaderboard
						leader_board := leader_board "<row>" A_Index "</row>`n"
				}
			}

			leader_board := leader_board "`n<===GameInformation/>`n`n"

			;get the history for the current game
			if (!IsObject(g_oMameData))
				g_oMameData := MAMEData(g_sMameInfoFile, g_sMameHistoryFile)

			mame_history_text := g_oMameData.GetHistory(this._rom)

			;split history into header (first 3 or 4 lines) and body
			mame_history_header := ""
			mame_history_body := ""
			Loop Parse mame_history_text, "`n"
			{
				if (A_Index <= 4) 
				{
					;if there's a two line game title, make it a single line. Not doing this messes
					;with the formatting (e.g. vasara)
					if (A_Index == 4 && A_LoopField) 
						mame_history_header := Trim(mame_history_header, "`n") "  " A_LoopField "`n`n"
					else 
						mame_history_header := mame_history_header A_LoopField "`n"
				}
				else
					mame_history_body := mame_history_body A_LoopField "`n"
			}

			;some games in the history.xml refer to the base rom for a full desciption
			;so lets look that up and include it.
			sBaseRom := IniRead(g_sRomRefFile, "BaseRoms", this._rom, "")

			mame_baserom_history_text := sBaseRom ? g_oMameData.GetHistory(sBaseRom) : ""
			mame_baserom_history_text :=  mame_baserom_history_text ? "`n`n<===OriginalGameInformation/>`n`n" mame_baserom_history_text : mame_baserom_history_text

			mame_info_text := g_oMameData.GetInfo(this._rom)				
			mame_info_text := mame_info_text ? "`n`n<===MAMEDevelopmentHistory/>`n`n" mame_info_text : mame_info_text

			if (!mame_history_header && !mame_history_body && !mame_info_text && !mame_baserom_history_text  && !leader_board)
			{
				oGameInfo := ReadListXML.GetXMLMetaInfo(g_sGamesXMLFile, this._rom)
				info_text := "There is no information available for the game: " oGameInfo["description"] " (" this._rom ")"
			}
			else
				info_text := mame_history_header . leader_board . mame_history_body . mame_baserom_history_text . mame_info_text

			;Replace "En Dash" characters with "Hyphen-Minus" to avoid display issues.
			info_text := StrReplace(info_text, "–", "-")

			;Replace linefeeds with carriage return/linefeed
			;(can't do this in MAMEData since the carriage returns seem to get 
			;stripped when the string is returned.)
			info_text := StrReplace(info_text, "`n", "`r`n")

			if (info_text)
			{  
				;Add the first control
				this.guiGameInfo_GameInfo1 := this.guiGameInfo.AddEdit("x" edit_margin " y0 h" . edit_height . " w" . edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo1")
				hwndInfo1 := this.guiGameInfo_GameInfo1.Hwnd

				;These pages are just strings that will be double-deref'ed when called. 
				this.AddPage("info", true, "guiGameInfo_GameInfo1", "guiGameInfo_GameInfo2")

				;add all the text to first edit control. The number of lines can't be determined
				;until after this text is added due to word wrapping, proportional spacing, etc.
				this.guiGameInfo_GameInfo1.Text := info_text

				;Get the full line count from the src control. Select all text and point an
				;index at where the overflow text					
				total_lines := EditGetLineCount(this.guiGameInfo_GameInfo1.Hwnd)

				;handle case where there will be no overflow text
				if (total_lines < screen_lines)
				{
					screen_lines := 0
					bDone := true
				}
				iLineIndex := screen_lines

				;Each loop populates a single edit control; every two edit controls form a page.
				;(basically, each of these edit controls is one column of a two column text display).
				;Formatted text is handled by overlaying one line edit controls containing the
				;formatted text over the individual page edit controls.
				Loop
				{
					;As long as an edit control's text exceeds the on-screen capacity, copy
					;the overflow text from that "src" control to the next "dest" control.
					srcIdx := A_Index
					destIdx := A_Index + 1

					;This is an odd/even check
					;if odd, margin is 0; if even, margin is at the middle (edit_width)
					x_pos := Odd(A_Index) ? edit_width + edit_margin : edit_margin

					;Add page to GameInfoDisplay object every time we create a new odd (left) edit control
					if (x_pos == edit_margin)
						this.AddPage("info", true, "guiGameInfo_GameInfo" . destIdx, "guiGameInfo_GameInfo" . destIdx+1)

					;Create new dest control to accept the overflow
					this.guiGameInfo_GameInfo%destIdx% := this.guiGameInfo.AddEdit("x" . x_pos . " y0 h" . edit_height . " w" edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo%" . destIdx . "%")
					this.hwndInfo%destIdx% := this.guiGameInfo_GameInfo%destIdx%.Hwnd

					try {
						hwndSrc := this.guiGameInfo_GameInfo%srcIdx%.Hwnd
					}
					catch {
						hwndSrc := ""
					}

					try {
						hwndDest := this.guiGameInfo_GameInfo%destIdx%.Hwnd
					}
					catch {
						hwndDest := ""
					}

					;Use the first edit control, which contains all of the text, and copy
					;overflow text to the next control.
					sLines := ""
					loop screen_lines
					{
						sLines := sLines EditGetLine(A_Index + iLineIndex, hwndInfo1) "`n"

						if (A_Index + iLineIndex == total_lines)
						{
							bDone := true
							break
						}
					}

					iLineIndex := iLineIndex + screen_lines
					this.guiGameInfo_GameInfo%destIdx%.Value := sLines

					;if there's no more overflow text left, then we're done.
					;otherwise, we continue the loop to create more edit controls.
					if (bDone)
					{
						;make sure there are two edit controls on the screen
						if (x_pos == edit_margin) ;last control created was on the left side, so create empty one on the right.
						{
							destIdx++

							this.guiGameInfo_GameInfo%destIdx% := this.guiGameInfo.AddEdit("x" . edit_width . " y0 h" . edit_height . " w" . edit_width . " c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 vGameInfo%" . destIdx . "%")
							this.hwndInfo%destIdx% := this.guiGameInfo_GameInfo%destIdx%.Hwnd
						}
						
						break
					}

					iProgVal := Floor(iProgressLinesPerPage * A_Index / StrLen(info_text) * 100)
					this.gcGameInfoProgress.Value := iProgVal > 2 ? iProgVal : 3 ;start at 3% 
				}

				;Finally, remove extra text from guiGameInfo_GameInfo1, which otherwise
				;can sometimes be seen at the very bottom of the control as extra text.
				if (screen_lines) ;this will be 0 if there was no overflow text
				{
					screen_lines := total_lines < screen_lines ? total_lines : screen_lines
					sLines := ""
					loop screen_lines {
						sLines := sLines EditGetLine(A_Index, hwndInfo1) "`n"
					}
					this.guiGameInfo_GameInfo1.Value := sLines
				}
				
				;The edit control doesn't offer any options for formatting or coloring by individual
				;line/word/character, so do this using overlays.
				pages := this._pages, iLineNum := 0, sText := "", sLastTitleFontSize := 0, sLastBaseRomTitleFontSize := 0							
				Loop pages.Count
				{
					iLeftHwnd := this.guiGameInfo_GameInfo%A_Index * 2 - 1%.Hwnd
					iRightHwnd := this.guiGameInfo_GameInfo%A_Index * 2%.Hwnd
					iPage := A_Index

					FormatField(iLeftHwnd, "control1Fields")
					FormatField(iRightHwnd, "control2Fields")
				}

				FormatField(iHwnd, sControlType)
				{
					Loop EditGetLineCount(iHwnd)-1
					{
						idx := iPage "_" A_Index
						sText := EditGetLine(A_Index, iHwnd)

						if (iPage == 1 && A_Index == 1 && sControlType == "control1Fields")
						{
							CreateField(idx, sControlType)
							this.gcFormatField%idx%.Value := sText
							this.gcFormatField%idx%.SetFont("italic " g_color_dark_blue, "Verdana")
						} 	

						;The order of the following group of statements must not be changed
						;********************************************************************
						
						;Underline this line AND any that may immediately follow it
						;(since these are titles that can be long and broken into more than one line)
						if (this._sNextStyle == "underline")
						{
							if (sText)
							{
								this._bLineGroup := true ;start a line group								

								fsz := 0
								;use font size of last line if it had been changed
								if (sLastBaseRomTitleFontSize) {
									fsz := sLastBaseRomTitleFontSize
									CreateField(idx, sControlType)
								}
								else
								{
									fsz := g_iGameInfoFontSize
									nw := CreateField(idx, sControlType)
									loop
									{
										tsz := GetTextExtentPoint(sText, "Verdana", fsz, true)
										if (tsz < nw * 96/A_ScreenDPI)
											break
										else
											fsz--
									}
								}

								sLastBaseRomTitleFontSize := fsz

								this.gcFormatField%idx%.Value := sText
								this.gcFormatField%idx%.SetFont("s" fsz " " g_color_light_green, "Verdana")
							}

							;an empy line means we have reached end of the line group
							if (!sText && this._bLineGroup)
							{
								this._sNextStyle := "" 
								this._bLineGroup := false
							}
						}

						;Italicize this line
						if (this._sNextStyle == "italics" && sText)
						{
							CreateField(idx, sControlType)
							this.gcFormatField%idx%.Value := sText
							this.gcFormatField%idx%.SetFont("italic " g_color_dark_blue)
							this._sNextStyle := "underline" ;Next line with text will be underlined
						}

						if (InStr(sText, "<===OriginalGameInformation/>"))
						{
						    this._sNextStyle := "italics" ;Next line with text will be in italics
						}

						;********************************************************************

						;Main game title
						if (iPage == 1 && (A_Index == 3 || (A_Index == 4 && sText)) && sControlType == "control1Fields")
						{
							fsz := 0
							;use font size of last line if it had been changed
							if (sLastTitleFontSize) {
								fsz := sLastTitleFontSize
								CreateField(idx, sControlType)
							}
							else
							{
								fsz := g_iGameInfoFontSize + 4
								nw := CreateField(idx, sControlType, ht+6, -4) ;-4 pulls to left a bit to align margin at this larger font size
								loop
								{
									tsz := GetTextExtentPoint(sText, "Verdana", fsz, true)
									if (tsz < nw * 96/A_ScreenDPI)
										break
									else
										fsz--
								}
							}

							sLastTitleFontSize := fsz

							this.gcFormatField%idx%.Value := sText
							this.gcFormatField%idx%.SetFont("s" fsz " " g_color_light_green " bold", "Verdana")
						}
							 
						sPhrases := "
						(
						Bugs:,NOTE:,WIP:,HOW TO PLAY:,STORY:,TEST MODE:,LEVELS:,SETUP:,TEST MODE:.WIP:,* CONSOLES:,* OTHERS:,* COMPUTERS:,* HANDHELDS:,* TODO:,* GLITCH:,- HISTORY -,- TRIVIA -,- UPDATES -,- SCORING -,- CAST OF CHARACTERS -,- STAFF -,- CONTRIBUTE -,- TECHNICAL -,- TIPS AND TRICKS -,- SERIES -,- PORTS -
						)"

						if (IsAnyInStr(sText, sPhrases))
						{		
							CreateField(idx, sControlType)
							this.gcFormatField%idx%.Value := sText
							this.gcFormatField%idx%.SetFont(g_color_pale_yellow " w600", "Verdana")
						}

						if (InStr(sText, "<===")) ;signifies a section header
						{		
							CreateField(idx, sControlType)
							this.gcFormatField%idx%.SetFont("s" g_iGameInfoFontSize " " g_color_light_blue " bold underline", "Verdana")

							Switch sText
							{
								Case "<===GameInformation/>":
									this.gcFormatField%idx%.Value := "GAME INFORMATION"

								Case "<===OriginalGameInformation/>":
									this.gcFormatField%idx%.Value := "ORIGINAL GAME INFORMATION"

								Case "<===MAMEDevelopmentHistory/>":	
									this.gcFormatField%idx%.Value := "MAME DEVELOPMENT HISTORY"							
							}
						}	
						
						if (InStr(sText, "<row>")) ;signifies a highscore table row
						{
							fsz := g_iGameInfoFontSize
							nw := CreateField(idx, sControlType)
							iRow := Number(StrReplace(StrReplace(sText, "<row>", ""), "</row>", ""))
							loop
							{
								tsz := GetTextExtentPoint(aLeaderboard[iRow], "Consolas", fsz, true)
								if (tsz < nw * 96/A_ScreenDPI)
									break
								else
									fsz--
							}

							;CreateField(idx, sControlType)
							iRow := Number(StrReplace(StrReplace(sText, "<row>", ""), "</row>", ""))
							this.gcFormatField%idx%.Value := aLeaderboard[iRow]

							sInitials := ""  
							for i, j in g_oInitials
							{
								if (InStr(aLeaderboard[iRow], "│" j))
								{
									sInitials := j
									break
								}
							}
							
							if (sInitials)
								this.gcFormatField%idx%.SetFont("s" fsz " cYellow", "Consolas")
							else
								this.gcFormatField%idx%.SetFont("s" fsz, "Consolas")
						}
					}
				}

				;Creates the formatted field and positions it on the host control
				CreateField(idx, sControlType, fntsz:=ht, margin_adjust:=0)
				{				
					margin := sControlType == "control1Fields" ? edit_margin : edit_width + edit_margin	
					this.gcFormatField%idx% := this.guiGameInfo.AddEdit("c0xCCCCCC Background0x1F1F1F Hidden -VScroll -HScroll -E0x200 R1") ;A one row edit control
					pages[iPage][sControlType].Push(this.gcFormatField%idx%) 
					yPos := ht * (A_Index - 1)
					this.gcFormatField%idx%.Move(margin + margin_adjust, yPos, edit_width, fntsz)
					return edit_width + margin_adjust ;- edit_margin
				}

				iProg := this.gcGameInfoProgress.Value
				this.gcGameInfoProgress.Value := 100

				if (iProg == 100)
					Sleep 100
				else
					Sleep 500

				try this.gcGameInfoPleaseWait.Visible := this.gcGameInfoProgress.Visible := this.gcGameInfoLogo.Visible := false
			}
		}
		else ;assetType not "info", so must be an image type
		{
			asset_full_path := g_sAssetsFolder "\" assetType "\" this._rom "." sType

			this.guiGameInfo_GameImage%assetType% := this.guiGameInfo.AddPicture("BackgroundTrans Hidden vGameImage%" . assetType . "%", asset_full_path)		
			this.guiGameInfo_GameImage%assetType%.GetPos(&game_image_posX, &game_image_posY, &game_image_posW, &game_image_posH)
	
			;This is the enlargement limit to keep low res images from
			;becoming unreasonably pixelated
			nMaxEnlarge := 1.5

			image_width := game_image_posW * nMaxEnlarge
			image_width := image_width >= this._ScreenWidth ? this._ScreenWidth : image_width

			;Resize the image to fit on the screen while preserving aspect ratio
			image_height := image_width * game_image_posH / game_image_posW
	
			if (image_height > this._ScreenHeight)
			{
				image_height := this._ScreenHeight
				image_width := image_height * game_image_posW / game_image_posH
			}
			
			;center image
			image_x := Floor(this._ScreenWidth / 2 - image_width / 2)
			image_y := Floor(this._ScreenHeight / 2 - image_height / 2)
	
			this.guiGameInfo_GameImage%assetType%.Move(image_x, image_y, image_width, image_height)
	
			;Add this control to the oGameControl collection manager
			this.AddPage(assetType, bPageVisible, "guiGameInfo_GameImage" . assetType)
		}
	}

	HasContent()
	{
		tp := this._totalPages
		if (tp > 0)
			return true
		
		return false
	}

	CurrentPage
	{
		get => this._currentPage
	}

	CurrentPageType
	{
		get => this._pages[this._currentPage]["type"]
	}

	Active
	{
		get => this._active
	}
}