;Moves images from an image library source folder into
;a curated folder based on the rom list.
;Also creates a !missing.txt file in the folder.

#Requires AutoHotkey v2.0

#include ..\ReadListXML.ahk2

sAsset := "Marquee"

sROMFolder := "D:\Stand Alone\Arcade Time Capsule\RetroVRArcade\Content\Roms"
sSourceImageFolder := "E:\Development\Projects\arcadeVFE\src\Media\" sAsset
sDestinationFolder := "E:\Development\Projects\arcadeVFE\src\GameInfo\" sAsset
;sLogoFolder := "E:\Development\Projects\arcadeVFE\src\Media\Logo"
sGamesXMLFile := "E:\Development\Projects\arcadeVFE\src\GameInfo\games.xml"


;MoveImages
Loop Files sROMFolder "\*.zip"
{
    SplitPath(A_LoopFileName,,,,&OutNameNoExt)
    try FileCopy(sSourceImageFolder "\" OutNameNoExt ".*", sDestinationFolder)
}

;List missing images
try FileDelete(sDestinationFolder "\!missing.txt")
iMissing := 0 
global g_oLog := []

Loop Files sROMFolder "\*.zip"
{
    SplitPath(A_LoopFileName,,,,&OutNameNoExt)
 
    if (!FileExist(sDestinationFolder "\" OutNameNoExt ".png")) ;&& !FileExist(sDestinationFolder "\" OutNameNoExt ".jpg"))
    {
        oGameInfo := ReadListXML.GetXMLMetaInfo(sGamesXMLFile, OutNameNoExt)
        sDescription := ""
        try sDescription := oGameInfo["description"]
        FileAppend(OutNameNoExt " - " sDescription "`n", sDestinationFolder "\!missing.txt")

        ;This line will copy logo files for any missing items (useful for filling in missing marquees)
        ;try FileCopy(sLogoFolder "\" OutNameNoExt ".png", sDestinationFolder)

        iMissing++
    }
}

 FileAppend("Total Missing: " iMissing "`n", sDestinationFolder "\!missing.txt")

