;Return whether numbers are odd or even
Odd(iVal) => ((iVal & 1) != 0)
Even(iVal) => ((iVal & 1) == 0)

/**
 * Does a particular value from an array match a string?
 * This is a non-case sensitive match test.
 * @param aArray - The array of values to look for
 * @param sValue - The string to look for the values in
 * @param {String} sFoundValue - The value found (by ref)
 * @returns {Boolean} - Bool whether value was found
 */
IsValueInArray(aArray, sValue, &sFoundValue:="")
{
	for i, j in aArray
		if (sValue = j)
		{
			sFoundValue := j
			return 1
		}
	return 0
}

/**
 * Determines if any of the listed values are in the text string.
 * These are case sensitive exact match tests.
 * @param sText - the string to parse
 * @param sList - a list of comma separated values
 * @returns {Any} - the (first) string that was found
 */
IsAnyInStr(sText, sList)
{
	aList := StrSplit(sList, ",")
   	sFound := ""
   	for i, sVal in aList
   	{
      	if (InStr(sText, sVal))
      	{
			if (StrLen(sText) - StrLen(sVal) > 6)
				continue
         	sFound := sVal
         	break
    	}
   	}	
    
	return sFound
}

/**
 * Removes a value from an array and reindexes
 * @param aArray - byRef Array to remove value from
 * @param sValue - The value to remove
 * @returns {Integer} - true indicates value was found and removed
 */
RemoveValueFromArray(&aArray, sValue)
{
	bFound := false
	for i, j in aArray
	{
		if (j == sValue)
		{
			bFound := true
			aArray.RemoveAt(i)
			break
		}
	}

	return bFound
}

/**
 * Repeat a character the designated number of times
 * @param val - value to repeat
 * @param length - number of times to repeat
 * @returns {String} - the new string
 */
RepeatChar(val, length)
{
    result := ""
    Loop length
        result := result . val
    return result
}

/**
 * Pad a string with characters to a designated length.
 * Truncates string if it is longer than the padded length.
 * @param a - string to be padded
 * @param b - padded string length
 * @returns {String} - The padded (or truncated) string
 */
PadString(sVal, iLen, sChar:=A_Space)
{	
    padLen := iLen - StrLen(sVal)
    if (padLen < 0)
        return SubStr(sVal, 1, StrLen(sVal)-padLen)
    else
    {
        padding := RepeatChar(sChar, padLen)
        result := sVal . padding
    }
    return result
}

ChangeEncoding(&sStr, sFrom, sTo)
{
	buf := Buffer(StrPut(sStr, sFrom))
    StrPut(sStr, buf, sFrom)
    sStr := StrGet(buf, sTo)
}

 ;https://autohotkey.com/board/topic/27393-resize-text-control-to-fit-new-contents/  (converted to AHK2 by DGD)
 ;Permits reszing of text based on height/width considerations.
 GetTextExtentPoint(sString, sFaceName, nHeight := 9, bBold := False, bItalic := False, bUnderline := False, bStrikeOut := False, nCharSet := 0)
 {
    nSize := 0 ;initialize to avoid the warning
 
    hDC := DllCall("GetDC", "Ptr", 0, "Ptr") 
    nCaps := DllCall("GetDeviceCaps", "Uint", hDC, "Int", 90)
    nHeight := -DllCall("MulDiv", "Int", nHeight, "Int", nCaps, "Int", 72)
 
    hFont := DllCall("CreateFont", "Int", nHeight, "Int", 0, "Int", 0, "Int", 0, "Int", 400 + 300 * bBold, "Uint", bItalic, "Uint", bUnderline, "Uint", bStrikeOut, "Uint", nCharSet, "Uint", 0, "Uint", 0, "Uint", 0, "Uint", 0, "Str", sFaceName)
    hFold := DllCall("SelectObject", "Uint", hDC, "Uint", hFont)
 
    DllCall("GetTextExtentPoint32", "Uint", hDC, "Str", sString, "Int", StrLen(sString), "Int64P", &nSize)
 
    DllCall("SelectObject", "Uint", hDC, "Uint", hFold)
    DllCall("DeleteObject", "Uint", hFont)
    DllCall("ReleaseDC", "Uint", 0, "Uint", hDC)
 
    nWidth  := nSize & 0xFFFFFFFF
    nHeight := nSize >> 32 & 0xFFFFFFFF
 
    nWidth := nWidth * 96/A_ScreenDPI
 
    Return nWidth
 }

;https://www.autohotkey.com/boards/viewtopic.php?t=71295
;Puts commas in large numbers
ThouSep(X)
{
    N := (StrLen(Floor(Abs(X))) - 1) // 3
    Pat := "^(-?\d{1,3})" . SubStr("(\d{3})(\d{3})(\d{3})(\d{3})(\d{3})(\d{3})", 1, 7*N) . "(\.\d*)?$"
    Rep := "$1" . SubStr(",$2,$3,$4,$5,$6,$7", 1, 3*N) . "$" . N+2
    Return RegExReplace(X, Pat, Rep)
}

IsWinVisible(winTitle) 
{
    try {
        thisStyle := WinGetStyle(winTitle)
        visible := thisStyle & 0x10000000 ; 0x10000000 is WS_VISIBLE
        
        return visible
    }
    catch {
        return false
    }
}

/**
 * Use cross product to discover whether the point is on the same side
 * of all line segments. If so, the point is inside the polygon.
 * @param Points - the points in the polygon (in right rotational order)
 * @param p - the point
 * @returns {Boolean} - true if the point is inside, false if outside 
 */
IsPointInsideConvexPolygon(Points, p)
{
    ;Duplicate the first point at the end to complete the polygon
    Points.Push(Points[1])

    ;use cross product to test whether point is on the same side of all line segments
    loop Points.length - 1
    {
        i := A_Index
        if ((Points[i+1].X - Points[i].X) * (p.Y - Points[i].Y) - (Points[i+1].Y - Points[i].Y) * (p.X - Points[i].X)) < 0
            return false
    }

    return true
}

/**
 * Get the text control height for a specified font
 * @param sOptions - font options such as size, bold, etc.
 * @param sFont - the font name such as "Tahoma"
 * @returns {Integer} 
 */
GetTextHeight(sOptions, sFont)
{
    h := 0

    guiTemp := Gui()
    guiTemp.SetFont(sOptions, sFont)
    gcText := guiTemp.AddText(,"A")
    gcText.GetPos(,,,&h)
    guiTemp.Destroy()

    return h
}

/**
 * Get the height and width of an image.
 * @param sImage - full path to the image
 * @returns {Object} - object containing height and width (obj.H & obj.W) 
 */
GetPicDimensions(sImage)
{
    h := 0, w := 0

    guiTemp := Gui()
    gcText := guiTemp.AddPicture(,sImage)
    gcText.GetPos(,,&w,&h)
    guiTemp.Destroy()

    return {H:h, W:w}
}