if (FileExist(g_sArcadeFolder "\Arcade Time Capsule 3.6.Locations.ini"))
	try FileMove(g_sArcadeFolder "\Arcade Time Capsule 3.6.Locations.ini", g_sArcadeFolder "\Arcade Time Capsule 3.6.Directory.ini")

