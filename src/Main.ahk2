global TWO_WAY_V :=  "[Group, 2-way vertical]"
global FOUR_WAY  :=  "[Group, 4-way]"
global EIGHT_WAY :=  "[Group, 8-way]"
global ANALOG    :=  "[Group, analog]"
global DUAL      :=  "[Group, dual]"
global DIAGONAL  :=  "[Group, diagonal]"
global ROTARY    :=  "[Group, rotary]"
global SPINNER   :=  "[Group, spinner]"
global TRACKBALL :=  "[Group, trackball]"

global g_oLog := AppLog()
g_oLog.Init(g_sLogFolder "\log.txt", "arcadeVFE") ;initialize the application log
OnError LogError ;deal with unhandled exceptions

global g_oAuditLog := AppLog()

;Create configuration folder if it doesn't already exist
CreateDirAndLog(g_sConfigFolder)
CreateDirAndLog(g_sUserFolder)

;Process the command line if any args 
;Currently, the only supported parameter is the name of a specific named/saved
;<Action list>.json files
if (A_Args.Length > 0)
{
	g_oLog.LogLine("INFO: Ran with command line parameter: `"" A_Args[1] "`"`n") 
	SplitPath(A_Args[1],,,,&sArgNoExt) 
	loop files g_sUserFolder "\*.json"
	{		
		SplitPath(A_LoopFileName,,,,&sLoopFileNoExt)
		if (A_LoopFileName = A_Args[1] || sLoopFileNoExt = A_Args[1])
		{
			IniWrite(sLoopFileNoExt, g_sIniFile, "General", "ActionListName")
			break
		}
	}
}
else
{
	g_oLog.LogLine("INFO: Ran with no command line parameter`n") 
}

;==============================
;  Main Application Startup
;==============================

ShowSplash()                       ;Show splash screen
DoFileAudit()                      ;Confirm that all required runtime files are present
TrayMenu.BuildMenu()               ;Build tray menu
CreateDefaultActionList()          ;Create a default action list if one does not exist
LoadConfig()				       ;Load initializations from vfe.ini file
LoadTweaks()				       ;Load custom tweaks
Setup.CreateSetupDialog()          ;Load initial setup
Settings.CreateSettingsDialog()    ;Build Settings screen
StartRomWatcher()                  ;Begin monitoring the rom folder  

;Turn off splash screen after at least 4 seconds
if (IsSet(guiSplash))
{
	iSleepDelay := 4000 - (A_TickCount - g_iTickCount)                  
	if (iSleepDelay > 0)                     
		Sleep iSleepDelay					  
	guiSplash.Destroy		
}

Poll() ;Start button and keyboard polling loop

/**
 * Audit to ensure all required files are present
 */
DoFileAudit()
{
	bAuditSuccessful := true

	;Root folder files
	if (!FileExist(A_ScriptDir "\icons.dll"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\icons.dll" "`n")
	if (!FileExist(A_ScriptDir "\PacDrive64.dll"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\PacDrive64.dll" "`n")
	if (!FileExist(A_ScriptDir "\SDL2.dll"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\SDL2.dll" "`n")
	if (!FileExist(A_ScriptDir "\UltraStik64.dll"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\UltraStik64.dll" "`n")

	;.\GameInfo folder files
	if (!FileExist(g_sMameInfoFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sMameInfoFile "`n")
	if (!FileExist(g_sMameHistoryFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sMameHistoryFile "`n")
	if (!FileExist(g_sControlsIniFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sControlsIniFile "`n")
	if (!FileExist(g_sGamesXMLFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sGamesXMLFile "`n")
	if (!FileExist(g_sBaseRomsFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sBaseRomsFile "`n")

	;.\Audit folder files
	if (!FileExist(g_sMame2010))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sMame2010 "`n")
	if (!FileExist(g_sMame2014))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sMame2014 "`n")

	;.\Resources folder files
	if (!FileExist(g_sVFEIconFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sVFEIconFile "`n")  
	if (!FileExist(g_sVFEImageFile))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " g_sVFEImageFile "`n")

	;.\Arcade folder files
	if (!FileExist(A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Floors.json"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Floors.json" "`n")
	if (!FileExist(A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Directory.ini"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Directory.ini" "`n")
	if (!FileExist(A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.RomList.json"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.RomList.json" "`n")
	if (!FileExist(A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Vicinities.json"))
		bAuditSuccessful := false, g_oLog.LogLine("ERROR: Required file missing: " A_ScriptDir "\Arcade\Arcade Time Capsule 3.6.Vicinities.json" "`n")

	if (bAuditSuccessful)
		g_oLog.LogLine("INFO: All required runtime files confirmed to exist.`n")

	;Also audit optional files
	Loop Files A_ScriptDir "\User\*.json" {
		g_oLog.LogLine("INFO: Found action list file(s): " A_LoopFileName "`n")
	}

	if (FileExist(A_ScriptDir "\RawAccel\rawaccel.exe"))
		g_oLog.LogLine("INFO: RawAccel is present.`n")
	else
		g_oLog.LogLine("INFO: RawAccel is not present.`n")
}

CreateDefaultActionList()
{
	;Write default action list with default GameInfo navigation keys to minimally 
	;operate the screen; but only if there is no previous action list defined.
	if (!FileExist(g_sUserFolder "\*.json"))
	{
		mConfig := Map()
		mConfig["Keyboard"] := Map()

		mInfo := Map()
		mInfo["annunciation"] := ""
		mInfo["profile"] := ""
		mInfo["profile_2"] := ""
		mInfo["command_line_2"] := ""
		mInfo["template"] := ""
		mInfo["template_2"] := ""
		mInfo["template_3"] := ""
		mInfo["profile_3"] := ""
		mInfo["command_line_3"] := ""
		
		mInfo := mInfo.Clone()
		mInfo["command_line"] := "GameInfo Navigation: {Right}"
		mConfig["Keyboard"]["Right"] := Map()
		mConfig["Keyboard"]["Right"]["1"] := mInfo

		mInfo := mInfo.Clone()
		mInfo["command_line"] := "GameInfo Navigation: {Left}"
		mConfig["Keyboard"]["Left"] := Map()
		mConfig["Keyboard"]["Left"]["1"] := mInfo

		;Write the default action list
		sJSON := JSON.stringify(mConfig)

		fConfigFile := FileOpen(g_sUserFile, "w")

		fConfigFile.Write(sJSON)
		fConfigFile.Close()

		;Rebuild the g_oActions map
		sJSON := FileRead(g_sUserFile)
		global g_oActions := JSON.parse(sJSON)
	}
}

/**
 * Load general application settings from vfe.ini.
 * Set defaults when not found.
 */
LoadConfig()
{
	;************* Initialize GameInfo Default Settings ************************************
	;Initialize Settings GameInfo Monitor setting
	global g_iMonitor := Integer(IniRead(g_sIniFile, "GameInfo", "Monitor", g_iMonitor))
	IniWrite(g_iMonitor, g_sIniFile, "GameInfo", "Monitor")

	;Initialize Settings GameInfo HideCursor setting
	global g_bHideCursor := Integer(IniRead(g_sIniFile, "GameInfo", "HideCursor", g_bHideCursor))
	IniWrite(g_bHideCursor, g_sIniFile, "GameInfo", "HideCursor")

	;override if in test mode
	if (bTestMode)
		g_bHideCursor := 1

	;Initialize Settings GameInfo Exit key
	try {
		global g_sGameInfoSettingsExitKey := IniRead(g_sIniFile, "GameInfo", "SettingsExitKey")
	}
	catch {
		IniWrite(g_sGameInfoSettingsExitKey, g_sIniFile, "GameInfo", "SettingsExitKey")
	}

	;Initialize Settings GameInfo Right key
	try {
		global g_sGameInfoSettingsRightKey := IniRead(g_sIniFile, "GameInfo", "SettingsRightKey")
	}
	catch {
		IniWrite(g_sGameInfoSettingsRightKey, g_sIniFile, "GameInfo", "SettingsRightKey")
	}

	;Initialize Settings GameInfo Left key
	try {
		global g_sGameInfoSettingsLeftKey := IniRead(g_sIniFile, "GameInfo", "SettingsLeftKey")
	}
	catch {
		IniWrite(g_sGameInfoSettingsLeftKey, g_sIniFile, "GameInfo", "SettingsLeftKey")
	}	

    ;Initialize GameInfo image order
	try {
		global g_sImageOrder := IniRead(g_sIniFile, "GameInfo", "ImageOrder")
	}
	catch {
		IniWrite(g_sImageOrder, g_sIniFile, "GameInfo", "ImageOrder")
	}

	;Create the fully validated g_aImageOrder array accounting for possible
	;additional folders or deleted folders
	global g_aImageOrder := StrSplit(g_sImageOrder,",", " ") 
	aTempImageOrder := g_aImageOrder
	Loop Files A_ScriptDir "\GameInfo\Assets\*.*", "D"
	{
		if (!IsValueInArray(g_aImageOrder, A_LoopFileName))
			aTempImageOrder.Push(A_LoopFileName)
	}
	g_aImageOrder := aTempImageOrder
	for i, sImageFolder in g_aImageOrder
	{
		if (!DirExist(A_ScriptDir "\GameInfo\Assets\" sImageFolder))
			RemoveValueFromArray(&aTempImageOrder, sImageFolder)
	}
	g_aImageOrder := aTempImageOrder

	;*****************************************************************************************

	;Initialize delay between closing an app and restarting it to 500ms
	try {
		global g_iRestartDelay := Integer(IniRead(g_sIniFile, "General", "RestartDelay"))
	}
	catch {
		IniWrite(g_iRestartDelay, g_sIniFile, "General", "RestartDelay")
	}

	;Init delay between two consecutive command line calls to 1000ms
	try {
		global g_iCommandLineDelay := Integer(IniRead(g_sIniFile, "General", "CommandLineDelay"))
	}
	catch {
		IniWrite(g_iCommandLineDelay, g_sIniFile, "General", "CommandLineDelay")
	}

	;Init RawAccel path
	try {
		sRA := IniRead(g_sIniFile, "General", "RawAccelExe")

		;in case the folder was moved
		if (!FileExist(sRA))
		{
			if (FileExist(g_sRawAccelExe))
				IniWrite(g_sRawAccelExe, g_sIniFile, "General", "RawAccelExe")
		    else
				global g_sRawAccelExe := sRA
		}
	}
	catch {
		IniWrite(g_sRawAccelExe, g_sIniFile, "General", "RawAccelExe")
	}
}

/**
 * Load any application-specific tweaks from tweaks.json into g_oTweaks.
 * Create a default tweaks.json if not found.
 */
LoadTweaks()
{
	if (FileExist(g_sTweaksFile))
	{
		sJSON := FileRead(g_sTweaksFile)
		global g_oTweaks := JSON.parse(sJSON)
	}
	else
	{
		mTweaks := Map()

		;List applications that need to be restarted each time they are run.
		mTweaks["restart"] := Map()
		mTweaks["restart"]["VirtualController.exe"] := Map()
		mTweaks["restart"]["Add new exe here if needed"] := Map()

		sJSON := JSON.stringify(mTweaks)

		fTweaksFile := FileOpen(g_sTweaksFile, "w")

		fTweaksFile.Write(sJSON)
		fTweaksFile.Close()

		;Now rebuild the g_oActions map
		sJSON := FileRead(g_sTweaksFile)
		global g_oTweaks := JSON.parse(sJSON)
	}
}

/**
 * Initialize the ROM folder watcher. This monitors all the *.zip rom files in the folder for
 * changes to the last access timestamp. These detections raise a notification that inform
 * what game has just been loaded.
 */
StartRomWatcher()
{
	attrib := ""
	try	attrib := DirExist(g_sROMMonitorFolder)  
	
	if (attrib)
	{
		g_oLog.LogLine("INFO: StartRomWatcher. ROM Folder set to: `"" g_sROMMonitorFolder ".`n")

		;Ensure all rom files have a last-accessed date/time of a week ago. This is to address
		;a Windows deficiency in which the last-access date/time of files is not updated if the file
		;was previously accessed within the last hour or so (or sometimes since the last boot), so
		;we want them to look sufficiently old to force Windows to set the access timestamp that will
		;trigger our notification.
		FileSetTime DateAdd(A_Now, -7, "days"), g_sROMMonitorFolder "\*.zip", "A"

		;Register the folder whose files will be monitored for being accessed. 32 watches for changes
		;to the file access timestamp, and will notify RomAccess_Event() when such detections are made.
		WatchFolder(g_sROMMonitorFolder, RomAccess_Event, False, 32) ;32 = FILE_NOTIFY_CHANGE_LAST_ACCESS
	}
	else
	{
		if (g_sROMMonitorFolder == "")
			g_oLog.LogLine("INFO: StartRomWatcher. ROM Folder is not configured.`n")
		else
			g_oLog.LogLine("INFO: StartRomWatcher. ROM Folder: `"" g_sROMMonitorFolder "`" is invalid.`n")
	}
}

/**
 * Function called by the WatchFolder folder/file monitor whenever the access
 * timestamp on a file is changed.
 * @param sFolder - The folder in which a change was detected
 * @param aChanges - The specific changes detected, including the name of the file accessed.
 * @param bIgnore - if true, update the timestamp only and don't perform the action
 */
RomAccess_Event(sFolder, aChanges, bIgnore:=false) 
{
    static tLastFileName := ""

	if (g_bSuppressLastAccess)
	{
		global g_bSuppressLastAccess := false
		return
	}

	;get the name of the rom file that was accessed
	For Key, Change In aChanges {
		sNewROMFile := Change.HasOwnProp("Name") ? Change.Name : ""
	}

	;Changing the timestamp will trigger a second notification, so let's suppress it.
	if (tLastFileName == sNewROMFile)
	{   
		tLastFileName := ""
		return
	}

	;Force last-access timestamp of the **game we're about to exit** to a week ago. This is to overcome an issue in
	;which Windows does not natively update this timestamp if it is too recent, so lets make it look old so it does.	
	if (bIgnore && sFolder) ;this will be true if RomAccess_Event() was called manually just to update the access timestamp.
	{
		FileSetTime DateAdd(A_Now, -7, "days"), sFolder, "A"
		SplitPath(sFolder, &OutName)
		g_oLog.LogLine("INFO: Access timestamp updated on file (retroactive): `"" OutName "`"`n")
	}
	else if (g_sCurrentROM) ;this will be true if RomAccess_Event() was called by WatchFolder (note: g_sCurrentROM is a global)
	{
		FileSetTime DateAdd(A_Now, -7, "days"), g_sCurrentROM, "A"
		SplitPath(g_sCurrentROM, &OutName)
		g_oLog.LogLine("INFO: Access timestamp updated on file (active): `"" g_sCurrentROM "`"`n")
	}

	tLastFileName := g_sCurrentROM

	if (bIgnore)
		return

	;Return if the application is in an inactive state (such when in the Settings screen). In this case
	;it's important that we don't leave earlier than this point since any file activity can happen in
	;the dormant state and if it does, we still need to update the timestamps above. Also note that
	;we don't use the **PAUSE feature of WatchFolder since it has side-effects.
	if (!g_bActive)
		return

	g_oLog.LogLine("INFO: ROM file: `"" sNewROMFile "`" was accessed.`n")
	
	SplitPath(sNewROMFile,,,,&OutNameNoExt) ;strip off .zip extension

	mIndexer := Map()
	oAction := GetAction("ROM Monitor", OutNameNoExt, mIndexer)

	;if the action is not defined for the game, then look for a Group or Default action (if one exists)
	if (oAction.Key == "")
	{
		;Get the game's native controller info from controls.ini
		sControl := ""
		try sControl := IniRead(g_sControlsIniFile, "Controls", OutNameNoExt)

		sAction := ""
		;Select the appropriate action as listed in controls.ini (if one exists)
		Switch sControl
		{
			Case "2-way joystick (horizontal)":
				sAction := TWO_WAY_H
			Case "2-way joystick (vertical)":
				sAction := TWO_WAY_V
			Case "4-way joystick":
				sAction := FOUR_WAY
			Case "8-way joystick":
				sAction := EIGHT_WAY
			case "analog joystick", "49-way joystick (analog)":
				sAction := ANALOG
			Case "8-way joysticks (dual)", "4-way joysticks (dual)":
				sAction := DUAL
			Case "4-way joystick (diagonal)":
				sAction := DIAGONAL
			Case "8-way joystick (rotary)", "8-way joystick (twist)":
				sAction := ROTARY
			Case "spinner":
				sAction := SPINNER
			Case "trackball":
				sAction := TRACKBALL
		}

		oAction := GetAction("ROM Monitor", sAction, mIndexer)
		if (oAction.Key)
			g_oLog.LogLine("INFO: Using the " sAction " action for rom: " OutNameNoExt "`n")

		;no Group, so attempt to apply a [Default] action (if one exists)
		if (oAction.Key == "")
		{
			oAction := GetAction("ROM Monitor", "[Default]", mIndexer)
			if (oAction.Key)
				g_oLog.LogLine("INFO: Using the [Default] action for rom: " OutNameNoExt "`n")
		}

		;we tried everything, so report it to the log
		if (oAction.Key == "")
			g_oLog.LogLine("INFO: No action could be found for rom: " OutNameNoExt "`n")
	}
	
	RunAction(oAction) ;execute the action

	global g_sCurrentROM := sNewROMFile ;this *must* be above the call to ShowGameInfo()

	;Show GameInfo (but only if the option is turned on and the application is running)
	if ((gcShowGameInfo_Checkbox.Value && gcShowGameInfo_Checkbox.Enabled) && g_bOnlyMonitorWhenArcadeIsLoaded && ProcessExist(g_sApplicationName))
		ShowGameInfo(OutNameNoExt)	
}

/**
 * This gets called every 250ms when active. It is active whenever the main monitoring Poll() loop is 
 * not running and the g_bOnlyMonitorWhenArcadeIsLoaded is set to true. If it detects the application has
 * started/resumed running, it will kill its timer and resume monitoring by calling Poll().
 */
ApplicationProcessCheck_Callback()
{
	global g_bCancelPoll
	global g_iRawAccelPID

	;Terminate this timer if g_bCancelPoll gets set
	;Needed to support toggling of "Monitor only when Arcade running" option
	if (g_bCancelPoll)
	{
		g_bCancelPoll := false
		SetTimer(ApplicationProcessCheck_Callback, 0)
	}

	;if we are only supposed to monitor when an application is loaded and it is
	;now loaded, then call Poll() to start/resume monitoring
	if (g_bOnlyMonitorWhenArcadeIsLoaded && ProcessExist(g_sApplicationName))
	{
		g_oLog.LogLine("INFO: Application, `"" g_sApplicationName "`" detected.`n" )

		;Refresh the g_sCurrentROM timestamp since it might get replayed
		if (g_sCurrentROM) ;g_sCurrentROM is a global
		{
			global g_bSuppressLastAccess := true
			FileSetTime DateAdd(A_Now, -7, "days"), g_sCurrentROM, "A"
		}

		;Run RawAccel if the option is checked and it's available
		if (gcRawAccel_Checkbox.Value && FileExist(g_sRawAccelExe))
		{
			SplitPath(g_sRawAccelExe,,&OutDir)
			Run g_sRawAccelExe, OutDir, "Min", &g_iRawAccelPID
			g_oLog.LogLine("INFO: RawAccel started from: " g_sRawAccelExe ".`n" )
		}

		;terminate this timer since Poll() will now take up monitoring 
		;whether the app subsequently gets turned off
		SetTimer(ApplicationProcessCheck_Callback, 0) 
		Poll() 
	}
}

/**
 * Main handler for game controller buttons and keyboard key presses.
 * 
 * Set the global g_bCancelPoll := false to disable polling. 
 * Call Poll() to start/resume polling.
 */
Poll()
{
	global g_bCancelPoll
	global g_bActive := true
	global g_iRawAccelPID

	if (!g_bCancelPoll)
		g_oLog.LogLine("INFO: Polling started...`n" )

	;Register plain old AHK hotkeys for keypress handling
	for device, buttons in g_oActions
	{
		for button, sequences in buttons
		{
			if (device == "Keyboard" || device == "Mouse")
				Hotkey(button, PressedKey_Callback, "On")

			if (device == "Mouse" && !InStr(button, "Wheel"))
			    Hotkey(button " Up", PressedKey_Callback, "On")
		}
	}

	; To handle controller button presses we use SDL2 methods that are 
	; improvements over native AHK, thanks to these sources:
	; https://www.autohotkey.com/boards/viewtopic.php?t=115995
	; https://wiki.libsdl.org/SDL2/APIByCategory

	;Create buffer to receive SDL_Event
    evtBuffer := Buffer(56,0)

	;purge the buffer
	g_oSDL2.SDL_PumpEvents()
	g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONDOWN)
	g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONUP)
	g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYHATMOTION)
   
	mIndexer := Map() ;Used to keep track of button/key sequences

    ;Poll for SDL_Event 
    loop
    {
		PollEvent := g_oSDL2.SDL_PollEvent(evtBuffer)
		evt := SDL2DLL.SDL_Event(evtBuffer)

		;if we are only supposed to monitor when an application is loaded and it is
		;not currently loaded, then cancel the Poll() loop, and register a timer
		;to wait for the application to be loaded.
		if (g_bOnlyMonitorWhenArcadeIsLoaded && !ProcessExist(g_sApplicationName))
		{
			g_oLog.LogLine("INFO: Application, `"" g_sApplicationName "`" not detected.`n" )

			;shutdown RawAccel if it is running
			if (gcRawAccel_Checkbox.Value && g_iRawAccelPID)
			{
				ProcessClose(g_iRawAccelPID)
				g_iRawAccelPID := 0
				g_oLog.LogLine("INFO: RawAccel Closed.`n" )
			}

			;Turn off the GameInfo display if it is running
			if (g_oGameInfoDisplay.Active)
				g_oGameInfoDisplay.Clear()

			g_bCancelPoll := true

			;reset g_sLastActionKey in case any config changes are made 
			;externally while the application is closed.
			global g_sLastActionKey := ""

			;Reset the access timestamp of the last accessed rom by calling
			;RomAccess manually. This handles a use cases where the user plays a game,
			;exits the arcade, changes the Use GameInfo Overlay setting and then
			;returns to play the same game.
			Changes := Array()
			Changes.Push({Name: "Void"}) ;This is just a place holder
			RomAccess_Event(g_sCurrentROM, Changes, true)			

			global g_sCurrentROM := "" ;clear current rom

			;Start a monitor to poll the application for its resumption
			SetTimer(ApplicationProcessCheck_Callback)
		}

		if (g_bCancelPoll)
		{
			g_oLog.LogLine("INFO: Polling disabled.`n" )

			g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONDOWN)
			g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONUP)
			g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYHATMOTION)

			;disable hotkeys
			for device, buttons in g_oActions
			{
				for button, sequences in buttons
				{
					if (device == "Keyboard" || device == "Mouse")
						Hotkey(button, PressedKey_Callback, "Off")

					if (device == "Mouse" && !InStr(button, "Wheel"))
			    		Hotkey(button " Up", PressedKey_Callback, "Off")
				}
			}

			;set global flags
			g_bCancelPoll := false 
			g_bActive := false
			break
		}

		;Handle SDL button press events
		if (PollEvent)
		{
			if (evt.type == SDL_EventType.SDL_QUIT) ; Close event
			{
				g_oSDL2.SDL_Quit()		 
			}
			else if (evt.type == SDL_EventType.SDL_JOYBUTTONDOWN) 
			{
				;Get the next logical action from the action list based on the button press, then run it
				oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jbutton.which]], evt.jbutton.button, mIndexer)
				g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONDOWN)				
				
				if (oAction.Key) ;Don't run null actions
					RunAction(oAction, "Down")				
			}
			else if (evt.type == SDL_EventType.SDL_JOYBUTTONUP) 
			{
				;Get the next logical action from the action list based on the button press, then run it
				oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jbutton.which]], evt.jbutton.button, mIndexer)
				g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYBUTTONUP)				
				
				if (oAction.Key) ;Don't run null actions
					RunAction(oAction, "Up")				
			}
			else if (evt.type == SDL_EventType.SDL_JOYHATMOTION)
			{
				;Get the next logical action from the action list based on the button press, then run it
				if (evt.jhat.hatvalue)
				{
					Switch evt.jhat.hatvalue
					{
						Case SDL_EventType.SDL_HAT_UP:
							oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jhat.which]], "DPad Up", mIndexer)
						Case SDL_EventType.SDL_HAT_RIGHT:
							oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jhat.which]], "DPad Right", mIndexer)
						Case SDL_EventType.SDL_HAT_DOWN:
							oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jhat.which]], "DPad Down", mIndexer)
						Case SDL_EventType.SDL_HAT_LEFT:
							oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jhat.which]], "DPad Left", mIndexer)
					}

					if (oAction.Key) ;Don't run null actions
						RunAction(oAction)
				}

				g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYHATMOTION)				
			}

			/* ;Omit axis handling for now
			else if (evt.type == SDL_EventType.SDL_JOYAXISMOTION)
			{
				if (Abs(evt.jaxis.axisValue) >= 32767)
				{
					sDirection := ""

					Switch evt.jaxis.axis
					{
						Case 0, 2: ;XInput joystick right and left axis values
							sDirection := evt.jaxis.axisValue > 0 ? "Right" : "Left"
						Case 1, 3: ;XInput joystick up and down axis values
							sDirection := evt.jaxis.axisValue > 0 ? "Down" : "Up" 
						Case 4, 5: ;XInput left and right trigger axis values
						    if (evt.jaxis.axisValue < 0) ;skip trigger release
								sDirection := "Skip"
					}

					if (sDirection != "Skip")
					{
						;Get the next logical action from the action list based on the axis movement, then run it
						oAction := GetAction(g_aDevices[g_mDeviceIndex[evt.jaxis.which]], "Axis " evt.jaxis.axis " " sDirection, mIndexer)			
						
						if (oAction.Key) ;Don't run null actions
							RunAction(oAction)	
					}

					g_oSDL2.SDL_FlushEvent(SDL_EventType.SDL_JOYAXISMOTION)	
				}
			}
			*/
		}
		g_oSDL2.SDL_Delay(1)
    }
}

/**
 * Handler for the "Keyboard" and "Mouse" device types.
 * Performs the action defined by a keyboard or mouse hotkey press.
 * @param HotkeyName - A keyboard or mouse hotkey
 */
PressedKey_Callback(HotkeyName)
{
	static mIndexer := Map()
	sDev := "Mouse"

	;For mouse actions, even though we will be sending an action, we still want
	;to send the original mouse click, to not break normal mouse functions
	Switch HotkeyName
	{
		case "~LButton":
			oAction := GetAction(sDev, "~LButton", mIndexer)
			RunAction(oAction, "Down")
			return
		case "~LButton Up":
			oAction := GetAction(sDev, "~LButton", mIndexer)
			RunAction(oAction, "Up")
			return
		case "~RButton":
			oAction := GetAction(sDev, "~RButton", mIndexer)
			RunAction(oAction, "Down")
			return
		case "~RButton Up":
			oAction := GetAction(sDev, "~RButton", mIndexer)
			RunAction(oAction, "Up")
			return
		case "~MButton":
			oAction := GetAction(sDev, "~MButton", mIndexer)
			RunAction(oAction, "Down")
			return
		case "~MButton Up":
			oAction := GetAction(sDev, "~MButton", mIndexer)
			RunAction(oAction, "Up")
			return
		case "~X1":
			oAction := GetAction(sDev, "~X1", mIndexer)
			RunAction(oAction, "Down")
			return
		case "~X1 Up":
			oAction := GetAction(sDev, "~X1", mIndexer)
			RunAction(oAction, "Up")
			return
		case "~X2":
			oAction := GetAction(sDev, "~X2", mIndexer)
			RunAction(oAction, "Down")
			return
		case "~X2 Up":
			oAction := GetAction(sDev, "~X2", mIndexer)
			RunAction(oAction, "Up")
			return
		case "WheelUp":
			MouseClick("WheelUp")
		case "WheelDown":
			MouseClick("WheelDown")
		case "WheelRight":
			MouseClick("WheelRight")
		case "WheelLeft":
			MouseClick("WheelLeft")
		default:
			sDev := "Keyboard"
	}

	;Get the next logical action from the action list based on the key press, then run it
	oAction := GetAction(sDev, HotkeyName, mIndexer)
	RunAction(oAction)
}

/**
 * Get the next logical action. For button presses (keyboard, mouse, and game controllers) more than one action
 * can be assigned to a button. In these cases, the action changes sequentially with each button press. This
 * function returns that next sequential action. 
 * @param sDevice - Can be a game controller name, "Keyboard", "Mouse", or "ROM Monitor"
 * @param sAction - Can be the index of a game controller button, a keyboard key (or combo), mouse button, or a rom name (with no extension)
 * @param mIndexer - A static Map() provided by the caller to keep track of the sequence.
 * @returns {Map} - Returns a map containing an action consisting of a verbal annunciation and up to three command lines.
 */
GetAction(sDevice, sAction, mIndexer)
{
	seq := 1
	annunc := ""
	cl := ""
	cl_2 := ""
	cl_3 := ""

	for device, buttons in g_oActions
		for button, sequences in buttons
			for sequence, info in sequences
			{
				if (device == sDevice && button == sAction)
				{
					if (mIndexer.Has(device button))
					{
						if (mIndexer[device button] == A_Index)
						{
							if (A_Index != sequences.Count)
							{
								mIndexer[device button] := A_Index + 1
								annunc := g_oActions[device][button][String(A_Index + 1)]["annunciation"]
								cl := g_oActions[device][button][String(A_Index + 1)]["command_line"]
								cl_2 := g_oActions[device][button][String(A_Index + 1)]["command_line_2"]
								cl_3 := g_oActions[device][button][String(A_Index + 1)]["command_line_3"]
								seq := sequences.Count
								break 3
							}
							else
							{
								mIndexer[device button] := 1
								annunc := g_oActions[device][button]["1"]["annunciation"]
								cl := g_oActions[device][button]["1"]["command_line"]
								cl_2 := g_oActions[device][button]["1"]["command_line_2"]
								cl_3 := g_oActions[device][button]["1"]["command_line_3"]
								break 3
							}
						}
					}
					else 
					{
						mIndexer[device button] := 1
						annunc := info["annunciation"]
						cl := info["command_line"]
						cl_2 := info["command_line_2"]
						cl_3 := info["command_line_3"]
						break 3
					}
				}
			}

	oAction := Map()
	oAction.Key := cl cl_2 cl_3
	oAction.Device := sDevice
	oAction.Action := sAction
	oAction.Sequence := seq
	oAction.Annunciation := annunc
	oAction.CommandLine := cl
	oAction.CommandLine_2 := cl_2
	oAction.CommandLine_3 := cl_3
	
	return oAction
}

/**
 * Runs the action defined in oAction.  The action consists of an (optional) verbal annunciation
 * and up to three command lines.
 * @param oAction 
 * @param sModifier : "Down" or "Up" for button/key presses
 */
RunAction(oAction, sModifier:="")
{
	global g_sLastActionKey

	if (gcAlwaysAnnunciate_Checkbox.Value == 1 && oAction.Annunciation && sModifier != "Up")
		g_oVoice.Speak(oAction.Annunciation)

	;if a keypress action, send the key
	if (InStr(oAction.CommandLine, "Send Keypress:"))
	{
		if (!sModifier || sModifier == "Down")
		{
			iStartPos := InStr(oAction.CommandLine, "{")
			iEndPos := InStr(oAction.CommandLine, "}")
			iLength := iEndPos - iStartPos

			;separate down/up actions needed for MAME
			sKey := SubStr(oAction.CommandLine, iStartPos, iLength)
			Send sKey " down}"

			if (!sModifier) {
				Sleep 30
				Send sKey " up}"
			}

			return
		}	
		else if (sModifier == "Up")
		{
			iStartPos := InStr(oAction.CommandLine, "{")
			iEndPos := InStr(oAction.CommandLine, "}")
			iLength := iEndPos - iStartPos

			;separate down/up actions needed for MAME
			sKey := SubStr(oAction.CommandLine, iStartPos, iLength)
			Send sKey " up}"
			return
		}
	}

	;if a GameInfo navigation action, do the nav action
	if (InStr(oAction.CommandLine, "GameInfo Navigation:") && sModifier != "Up")
	{
		iStartPos := InStr(oAction.CommandLine, "{") + 1
		iEndPos := InStr(oAction.CommandLine, "}")
		iLength := iEndPos - iStartPos

		;extract the nav action
		sNavAction := SubStr(oAction.CommandLine, iStartPos, iLength)

		Sleep 0

		Switch sNavAction
		{
			Case "Right":
				g_oGameInfoDisplay.GoPage("r")
			Case "Left"	:		
				g_oGameInfoDisplay.GoPage("l")
			Case "Home":	
			    SplitPath(g_sCurrentROM,,,,&OutNameNoExt)
				if ((gcShowGameInfo_Checkbox.Value && gcShowGameInfo_Checkbox.Enabled) && g_bOnlyMonitorWhenArcadeIsLoaded && ProcessExist(g_sApplicationName))
					ShowGameInfo(OutNameNoExt)
			Case "Exit":			
				g_oGameInfoDisplay.Clear()

			Sleep 300
		}

		return
	}

	;if a command line action, don't run the same action twice in a row
	if (oAction.Key != g_sLastActionKey) 
	{
		g_oLog.LogLine("EXECUTING ACTION: Source: " oAction.Device ", Action: " oAction.Action ", Sequence: " oAction.Sequence "`n")

		if (oAction.CommandLine)
		{
			if (gcAlwaysAnnunciate_Checkbox.Value == -1)
				g_oVoice.Speak(oAction.Annunciation)
			
			if (gcBeep_Checkbox.Value == 1)
				SoundBeep
			
			RunCommandLine(oAction.CommandLine)
			
			if (oAction.CommandLine_2)
			{
				Sleep g_iCommandLineDelay
				RunCommandLine(oAction.CommandLine_2)
			}

			if (oAction.CommandLine_3)
			{
				Sleep g_iCommandLineDelay
				RunCommandLine(oAction.CommandLine_3)
			}			 
		}

		g_sLastActionKey := oAction.Key
	}
}

/**
 * Execute the command line
 * @param cl - The command line to execute
 */
RunCommandLine(cl)
{
	if (cl == "Set Ultimarc ServoStik: 4-way")
	{
		g_oPacDrive.PacSetServoStik4Way()
		g_oLog.LogLine("COMMAND: Set Ultimarc ServoStik: 4-way`n")
		return
	}

	if (cl == "Set Ultimarc ServoStik: 8-way")
	{
		g_oPacDrive.PacSetServoStik8Way()
		g_oLog.LogLine("COMMAND: Set Ultimarc ServoStik: 8-way`n")
		return
	}


	sExePath := SubStr(StrReplace(cl, '"'), 1, InStr(StrReplace(cl, '"'), ".exe") + 3)

	SplitPath sExePath, &OutFileName, &OutDir, &OutExtension, &OutNameNoExt, &OutDrive

	;Check the tweaks.json file to see if this app needs to be restarted
	sExeName := ""
	for tweak, j in g_oTweaks
	{
		if (tweak == "restart")
		{
			for exe_name, m in j
			{
				if (exe_name == OutFileName)
				{
					sExeName := exe_name
					break 2
				}
			}
		}
	}

	;Restart apps that would invoke multiple instances.	
	if (sExeName)
		if (ProcessExist(sExeName))
		{
			ProcessClose(sExeName)
			g_oLog.LogLine("COMMAND: Closed: " sExeName "`n")
		}
	
	Sleep g_iRestartDelay

	try Run cl, OutDir
	g_oLog.LogLine("COMMAND: Run: " cl "`n")
}

/**
 * Delete a file or folder and log the activity
 * @param t - is "D" (directory) or "F" (file)
 * @param f - is full name and path of the file or folder/directory. 
 * @returns {Integer} - 0 is success, 1 is failure, -1 means file doesn't exist
 */
DeleteAndLog(t, f)
{
	if (t == "F")
	{
		if (FileExist(f)) 
		{
			try {
				FileDelete(f)
			}
			catch as e {
				g_oLog.LogLine("INFO: File could not be deleted: " f ". Error was: " g_oLog.FormatErrorMessage(e) "`n")
				return 1
			}
			else {
				g_oLog.LogLine("INFO: Deleted file: " f "`n")
				return 0
			}
		}
	}
	if (t == "D")
	{
		if (FileExist(f)) 
		{
			try {
				DirDelete(f, true) ;true deletes even if files exist in folder
			}
			catch as e {
				g_oLog.LogLine("INFO: Folder could not be deleted: " f ". Error was: " g_oLog.FormatErrorMessage(e) "`n")
				return 1
			}
			else {
				g_oLog.LogLine("INFO: Deleted folder: " f "`n")
				return 0
			}
		}
	}

	return -1
}

/**
 * Create a directory and log the activity
 * @param d - The name of the directory
 * @returns {Integer} 
 */
CreateDirAndLog(d)
{
    if (!InStr(FileExist(d), "D"))
    {
        try
        {
            DirCreate d
        }
        catch
        {
            g_oLog.LogLine("NOTICE: Failed to create folder, " d "`n")
            return false
        }
        else        
        {
            g_oLog.LogLine("INFO: Created folder, " d "`n")  
            return true
        }         
    }

    return true
}

/**
 * Invoke the GameInfo display
 * @param sRomName - the rom name with no extension.
 */
ShowGameInfo(sRomName)
{
    static bFirstTime := true

	if (!sRomName)
		return

	if (!bFirstTime)
		g_oGameInfoDisplay.Clear()
	
	bFirstTime := false
	g_oGameInfoDisplay.CreateGameInfoScreen(sRomName)
	g_oGameInfoDisplay.CreateGameInfoPage("info") ;create the GameInfo pages

	;Create image pages for any images in the \GameInfo\Assets subfolders
	for i, sFolder in g_aImageOrder
	{
		if (FileExist(g_sAssetsFolder "\" sFolder "\" sRomName ".png"))
		{
			g_oGameInfoDisplay.CreateGameInfoPage(sFolder, "png")
			continue
		}

		if (FileExist(g_sAssetsFolder "\" sFolder "\" sRomName ".jpg"))
		{
			g_oGameInfoDisplay.CreateGameInfoPage(sFolder, "jpg")
			continue
		}
	}

	g_oGameInfoDisplay.GoPage("start")

	;If a rom access event occurrs for a new game while the GameInfo screen is still being loaded for
	;the previous game (e.g. player started a game, but then moved quickly to another), WatchFolder may
	;never call RomAccess_Event(), and the rom for the previous game will never have its access timestamp
	;updated. To address this, manually scan the zip files of all games (except the new one) to see if 
	;any have a recent access date. For any that do, we then call RomAccess_Event() manually, but with the Ignore
	;flag set to true to only update the timestamp and not to re-run the action (since the player is not  
	;actually playing this game right now).
	Loop Files g_sROMMonitorFolder "\*.zip"
	{
		if (A_LoopFilePath != g_sCurrentROM) {
			if (DateDiff(A_Now, FileGetTime(A_LoopFilePath, "A"), "Days") < 2) 
			{
				Changes := Array()
				Changes.Push({Name: "Void"}) ;This is just a place holder
				RomAccess_Event(A_LoopFilePath, Changes, true)
			}
		} 
	}
}

/**
 * Show a brief splash screen while loading
 */
ShowSplash()
{
	;Don't show splash on brand new startup since we'll be
	;going directly to the Setup dialog.
	if (!FileExist(g_sIniFile))
		return

	global guiSplash := Gui(, "vfeGuiSplash")

	dpi := 96 / A_ScreenDPI
	guiSplash.Opt("-Caption +ToolWindow +LastFound +AlwaysOnTop")
	guiSplash.BackColor := g_color_edit_text

	iHeight := 100
	iWidth := 400

	x1 := g_nScreenWidth / 2 - iWidth / 2
	y1 := g_nScreenHeight / 2 - iHeight / 2
	
	WinSetRegion x1/dpi "-" y1/dpi " w" iWidth/dpi " h" iHeight/dpi " r40-40" 

	global gcSplashIcon := guiSplash.AddPicture(, g_sVFEImageFile)

    gcSplashIcon.GetPos(&icon_posX, &icon_posY, &icon_posW, &icon_posH)

	iIconHeight := iHeight * 7/8 ;set icon height to 7/8 the window height

	;adjust icon size if needed while maintaining aspect ratio
	if (icon_posH > iIconHeight)
	{
		iconH := iIconHeight
		iconW := Floor(icon_posW * iIconHeight/icon_posH)
	}
	else
	{
		iconH := icon_posH
		iconW := icon_posW
	}

    gcSplashIcon.Move(x1 + 20, g_nScreenHeight / 2 - iconH / 2, iconH, iconW)
            
	global gcSplashTitle := guiSplash.AddText("x" x1 + 35 + iconW " y" y1 + 22 " w" iWidth " h" iHeight, "arcadeVFE")
	gcSplashTitle.SetFont("s26 w700", "Courier New")

	global gcSplashVer := guiSplash.AddText("x" x1 + 235 + iconW " y" y1 + 24 " w" iWidth " h" iHeight, g_sCodeVersion)
	gcSplashVer.SetFont("s19 w600", "Courier New")

	sArcade := IniRead(g_sIniFile, "General", "Arcade", "")
	sArcade := sArcade == "Other" || !sArcade ? "The Virtual Arcade Front End" : "for " sArcade
	global gcSplashSubtitle := guiSplash.AddText("x" x1 + 37 + iconW " y" y1 + 60 " w" iWidth " h" iHeight, sArcade)
	gcSplashSubtitle.SetFont("s10 w700", "Courier New")

	guiSplash.Show("NA w" g_nScreenWidth " h" g_nScreenHeight)
}

;Log otherwise unhandled errors (spawed by OnError)
LogError(e, mode)
{
	SystemCursor("On")
	sErr := "ERROR: Unhandled exception: " g_oLog.FormatErrorMessage(e)
    g_oLog.LogLine(sErr "`n")
	OutputDebug sErr
    ExitApp
}