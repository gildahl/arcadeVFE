/**
 * Create Settings Screen
 */
class Settings
{
	static sActionListName := "Arcade Controller"
	static sROMFolderOGText := ""
	static mMetrics := Map()
	static iCommandLinesUsed := 1
	static bIsRom := false

	;Action list constants
	static DEVICE := 1
	static ACTION := 2
	static SEQUENCE := 3
	static ANNUNC := 4
	static PROFILE := 5
	static COMMAND := 6
	static PROFILE_2 := 7
	static COMMAND_2 := 8
	static TEMPLATE := 9
	static TEMPLATE_2 := 10
	static TEMPLATE_3 := 11
	static PROFILE_3 := 12
	static COMMAND_3 := 13

	static CreateSettingsDialog()
	{
		global

		local nButtonWidth := 70
		local nButtonWidthWide := 90
		local nIconButtonWidth := 40
		local nButtonWidthBottom := 100

		sSettingsTitle := "arcadeVFE " CodeVersion " - Settings"

		Settings.mMetrics.Width := 910
		Settings.mMetrics.Height := 750
		Settings.mMetrics.X := Round((g_nScreenWidth / 2) - (Settings.mMetrics.Width * 96 // A_ScreenDPI / 2))
		Settings.mMetrics.Y := Round((g_nScreenHeight / 2) - (Settings.mMetrics.Height * 96 // A_ScreenDPI / 2)) - 100
		guiSettings := Gui(,sSettingsTitle)

		guiSettings.OnEvent("Close", (*) => Settings.Settings_Close())

		gcDevicesLabel := guiSettings.AddText("x" 30 " y" 10 " w" 250, "Device List")

		gcDevices := guiSettings.AddDropDownList("x" 30 " y" 25 " w" 320 " +BackgroundWhite",)
		gcDevices.OnEvent("Change", (*) => Settings.Devices_Change())
		gcDevices.TT := "Select a device or method that will trigger an action."

		;********************************************************************************************************
		;  Keyboard and Controller Device options
		;********************************************************************************************************
		
        gcButtonOptionsGroupBox := guiSettings.AddGroupBox("x" 380 " y" 10 " w" 410 " h" 88, "Action Type")

		gcCommandLine_Radio := guiSettings.AddRadio("vButtonOptionsGroup Checked " "x" 400 " y" 35, "Commands")
		gcCommandLine_Radio.OnEvent("Click", (*) => Settings.CommandLine_Radio_Click())
		gcCommandLine_Radio.TT := "Check this to create a command line button action."

		gcSendKey_Radio := guiSettings.AddRadio("x" 520 " y" 65, "Map a keypress")
		gcSendKey_Radio.OnEvent("Click", (*) => Settings.SendKey_Radio_Click())
		gcSendKey_Radio.TT := "Check this to map a keypress action."

		gcGameInfo_Radio := guiSettings.AddRadio("x" 520 " y" 35, "GameInfo navigation")
		gcGameInfo_Radio.OnEvent("Click", (*) => Settings.GameInfo_Radio_Click())
		gcGameInfo_Radio.TT := "Check this to map a GameInfo navigation action."

		gcSendKey_ComboBox := guiSettings.AddComboBox("x" 655 " y" 62 " w" 100 " +BackgroundWhite",)
		gcSendKey_ComboBox.OnEvent("Change", (*) => Settings.SendKey_ComboBox_Change())

		gcGameInfo_ComboBox := guiSettings.AddComboBox("x" 655 " y" 32 " w" 100 " +BackgroundWhite",)
		gcGameInfo_ComboBox.OnEvent("Change", (*) => Settings.GameInfo_ComboBox_Change())

		gcSendKey_ComboBox.Add(Settings.GetKeysArray())
		gcGameInfo_ComboBox.Add(["Right","Left","Home","Exit"])

		gcButtonOptionsGroupBox.Visible := gcSendKey_Radio.Visible := gcCommandLine_Radio.Visible := gcSendKey_ComboBox.Visible := gcGameInfo_Radio.Visible := gcGameInfo_ComboBox.Visible := false

		;********************************************************************************************************
		;  General Device options
		;********************************************************************************************************

		gcAnnunciationLabel := guiSettings.AddText("x" 30 " y" 55 " w" 250, "Voice notification phrase (optional)")
		gcAnnunciationEdit := guiSettings.AddEdit("x" 30 " y" 70 " w" 277 " +BackgroundWhite",)
		gcAnnunciationEdit.OnEvent("Change", (*) => Settings.AnnunciationEdit_Change())
		gcAnnunciationEdit.TT := "Word or phrase that will be spoken`nupon execution of the action."

		gcAnnunciationTestButton := guiSettings.AddButton("x" 310 " y" 69 " w" nIconButtonWidth)
		gcAnnunciationTestButton.OnEvent("Click", (*) => Settings.AnnunciationTestButton_Click())
		gcAnnunciationTestButton.Enabled := false
		gcAnnunciationTestButton.TT := "Test the voice phrase."
		GuiButtonIcon(gcAnnunciationTestButton, 'icons.dll', 20, 's16') ;megaphone icon

		gcROMDropDownLabel := guiSettings.AddText("x" 370 " y" 10 " w" 300, "Choose ROM")
		gcROMDropDown := guiSettings.AddDropDownList("x" 370 " y" 25 " w" 500 " +BackgroundWhite",)
		gcROMDropDown.OnEvent("Change", (*) => Settings.ROMDropDown_Change())
		gcROMDropDown.TT := "Select a group or game to monitor for activity."

		gcROMDropDownMAMEVersion := guiSettings.AddText("BackgroundTrans x" 370 " y" 10 " w" 480 " 0x1", "")   ;0x1 is for center justification
		gcROMDropDownController := guiSettings.AddText("BackgroundTrans x" 370 " y" 10 " w" 480 " 0x2", "") ;0x2 is for right justification
		gcROMDropDownGameRom := guiSettings.AddText("BackgroundTrans x" 373 " y" 45 " w" 480, "")
		gcROMDropDownGameInfo := guiSettings.AddText("BackgroundTrans x" 370 " y" 47 " w" 480 " 0x1", "")   ;0x1 is for center justification
		gcROMDropDownGameVersion := guiSettings.AddText("BackgroundTrans x" 370 " y" 47 " w" 480 " 0x2", "")

		gcFloorLabel := guiSettings.AddText("x" 370 " y" 73 " w" 20, "Floor:")
		gcFloorDropDown := guiSettings.AddDropDownList("x" 402 " y" 70 " w" 100 " +BackgroundWhite",)
		gcFloorDropDown.OnEvent("Change", (*) => Settings.FloorDropDown_Change())
		gcFloorDropDown.TT := "Floor that this machine resides on."

		gcVicinityLabel := guiSettings.AddText("x" 520 " y" 73 " w" 20, "Vicinity:")
		gcVicinityComboBox := guiSettings.AddComboBox("x" 561 " y" 70 " w" 233 " +BackgroundWhite",)
		gcVicinityComboBox.OnEvent("Change", (*) => Settings.VicinityComboBox_Change())
		gcVicinityComboBox.TT := "Select from list or type in a description of where the`nmachine is located on the floor to help you find it."

		gcAddVicinityButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*2 - 30 - 2 " y" 69 " w" nIconButtonWidth)
		gcAddVicinityButton.OnEvent("Click", (*) => Settings.AddVicinityButton_Click())
		gcAddVicinityButton.TT := "Add this vicinity to the list."
		gcAddVicinityButton.Enabled := false
		GuiButtonIcon(gcAddVicinityButton, 'icons.dll', 127, 's16') ;add (+) icon

		gcRemoveVicinityButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth - 30 " y" 69 " w" nIconButtonWidth)
		gcRemoveVicinityButton.OnEvent("Click", (*) => Settings.RemoveVicinityButton_Click())
		gcRemoveVicinityButton.TT := "Delete this vicinity from the list."
		gcRemoveVicinityButton.Enabled := false
		GuiButtonIcon(gcRemoveVicinityButton, 'icons.dll', 130, 's16') ;remove (-) icon

		Settings.SetLocationInfoVisiblity(false)

		;********************************************************************************************************
		;  Profiles and Templates
		;********************************************************************************************************
		gcProfileLabel := guiSettings.AddText("x" 60 " y" 123 " w" 80 " 0x2", "Profile")
		gcProfileEdit := guiSettings.AddEdit("x" 150 " y" 120 " w" 602 " +BackgroundWhite",)
		gcProfileEdit.OnEvent("Change", (*) => Settings.ProfileEdit_Change())
		gcProfileEdit.TT := "Enter a profile file and/or path to insert into the [profile_name] or`n[profile_full_name] field tag(s) of a command. If there are no field`ntags in the Command, you may leave this field blank."
		
		gcProfileBrowseButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 119 " w" nIconButtonWidth)
		gcProfileBrowseButton.OnEvent("Click", (*) => Settings.ProfileBrowseButton_Click())
		gcProfileBrowseButton.TT := "Browse for a profile to insert into the [profile_name] or`n[profile_full_name] field tag(s) of the command."
		GuiButtonIcon(gcProfileBrowseButton, 'imageres.dll', 206, 's16')

		gcTemplateLabel := guiSettings.AddText("x" 60 " y" 153 " w" 80 " 0x2", "Command")
		gcTemplateEdit := guiSettings.AddComboBox("x" 150 " y" 150 " w" 602 " +BackgroundWhite",)
		gcTemplateEdit.OnEvent("Change", (*) => Settings.TemplateEdit_Change())
		gcTemplateEdit.TT := "A command or command line template for this action. Templates may include`nfield tags such as [profile_name] and [profile_full_name] which will be replaced`nby the contents of the Profile field.`n`n[profile_name]`          will be replaced by the filename in the Profile field`n[profile_full_name]   will be replaced by the full path and filename in the Profile field."

		gcAddTemplateButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*2 - 30 - 2 " y" 149 " w" nIconButtonWidth)
		gcAddTemplateButton.OnEvent("Click", (*) => Settings.AddTemplateButton_Click())
		gcAddTemplateButton.TT := "Add this template definition to the list. It will also`nbe added to the Command 2 and 3 lists."
		gcAddTemplateButton.Enabled := false
		GuiButtonIcon(gcAddTemplateButton, 'icons.dll', 127, 's16') ;add (+) icon

		gcRemoveTemplateButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth - 30 " y" 149 " w" nIconButtonWidth)
		gcRemoveTemplateButton.OnEvent("Click", (*) => Settings.RemoveTemplateButton_Click())
		gcRemoveTemplateButton.TT := "Delete this template definition from the list. It will also`nbe deleted from the Command Line 2 and 3 template lists."
		GuiButtonIcon(gcRemoveTemplateButton, 'icons.dll', 130, 's16') ;remove (-) icon

		gcTestTemplateButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 149 " w" nIconButtonWidth)
		gcTestTemplateButton.OnEvent("Click", (*) => Settings.TestTemplateButton_Click())
		GuiButtonIcon(gcTestTemplateButton, 'icons.dll', 32, 's16') ;gear icon

		gcProfile_2_Checkbox := guiSettings.AddCheckbox("x" 40 " y" 193)
		gcProfile_2_Checkbox.OnEvent("Click", (*) => Settings.Profile_2_Checkbox_Click())
		gcProfile_2_Checkbox.TT := "Check this to enable configuration of`na second command for the action."

		gcProfileLabel_2 := guiSettings.AddText("x" 60 " y" 193 " w" 80 " 0x2", "Profile 2")
		gcProfileEdit_2 := guiSettings.AddEdit("x" 150 " y" 190 " w" 602 " +BackgroundWhite",)
		gcProfileEdit_2.OnEvent("Change", (*) => Settings.ProfileEdit_2_Change())
		gcProfileEdit_2.TT := "Enter a profile for a second command."

		gcProfileBrowseButton_2 := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 189 " w" nIconButtonWidth)
		gcProfileBrowseButton_2.OnEvent("Click", (*) => Settings.ProfileBrowseButton_2_Click())
		gcProfileBrowseButton_2.TT := "Browse for a profile to insert into the [profile_name] or`n[profile_full_name] field tag(s) of`nCommand 2."
		GuiButtonIcon(gcProfileBrowseButton_2, 'imageres.dll', 206, 's16')

		gcTemplateLabel_2 := guiSettings.AddText("x" 60 " y" 223 " w" 80 " 0x2", "Command 2")
		gcTemplateEdit_2 := guiSettings.AddComboBox("x" 150 " y" 220 " w" 602 " +BackgroundWhite",)
		gcTemplateEdit_2.OnEvent("Change", (*) => Settings.TemplateEdit_2_Change())
		gcTemplateEdit_2.TT := "A second command that will execute after the first."

		gcTestTemplateButton_2 := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 219 " w" nIconButtonWidth)
		gcTestTemplateButton_2.OnEvent("Click", (*) => Settings.TestTemplateButton_2_Click())
		gcTestTemplateButton_2.Enabled := false
		GuiButtonIcon(gcTestTemplateButton_2, 'icons.dll', 32, 's16') ;gear icon

		gcProfileLabel_2.Enabled := gcProfileEdit_2.Enabled := gcProfileBrowseButton_2.Enabled := gcTemplateLabel_2.Enabled := gcTemplateEdit_2.Enabled := false

		gcProfile_3_Checkbox := guiSettings.AddCheckbox("x" 40 " y" 263)
		gcProfile_3_Checkbox.OnEvent("Click", (*) => Settings.Profile_3_Checkbox_Click())
		gcProfile_3_Checkbox.TT := "Check this to enable configuration of`na third command for the action."
		gcProfile_3_Checkbox.Enabled := false

		gcProfileLabel_3 := guiSettings.AddText("x" 60 " y" 263 " w" 80 " 0x2", "Profile 3")
		gcProfileEdit_3 := guiSettings.AddEdit("x" 150 " y" 260 " w" 602 " +BackgroundWhite",)
		gcProfileEdit_3.OnEvent("Change", (*) => Settings.ProfileEdit_3_Change())
		gcProfileEdit_3.TT := "Enter a profile for a third command."

		gcProfileBrowseButton_3 := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 259 " w" nIconButtonWidth)
		gcProfileBrowseButton_3.OnEvent("Click", (*) => Settings.ProfileBrowseButton_3_Click())
		gcProfileBrowseButton_3.TT := "Browse for a profile to insert into the [profile_name] or`n[profile_full_name] field tag(s) of`nthe Command Line 3 template."
		GuiButtonIcon(gcProfileBrowseButton_3, 'imageres.dll', 206, 's16')

		gcTemplateLabel_3 := guiSettings.AddText("x" 60 " y" 293 " w" 80 " 0x2", "Command 3")
		gcTemplateEdit_3 := guiSettings.AddComboBox("x" 150 " y" 290 " w" 602 " +BackgroundWhite",)
		gcTemplateEdit_3.OnEvent("Change", (*) => Settings.TemplateEdit_3_Change())
		gcTemplateEdit_3.TT := "A third command that will execute after the second."

		gcTestTemplateButton_3 := guiSettings.AddButton("x" Settings.mMetrics.Width - nIconButtonWidth*3 - 30 - 4 " y" 289 " w" nIconButtonWidth)
		gcTestTemplateButton_3.OnEvent("Click", (*) => Settings.TestTemplateButton_3_Click())
		gcTestTemplateButton_3.Enabled := false
		GuiButtonIcon(gcTestTemplateButton_3, 'icons.dll', 32, 's16') ;gear icon

		gcProfileLabel_3.Enabled := gcProfileEdit_3.Enabled := gcProfileBrowseButton_3.Enabled := gcTemplateLabel_3.Enabled := gcTemplateEdit_3.Enabled := false

		;********************************************************************************************************
		;  Action Table
		;********************************************************************************************************
		gcStatusLabel := guiSettings.AddText("Center " "x" 250 " y" 325 " w" 400 " h" 20)
		gcStatusLabel.SetFont("cRed s10 w600")

		gcAssignButton := guiSettings.AddButton("x" 30 " y" 338 " w" nButtonWidthWide " h" 35, "Assign ROM")
		gcAssignButton.OnEvent("Click", (*) => Settings.AssignButton_Click())
		gcAssignButton.TT := "Press to add the ROM Monitor command set defined above`nas an action to the table."

		gcCancelAssignButton := guiSettings.AddButton("x" 30 + nButtonWidthWide + 5 " y" 338 " w" nButtonWidthWide " h" 35, "Cancel")
		gcCancelAssignButton.OnEvent("Click", (*) => Settings.CancelAssignButton_Click())
		gcCancelAssignButton.Enabled := false
		gcCancelAssignButton.TT := "Cancel the current Assign operation."

		gcActionListNameLabel := guiSettings.AddText("x" Settings.mMetrics.Width - 150 - 30 - 100 - 5 " y" 353 " w" 100 " 0x2", "Action list name:")
		gcActionListNameEdit := guiSettings.AddEdit("x" Settings.mMetrics.Width - 150 - 30 " y" 350 " w" 150 " +BackgroundWhite",)
		gcActionListNameEdit.OnEvent("Change", (*) => Settings.ActionListNameEdit_Change())
		gcActionListNameEdit.OnEvent("LoseFocus", (*) => Settings.ActionListNameEdit_LoseFocus())
		gcActionListNameEdit.TT := "This is the name that the Action List will be saved as. If you rename this,`nand save it as a new list, you may load it later by launching arcadeVFE with`nthe command line: vfe.exe <list name>."

		try gcActionListNameEdit.Text := IniRead(g_sIniFile, "General", "ActionListName", Settings.sActionListName)
		Settings.sActionListName := gcActionListNameEdit.Text
		global g_sUserFile := g_sUserFolder "\" gcActionListNameEdit.Text ".json"
		TrayMenu.SetMenuName("New", Settings.sActionListName)  
		guiSettings.Title := sSettingsTitle " - " g_sArcadeString " - " gcActionListNameEdit.Text
		g_oLog.LogLine("INFO: Loaded Arcade is: `"" g_sArcadeString "`"`n")
		g_oLog.LogLine("INFO: Loaded Action List is: `"" gcActionListNameEdit.Text "`"`n")

		gcListView := guiSettings.AddListView("-Multi" " r" 10 " x" 30 " y" 380 " w" Settings.mMetrics.Width - 30*2 " Grid", ["Device", "Action", "Sequence", "Voice Phrase", "", "Command", "", "Command 2", "", "", "", "", "Command 3"])
		fListView_ItemSelect := Settings.ListView_ItemSelect.Bind()
		gcListView.OnEvent("ItemSelect", fListView_ItemSelect)
		Settings.ResizeColumns()

		gcMoveUpButton := guiSettings.AddButton("x" 30 " y" 585 " w" nButtonWidthWide, "Move Up")
		gcMoveUpButton.OnEvent("Click", (*) => Settings.MoveUpButton_Click())
		gcMoveUpButton.Enabled := false
		gcMoveUpButton.TT := "Move the selected row up. If the action is part of a`nsequenced set, its sequence will be decremented."

		gcMoveDownButton := guiSettings.AddButton("x" 30 + nButtonWidthWide + 5 " y" 585 " w" nButtonWidthWide, "Move Down")
		gcMoveDownButton.OnEvent("Click", (*) => Settings.MoveDownButton_Click())
		gcMoveDownButton.Enabled := false
		gcMoveDownButton.TT := "Move the selected row down. If the action is part of a`nsequenced set, its sequence will be incremented."

		gcClearButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthWide*4 - 30 - 5*3 " y" 585 " w" nButtonWidthWide, "Clear all")
		gcClearButton.OnEvent("Click", (*) => Settings.ClearButton_Click())
		gcClearButton.Enabled := false
		gcClearButton.TT := "Clear all actions from the table."

		gcEditButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthWide*3 - 30 - 5*2 " y" 585 " w" nButtonWidthWide, "Copy action")
		gcEditButton.OnEvent("Click", (*) => Settings.EditButton_Click())
		gcEditButton.Enabled := false
		gcEditButton.TT := "Copy columns from the selected`nrow back into their edit fields."

		gcDeleteButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthWide*2 - 30 - 5 " y" 585 " w" nButtonWidthWide, "Delete action")
		gcDeleteButton.OnEvent("Click", (*) => Settings.DeleteButton_Click())
		gcDeleteButton.Enabled := false
		gcDeleteButton.TT := "Delete the selected row from the table."

		gcSaveButton := guiSettings.AddButton("x"  Settings.mMetrics.Width - nButtonWidthWide - 30 " y" 585 " w" nButtonWidthWide, "Save list")
		gcSaveButton.OnEvent("Click", (*) => Settings.SaveButton_Click())
		gcSaveButton.Enabled := false
		gcSaveButton.TT := "Save the Action List table."

		;********************************************************************************************************
		;  User Preferences
		;********************************************************************************************************
		gcUserPreferencesGroupBox := guiSettings.AddGroupBox("x" 30 " y" 630 " w" 530 " h" 95, "User Preferences")

		gcApplication_Checkbox := guiSettings.AddCheckbox("x" 45 " y" 653 " w" 220, "Monitor only when the arcade is running")
		gcApplication_Checkbox.OnEvent("Click", (*) => Settings.Application_Checkbox_Click())
		gcApplication_Checkbox.TT := "Keep arcadeVFE paused while the arcade emulator system`nsoftware is not running (recommended).`n`nTurning this off is primarily intended for testing. Note that`nyou will need to restart arcadeVFE after changing this setting."

		try gcApplication_Checkbox.Value := Integer(IniRead(g_sIniFile, "General", "MonitorApplication", 1))
		
		gcApplication_Checkbox.Enabled := gcApplicationEdit.Text ? true : false
		global g_bOnlyMonitorWhenArcadeIsLoaded := gcApplication_Checkbox.Enabled && gcApplication_Checkbox.Value == 1

		gcAlwaysAnnunciate_Checkbox := guiSettings.AddCheckbox("x" 45 " y" 677 " Check3", "Always voice notify")
		gcAlwaysAnnunciate_Checkbox.OnEvent("Click", (*) => Settings.AlwaysAnnunciate_Checkbox_Click())
		try gcAlwaysAnnunciate_Checkbox.Value := Integer(IniRead(g_sIniFile, "General", "AlwaysAnnunciate", 1))	
		gcAlwaysAnnunciate_Checkbox.TT := "Adjust when voice notification is used.`n`nChecked:      Always notify upon new game start.`nUnchecked:  Never notify (off).`nMinus:          Only notify when an action is performed."

		gcBeep_Checkbox := guiSettings.AddCheckbox("x" 45 " y" 700, "Beep on action")
		gcBeep_Checkbox.OnEvent("Click", (*) => Settings.Beep_Checkbox_Click())
		try gcBeep_Checkbox.Value := Integer(IniRead(g_sIniFile, "General", "BeepOnProfileChange", 0))	
		gcBeep_Checkbox.TT := "Checked:        Beep whenever an action is performed.`nUnchecked:    Never beep (off)"

		gcRawAccel_Checkbox := guiSettings.AddCheckbox("x" 280 " y" 700, "Run RawAccel")
		gcRawAccel_Checkbox.OnEvent("Click", (*) => Settings.RawAccel_Checkbox_Click())
		try gcRawAccel_Checkbox.Value := Integer((g_sIniFile, "General", "LoadRawAccel", 0))
		gcRawAccel_Checkbox.TT := "Run RawAccel when the arcade application starts`nand close it when the application terminates.`n`nRawAccel is expected to be in a subfolder called`n\RawAccel within the arcadeVFE folder."

		if (!FileExist(A_ScriptDir "\RawAccel\rawaccel.exe") || gcApplicationEdit.Text == '' || gcApplication_Checkbox.Value == 0)
			gcRawAccel_Checkbox.Enabled := false
        
		try global g_sRawAccelExe := IniRead(g_sIniFile, "General", "RawAccelExe", g_sRawAccelExe)

		gcShowGameInfo_Checkbox := guiSettings.AddCheckbox("x" 280 " y" 653, "Use GameInfo Overlay")
		gcShowGameInfo_Checkbox.OnEvent("Click", (*) => Settings.ShowGameInfo_Checkbox_Click())
		try gcShowGameInfo_Checkbox.Value := IniRead(g_sIniFile, "General", "ShowGameInfo", 0)	
		gcShowGameInfo_Checkbox.TT := "Show GameInfo overlay on the desktop when the arcade application`nstarts and close it when the application terminates.`n`nNote that if you use mouse clicks as your fire button, these may not work`nwhile the overlay is covering the emulator's screen. To fix this you may:`n(1) turn off this feature,`n(2) map your fire button to a controller button, or `n(3) display GameInfo on another monitor using the Monitor setting`n     in vfe.ini (try Monitor=2)."

		if (gcApplication_Checkbox.Value == 0)
			gcShowGameInfo_Checkbox.Enabled := false
	
		gcGameInfoFontSizeLabel := guiSettings.AddText("x" 330 " y" 673 " w" 100 " h" 20, "Font Size")
		gcGameInfoFontSizeLabel.SetFont("s7")

		try iGameInfoFontSize := IniRead(g_sIniFile, "General", "GameInfoFontSize", g_iDefaultGameInfoFontSize)
		gcGameInfoFontSizeEdit := guiSettings.AddEdit("x" 295 " y" 670 " w" 30 " +BackgroundWhite", iGameInfoFontSize)
		gcGameInfoFontSizeEdit.OnEvent("Change", (*) => Settings.GameInfoFontSizeEdit_Change())
		gcGameInfoFontSizeEdit.TT := "Enter the font size to be used`nfor the GameInfo screen."

		gcShowLocations_Checkbox := guiSettings.AddCheckbox("x" 440 " y" 653, "Edit Directory")
		gcShowLocations_Checkbox.OnEvent("Click", (*) => Settings.ShowLocations_Checkbox_Click())
		gcShowLocations_Checkbox.Value := IniRead(g_sIniFile, "General", "EditLocations", 0)	
		gcShowLocations_Checkbox.TT := "Enable editing the machine location`ninformation under the ROM list."

		gcShowLocations_Checkbox.Enabled := g_sArcadeString == "Other" ? false : true

		gcToolTip_Checkbox := guiSettings.AddCheckbox("x" 440 " y" 700, "Show Tooltips")
		gcToolTip_Checkbox.OnEvent("Click", (*) => Settings.ToolTip_Checkbox_Click())
		try gcToolTip_Checkbox.Value := Integer(IniRead(g_sIniFile, "General", "ShowToolTips", 1))
		gcToolTip_Checkbox.TT := "Show or hide tooltips on this screen."
        
		try global g_sRawAccelExe := IniRead(g_sIniFile, "General", "RawAccelExe", g_sRawAccelExe)

		gcSettingsMessageLabel := guiSettings.AddText("x" Settings.mMetrics.Width - 330 " y" 640 " w" 300, "arcadeVFE is currently **PAUSED**. Close this dialog when`nyou have completed configuration to begin active monitoring.")
		
		gcViewGameInfoButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthBottom*3 - 40 " y" 690 " w" nButtonWidthBottom " h" 30, "View GameInfo...")
		gcViewGameInfoButton.OnEvent("Click", (*) => Settings.ViewGameInfoButton_Click())
		gcViewGameInfoButton.TT := "View GameInfo for the selected game. Use left and right arrow`nkeyboard keys to navigate and Escape to exit.`n`nNote that when you use the GameInfo Overlay during gameplay`n(rather than this Settings dialog), navigation will use the keys or`nbuttons specified in the Action List."
		gcViewGameInfoButton.Enabled := false

		gcSetupButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthBottom*2 - 35 " y" 690 " w" nButtonWidthBottom " h" 30, "Initial Setup...")
		gcSetupButton.OnEvent("Click", (*) => Settings.SetupButton_Click())
		gcSetupButton.TT := "Open the intial setup`nand rom tools dialog."

		gcCloseButton := guiSettings.AddButton("x" Settings.mMetrics.Width - nButtonWidthBottom - 30 " y" 690 " w" nButtonWidthBottom " h" 30, "Close")
		gcCloseButton.OnEvent("Click", (*) => Settings.CloseButton_Click())
		gcCloseButton.TT := "Close this Settings dialog to begin active`nmonitoring.`n`nTo exit arcadeVFE completely, right-click`non its tray icon and choose Exit."

		;Complete initialization
		Settings.InitDevices()            ;Get and populate the list of devices (a.k.a. Action Sources)
		Settings.ReadTemplates()          ;Populate Template list from JSON file if available
		Settings.ReadFloors()		      ;Populate Floor list from JSON if available
		Settings.ReadVicinities()         ;Populate Vicinities list from JSON if available
		Settings.ReadActionList()         ;Populate Action list from JSON file if available
		Settings.FillRomList()            ;Populate the ROM list
	}

	/**
	 * Start SDL subsystem and initialize list of game devices
	 * https://www.autohotkey.com/boards/viewtopic.php?t=115995
	 * https://wiki.libsdl.org/SDL2/APIByCategory
	 */
	static InitDevices()
	{
		g_oSDL2.SDL_Init(SDL_INIT_EVERYTHING := -1) 

		g_oSDL2.SDL_InitSubSystem(SDL_INIT_JOYSTICK := 0x00000200)
		g_oSDL2.SDL_JoystickEventState(1)

		joyNum := g_oSDL2.SDL_NumJoysticks() 

		if (joyNum > 0)
		{
			loop joyNum
			{
				i := A_index - 1 ; because SDL joystick index starts from 0
				joystick := g_oSDL2.SDL_JoystickOpen(i)
				jidx := g_oSDL2.SDL_JoystickInstanceID(joystick)
				pguid := g_oSDL2.SDL_JoystickGetGUID(joystick)
				name := g_oSDL2.SDL_JoystickName(joystick)

				;each unique guid can have multiple, same-named devices
				;(like XBox controllers), so index each in an array
				if !g_mDevices.Has(pguid) {
					g_mDevices[pguid] := Array()
				}
				mDeviceInfo := Map()
				mDeviceInfo["name"] := name
				mDeviceInfo["index"] := jidx
				g_mDevices[pguid].Push(mDeviceInfo)
			}

			;Add "ROM Monitor"
			g_mDevices["000"] := Array()
			mDeviceInfo := Map()
			mDeviceInfo["name"] := "ROM Monitor"
			mDeviceInfo["index"] := 1
			g_mDevices["000"].Push(mDeviceInfo)

			;Add "Keyboard" device
			g_mDevices["001"] := Array()
			mDeviceInfo := Map()
			mDeviceInfo["name"] := "Keyboard"
			mDeviceInfo["index"] := 1
			g_mDevices["001"].Push(mDeviceInfo)

			/*
			;Add "Mouse" device
			g_mDevices["002"] := Array()
			mDeviceInfo := Map()
			mDeviceInfo["name"] := "Mouse"
			mDeviceInfo["index"] := 1
			g_mDevices["002"].Push(mDeviceInfo)
			*/

			;Create the list to display in the devices list
			for guid, j in g_mDevices
			{
				for device_index, device_info in g_mDevices[guid]
				{
					if (g_mDevices[guid].Length > 1)
					{
						g_aDevices.Push(device_info["name"] " " device_index)
						g_mDeviceIndex[device_info["index"]] := g_aDevices.Length 
					}
					else
					{
						g_aDevices.Push(device_info["name"])
						g_mDeviceIndex[device_info["index"]] := g_aDevices.Length
					}
				}
			}

			gcDevices.Add(g_aDevices)
			gcDevices.Value := 1
		}
	}

	/**
	 * Templates are the command line templates used to load game controller profiles. They  
	 * may include a field tag in brackets whose name determines how it is formatted:
	 * 
	 * [profile_name] = use the filename only
	 * [profile_full_name] = use the full pathname and filename
	 */
	static ReadTemplates()
	{
		if (!FileExist(g_sTemplatesFile))
		{
			sJSON := JSON.stringify(g_aDefaultTemplates)

			fTemplatesFile := FileOpen(g_sTemplatesFile, "w")
			fTemplatesFile.Write(sJSON)
			fTemplatesFile.Close()
		}

		;Now rebuild the global g_oTemplates object
		sJSON := FileRead(g_sTemplatesFile)
		global g_oTemplates := JSON.parse(sJSON)

		gcTemplateEdit.Add(g_oTemplates)
		try gcTemplateEdit.Choose(1)
		gcTestTemplateButton.TT := "Test this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit.Text, gcTemplateEdit.Text)

		gcTemplateEdit_2.Add(g_oTemplates)
		try gcTemplateEdit_2.Choose(1)
		gcTestTemplateButton_2.TT := "Test this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_2.Text, gcTemplateEdit_2.Text)

		gcTemplateEdit_3.Add(g_oTemplates)
		try gcTemplateEdit_3.Choose(1)
		gcTestTemplateButton_3.TT := "Test this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_3.Text, gcTemplateEdit_3.Text)
	}


	/**
	 * Read the arcade floors from the arcade-specific JSON file
	 */
	static ReadFloors()
	{
		if (FileExist(g_sFloorsFile))
		{
			sJSON := FileRead(g_sFloorsFile)
			global g_oFloors := JSON.parse(sJSON)

			gcFloorDropDown.Add(g_oFloors) ;
		}
	}

	/**
	 * Read the machine vicinities from the arcade-specific JSON file
	 */
	static ReadVicinities()
	{
		if (FileExist(g_sFloorsFile))
		{
			sJSON := FileRead(g_sVicinitiesFile)
			global g_oVicinities := JSON.parse(sJSON)

			gcVicinityComboBox.Add(g_oVicinities)
		}
	}

	/**
	 * Reads JSON config file the saved action list
	 * and populates the ListView table.
	 */
	static ReadActionList()
	{
		global

		;read any saved configuration
		if (FileExist(g_sUserFile))
		{
			sJSON := FileRead(g_sUserFile)
			g_oActions := JSON.parse(sJSON)
			g_oActions.Default := ""
			
			for device, j in g_oActions
				for button, t in j
					for sequence, info in t
					iRow := gcListView.Insert(1000,,device, button, sequence, info.Get("annunciation", ""), info.Get("profile", ""), info.Get("command_line", ""), info.Get("profile_2", ""),
			                info.Get("command_line_2", ""), info.Get("template", ""), info.Get("template_2", ""), info.Get("template_3", ""), info.Get("profile_3", ""), info.Get("command_line_3", ""))

			Settings.ResizeColumns()

			if (gcListView.GetCount() > 0)
				gcClearButton.Enabled := true
			else
				gcClearButton.Enabled := false
		}
	}

	/**
	 * Clear all entries in the Actions table
	 */
	static ClearTable()
	{
		gcListView.Delete()
		gcClearButton.Enabled := false

		Settings.ResizeColumns()
	}

	/**
	 * Program Exit
	 * @returns {Integer} 
	 */
	static Settings_Close(*)
	{
		Sleep 0

		SystemCursor("On")

		Settings.CancelAssign()

		result := "Yes"
		if (gcSaveButton.Enabled)
		{
			result := MsgBox("There unsaved changes to the Action List. Are you sure you want to exit?`n`nPress 'Yes' to exit without saving or 'No' to return to this screen.", "Close Settings?", 36)
		}
		else
		{
			if (gcActionListNameEdit.Text != Settings.sActionListName)
			{
				;In this case where there is nothing to save, but the user changed the Action List name, we just
				;change the name and make that the new default.
				if (FileExist(g_sUserFile))
					try FileMove(g_sUserFile, g_sUserFolder "\" gcActionListNameEdit.Text ".json")

				TrayMenu.SetMenuName(Settings.sActionListName, gcActionListNameEdit.Text)
				Settings.sActionListName := gcActionListNameEdit.Text
				global g_sUserFile := g_sUserFolder "\" Settings.sActionListName ".json"
				IniWrite(Settings.sActionListName, g_sIniFile, "General", "ActionListName")
				guiSettings.Title := sSettingsTitle " - " g_sArcadeString " - " gcActionListNameEdit.Text
			}
		}

		if (result == "Yes")
		{
			gcSaveButton.Enabled := false
			guiSettings.Hide()
			g_oLog.LogLine("INFO: Closed Settings dialog.`n")
			ToolTip("") ;kill any tooltips

			SetTimer(ApplicationProcessCheck_Callback, 0)
			Poll() ;resume monitoring
		}
		else
			return true
	}

	/**
	 * Fills the ROM list with game names. Uses the Game.xml file to obtain
	 * the full names of the games represented by the roms. If there is a duplicate name
	 * (as could happen if roms with multiple versions are loaded), the rom name will
	 * be appended to the name.
	 */
	static FillRomList()
	{
		global g_mRomsByName := Map()
		aGameList := Array()      ;the gamelist to be assigned to the list control
		sGameList := ""           ;used to sort the list
		gcROMDropDown.Delete()    ;make sure dropdown control is empty
		g_mRomsByName["[Default]"] := "[Default]"
		g_mRomsByName[TWO_WAY_H] := TWO_WAY_H
		g_mRomsByName[TWO_WAY_V] := TWO_WAY_V
		g_mRomsByName[FOUR_WAY] := FOUR_WAY
		g_mRomsByName[EIGHT_WAY] := EIGHT_WAY
		g_mRomsByName[ANALOG] := ANALOG
		g_mRomsByName[DUAL] := DUAL
		g_mRomsByName[DIAGONAL] := DIAGONAL
		g_mRomsByName[ROTARY] := ROTARY
		g_mRomsByName[SPINNER] := SPINNER
		g_mRomsByName[TRACKBALL] := TRACKBALL

		;Loop through all the rom files. These must have a *.zip extension
		Loop Files g_sROMMonitorFolder "\*.zip"
		{
			SplitPath(A_LoopFileName,,,, &OutNameNoExt)

			;Filter using the current arcade's audit list if available,
			;otherwise assume all roms in the folder are potentially valid
			if (g_oArcadeRomList.Count && g_sArcadeString != "Other")
			{
				if (!g_oArcadeRomList.Has(OutNameNoExt))
					continue
			}

			oGameInfo := ReadListXML.GetXMLMetaInfo(g_sGamesXMLFile, OutNameNoExt)
			
			if (oGameInfo)
			{
				if (g_mRomsByName.Has(oGameInfo["description"]))
				{
					 g_mRomsByName[oGameInfo["description"] " (" OutNameNoExt ")"] := OutNameNoExt ;duplicate, so add the rom name to make it unique
					 sGameList := sGameList oGameInfo["description"] " (" OutNameNoExt ")`n"
				}
				else
				{
					g_mRomsByName[oGameInfo["description"]] := OutNameNoExt 
					sGameList := sGameList oGameInfo["description"] "`n"
				}
			}
		}

		sGameList := Sort(sGameList)            ;sort the list by game name
		sGameList := sGameList, "`n"      
		sGameList := "[Default]`n" TWO_WAY_H "`n" TWO_WAY_V "`n" FOUR_WAY "`n" EIGHT_WAY "`n" ANALOG "`n" DUAL "`n" DIAGONAL "`n" ROTARY "`n" SPINNER "`n" TRACKBALL "`n" sGameList    ;make sure "[Default]" is at the top of the list
		sGameList := Trim(sGameList, "`n")
		aGameList := StrSplit(sGameList, "`n")

		gcROMDropDown.Add(aGameList)
		try gcROMDropDown.Value := 1
	}

	;============================================
	; Settings Screen events
	;============================================

	/**
	 * View GameInfo from within the Settings dialog
	 */
	static ViewGameInfoButton_Click(*)
	{
		;update from ini in case user updated during runtime
		global g_bHideCursor := Integer(IniRead(g_sIniFile, "GameInfo", "HideCursor", g_bHideCursor))

		if (!bTestMode && g_bHideCursor)
			SystemCursor("Off")
		SplitPath(gcROMDropDownGameRom.Text,,,,&OutNameNoExt)
		ShowGameInfo(OutNameNoExt)

		Hotkey(g_sGameInfoSettingsRightKey, ObjBindMethod(Settings.GameInfo_Callback,,g_sGameInfoSettingsRightKey), "On")
		Hotkey(g_sGameInfoSettingsLeftKey, ObjBindMethod(Settings.GameInfo_Callback,,g_sGameInfoSettingsLeftKey), "On")
		Hotkey(g_sGameInfoSettingsExitKey, ObjBindMethod(Settings.GameInfo_Callback,,g_sGameInfoSettingsExitKey), "On")
	}

	/**
	 * Process hotkeys used when manually accessing GameInfo from the Settings dialog
	 * @param params - param[1] is the Hotkey
	 */
	static GameInfo_Callback(params*)
	{
		Sleep 0

		Switch params[1]
		{
			Case "Right":
				g_oGameInfoDisplay.GoPage("r")
			Case "Left"	:		
				g_oGameInfoDisplay.GoPage("l")
			Case "Escape":	
				g_oGameInfoDisplay.Clear()
				Hotkey(g_sGameInfoSettingsRightKey, ObjBindMethod(Settings.GameInfo_Callback), "Off")
				Hotkey(g_sGameInfoSettingsLeftKey, ObjBindMethod(Settings.GameInfo_Callback), "Off")
				Hotkey(g_sGameInfoSettingsExitKey, ObjBindMethod(Settings.GameInfo_Callback), "Off")		
				SystemCursor("On")
				Sleep 300
		}
	}

	/**
	 * Save the button configurations in the ListView to a JSON configuration file. 
	 */
	static SaveButton_Click(*)
	{
		global g_bCancelAssign := true

		result := MsgBox("Are you sure you would like to save these settings?", "Save Settings?", 4132)

		if (result == "No")
			return

		;Handle changing Action list name
		if (gcActionListNameEdit.Text != Settings.sActionListName)
		{
			;We don't need to worry about gcActionListNameEdit.Text being blank since the field is automatically
			;reverted to the current Settings.sActionListName by the control itself anytime it is blank and loses focus.

			result := "Yes"
			result := MsgBox("You have changed the Action list name.`n`nPress 'Yes' to rename the list or 'No' to keep the previous list and save this one as the new default.`n`nSaved Action lists may be loaded by providing their name as a command line parameter when launching arcadeVFE.", "Action List Rename or Save New?", 4131)

			if (result == "Cancel")
				return

			if (result == "Yes") ;Rename option chosen
			{
				try FileDelete(g_sUserFile)
				g_oLog.LogLine("INFO: Renamed Action list (from: `"" Settings.sActionListName "`" to `"" gcActionListNameEdit.Text "`").`n")
			}

			TrayMenu.SetMenuName(Settings.sActionListName, gcActionListNameEdit.Text)
			Settings.sActionListName := gcActionListNameEdit.Text
			global g_sUserFile := g_sUserFolder "\" Settings.sActionListName ".json"
			IniWrite(Settings.sActionListName, g_sIniFile, "General", "ActionListName")
			guiSettings.Title := sSettingsTitle " - " g_sArcadeString " - " gcActionListNameEdit.Text
		}

		mConfig := Map()

		Loop gcListView.GetCount()
		{
			if (gcListView.GetText(A_Index, Settings.DEVICE))
			{
				mInfo := Map()
				mInfo["annunciation"] := gcListView.GetText(A_Index, Settings.ANNUNC)
				mInfo["profile"] := gcListView.GetText(A_Index, Settings.PROFILE) ;this is a hidden column
				mInfo["command_line"] := gcListView.GetText(A_Index, Settings.COMMAND)
				mInfo["profile_2"] := gcListView.GetText(A_Index, Settings.PROFILE_2)  ;this is a hidden column
				mInfo["command_line_2"] := gcListView.GetText(A_Index, Settings.COMMAND_2)
				mInfo["template"] := gcListView.GetText(A_Index, Settings.TEMPLATE)    ;this is a hidden column
				mInfo["template_2"] := gcListView.GetText(A_Index, Settings.TEMPLATE_2) ;this is a hidden column
				mInfo["template_3"] := gcListView.GetText(A_Index, Settings.TEMPLATE_3) ;this is a hidden column
				mInfo["profile_3"] := gcListView.GetText(A_Index, Settings.PROFILE_3)  ;this is a hidden column
				mInfo["command_line_3"] := gcListView.GetText(A_Index, Settings.COMMAND_3)
				if (!mConfig.Has(gcListView.GetText(A_Index, Settings.DEVICE))) 
					mConfig[gcListView.GetText(A_Index, Settings.DEVICE)] := Map()
				
				if (!mConfig[gcListView.GetText(A_Index, Settings.DEVICE)].Has(gcListView.GetText(A_Index, Settings.ACTION))) 
					mConfig[gcListView.GetText(A_Index, Settings.DEVICE)][gcListView.GetText(A_Index, Settings.ACTION)] := Map()

				mConfig[gcListView.GetText(A_Index, Settings.DEVICE)][gcListView.GetText(A_Index, Settings.ACTION)][gcListView.GetText(A_Index, Settings.SEQUENCE)] := mInfo
			}
		}

		sJSON := JSON.stringify(mConfig)

		fConfigFile := FileOpen(g_sUserFile, "w")

		fConfigFile.Write(sJSON)
		fConfigFile.Close()

		;Now rebuild the g_oActions map
		sJSON := FileRead(g_sUserFile)
		global g_oActions := JSON.parse(sJSON)

		gcSaveButton.Enabled := false

		Settings.RefreshList()

		g_oLog.LogLine("INFO: Saved Action list as `"" g_sUserFile "`".`n")
	}

	/**
	 * Handle requests to Exit the Settings screen
	 */
	static CloseButton_Click(*)
	{
		Settings.Settings_Close()
	}

	static SetupButton_Click(*)
	{
		guiSetup.Opt("+Owner" guiSettings.Hwnd)
		Setup.ShowSetupDialog()
	}

	static Devices_Change(*)
	{
		bROMControlVisible := true
		bGameControlVisible := false
		bKeyboardControlVisible := false

		if (gcDevices.Text == "ROM Monitor")
		{
			gcAssignButton.Text := "Assign ROM"
			gcAssignButton.TT := "Press to add the ROM Monitor command set defined above`nfor the " g_mRomsByName[gcROMDropDown.Text] " rom as an action to the table below."
		}
		else
		{
			if (gcDevices.Text == "Keyboard")
			{
				gcAssignButton.Text := "Assign Key"
				gcAssignButton.TT := "Press to assign a key or key combination,`nas the trigger for the commands defined above."
				bGameControlVisible := true
			}
			else if (gcDevices.Text == "Mouse")
			{
				gcAssignButton.Text := "Assign Button"
				gcAssignButton.TT := "Press to assign a mouse button,`nas the trigger for the commands defined above."
				bGameControlVisible := true

				Settings.RadioButtonStateUpdate()
			}
			else ;must be a game controller
			{
				gcAssignButton.Text := "Assign Button"
				gcAssignButton.TT := "Press to assign button from the " gcDevices.Text " device,`nas the trigger for the commands defined above."
				bGameControlVisible := true

				Settings.RadioButtonStateUpdate()
			}

			bROMControlVisible := false
		}

		;Set ViewGameInfo enable state
		gcViewGameInfoButton.Enabled := Settings.bIsRom && gcDevices.Text == "ROM Monitor" ? true : false

		;Set visibilty of controls only used in ROM Monitor Mode
		gcROMDropDownLabel.Visible := bROMControlVisible
		gcROMDropDown.Visible := bROMControlVisible
		gcROMDropDownGameInfo.Visible := bROMControlVisible
		gcROMDropDownGameVersion.Visible := bROMControlVisible
		gcROMDropDownGameRom.Visible := bROMControlVisible
		gcROMDropDownController.Visible := bROMControlVisible
		gcROMDropDownMAMEVersion.Visible := bRomControlVisible
		
		Settings.SetLocationInfoVisiblity(bROMControlVisible)

		;Set visibility of controls only used in Game Controller mode
		gcButtonOptionsGroupBox.Visible := bGameControlVisible
		gcCommandLine_Radio.Visible := bGameControlVisible
		gcGameInfo_Radio.Visible := bGameControlVisible
		gcGameInfo_ComboBox.Visible := bGameControlVisible

		if (gcDevices.Text == "Keyboard")
			bGameControlVisible := false
		gcSendKey_Radio.Visible := bGameControlVisible
		gcSendKey_ComboBox.Visible := bGameControlVisible

		;Clear any values in the Keyboard and Controller option combos
		gcCommandLine_Radio.Value := 1
		gcGameInfo_ComboBox.Value := ""
		gcSendKey_ComboBox.Value := ""
	}

	static SetLocationInfoVisiblity(bState)
	{
		;force invisibility if a group is selected in the rom list
		bState := bState && !InStr(gcROMDropDown.Text,"[")

		bShowLocations := false
		try bShowLocations := (gcShowLocations_Checkbox.Value && gcShowLocations_Checkbox.Enabled)

		if (!bShowLocations)
			bState := false

		gcFloorLabel.Visible := bState
		gcFloorDropDown.Visible := bState
		gcVicinityLabel.Visible := bState
		gcVicinityComboBox.Visible := bState
		gcAddVicinityButton.Visible := bState
		gcRemoveVicinityButton.Visible := bState
		
		try
		{
			if (gcShowLocations_Checkbox.Enabled && gcDevices.Text == "ROM Monitor" && !InStr(gcROMDropDown.Text,"["))
			{
				gcFloorLabel.Visible := true
				gcFloorDropDown.Visible := true
				gcVicinityLabel.Visible := true
				gcVicinityComboBox.Visible := true

				gcFloorDropDown.Enabled := gcShowLocations_Checkbox.Value
				gcVicinityComboBox.Enabled := gcShowLocations_Checkbox.Value
				gcAddVicinityButton.Visible := gcShowLocations_Checkbox.Value
				gcRemoveVicinityButton.Visible := gcShowLocations_Checkbox.Value
			}
		}	
	}

	static TemplateEdit_Change(*)
	{
		gcTestTemplateButton.TT := "Run this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit.Text, gcTemplateEdit.Text)

		if (gcTemplateEdit.Text == "")
		{
			gcAddTemplateButton.Enabled := false
			gcRemoveTemplateButton.Enabled := false
			gcTestTemplateButton.Enabled := false
			return
		}

		gcTestTemplateButton.Enabled := true

		;Disable Add button and enable remove button if template already exists
		aTemplates := Array()
		aTemplates := ControlGetItems(gcTemplateEdit)
		for i, j in aTemplates
		{
			if (j == gcTemplateEdit.Text)
			{
				gcAddTemplateButton.Enabled := false
				gcRemoveTemplateButton.Enabled := true
			    return
			}
		}

		;Template wasn't found
		gcAddTemplateButton.Enabled := true
		gcRemoveTemplateButton.Enabled := false
	}

	static TemplateEdit_2_Change(*)
	{
		gcTestTemplateButton_2.TT := "Run this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_2.Text, gcTemplateEdit_2.Text)
	}

	static TemplateEdit_3_Change(*)
	{
		gcTestTemplateButton_3.TT := "Run this command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_3.Text, gcTemplateEdit_3.Text)
	}

	static AnnunciationEdit_Change(*)
	{
		if (gcAnnunciationEdit.Text)
			gcAnnunciationTestButton.Enabled := true
		else
			gcAnnunciationTestButton.Enabled := false
	}

	static MoveUpButton_Click(*)
	{
		Settings.MoveRow(-1)
	}

	static MoveDownButton_Click(*)
	{
		Settings.MoveRow(1)
	}

	/**
	 * Moves a row up or down in the Action List
	 * @param iDirection - 1 = down, -1 = up
	 */
	static MoveRow(iDirection)
	{
		iRow := gcListView.GetNext()

		if ((iDirection == 1 && iRow < gcListView.GetCount()) || (iDirection == -1 && iRow > 1))
		{
			sDevice := gcListView.GetText(iRow, Settings.DEVICE)
			sButton := gcListView.GetText(iRow, Settings.ACTION)
			sSequence := gcListView.GetText(iRow, Settings.SEQUENCE)
			sAnnunciation := gcListView.GetText(iRow, Settings.ANNUNC)
			sProfile := gcListView.GetText(iRow, Settings.PROFILE)
			sCommandLine := gcListView.GetText(iRow, Settings.COMMAND)
			sProfile_2 := gcListView.GetText(iRow, Settings.PROFILE_2)
			sCommandLine_2 := gcListView.GetText(iRow, Settings.COMMAND_2)
			sTemplate := gcListView.GetText(iRow, Settings.TEMPLATE)
			sTemplate_2 := gcListView.GetText(iRow, Settings.TEMPLATE_2)
			sTemplate_3 := gcListView.GetText(iRow, Settings.TEMPLATE_3)
			sProfile_3 := gcListView.GetText(iRow, Settings.PROFILE_3)
			sCommandLine_3 := gcListView.GetText(iRow, Settings.COMMAND_3)

			gcListView.Delete(iRow)
		
			iRow := gcListView.Insert(iRow + iDirection,,sDevice, sButton, sSequence, sAnnunciation, sProfile, sCommandLine, sProfile_2, sCommandLine_2, sTemplate, sTemplate_2, sTemplate_3, sProfile_3, sCommandLine_3)
			gcListView.Modify(iRow, "+Select")
			gcListView.Modify(iRow, "Vis")
		}

		Settings.ResequenceList()

		gcSaveButton.Enabled := true
	}

	static AddTemplateButton_Click(*)
	{
		if (gcTemplateEdit.Text == "")
			return
		
		gcTemplateEdit.Add([gcTemplateEdit.Text])
		new_item := Settings.AddTemplates()

		;Also update gcTemplateEdit_2
		Settings.SyncTemplates()

		gcTestTemplateButton.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit.Text, gcTemplateEdit.Text)
		gcTestTemplateButton_2.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_2.Text, gcTemplateEdit_2.Text)
		gcTestTemplateButton_3.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_3.Text, gcTemplateEdit_3.Text)

		gcRemoveTemplateButton.Enabled := true
	}

	static RemoveTemplateButton_Click(*)
	{
		last := gcTemplateEdit.Value
		try gcTemplateEdit.Delete(gcTemplateEdit.Value)

		try {
			gcTemplateEdit.Choose(last)
		}
		catch
		{
			try gcTemplateEdit.Choose(last-1)
		}

		Settings.AddTemplates()

		;Also update gcTemplateEdit_2
		Settings.SyncTemplates()

		if (gcTemplateEdit.Text == "")
		{
			gcAddTemplateButton.Enabled := false
			gcRemoveTemplateButton.Enabled := false
		}

		gcTestTemplateButton.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit.Text, gcTemplateEdit.Text)
		gcTestTemplateButton_2.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_2.Text, gcTemplateEdit_2.Text)
		gcTestTemplateButton_3.TT := "Test the command line:`n" Settings.GetFormattedCommandLine(gcProfileEdit_3.Text, gcTemplateEdit_3.Text)
	}

