	static AddVicinityButton_Click(*)
	{
		if (gcVicinityComboBox.Text == "")
			return
		
		gcVicinityComboBox.Add([gcVicinityComboBox.Text])
		new_item := Settings.AddVicinities()

		gcRemoveVicinityButtonEnabled := true

		Settings.WriteVicinity()
	}

	static VicinityComboBox_Change(*)
	{
		Settings.WriteVicinity()

		;Update button states as needed
		if (gcVicinityComboBox.Text == "")
		{
			gcAddVicinityButton.Enabled := false
			gcRemoveVicinityButton.Enabled := false
			return
		}

		;Disable Add button and enable remove button if vicinity already exists
		aVicinities := Array()
		aVicinities := ControlGetItems(gcVicinityComboBox)
		for i, sVicinity in aVicinities
		{
			if (sVicinity == gcVicinityComboBox.Text)
			{
				gcAddVicinityButton.Enabled := false
				gcRemoveVicinityButton.Enabled := true
			    return
			}
		}

		;Vicinity wasn't found
		gcAddVicinityButton.Enabled := true
		gcRemoveVicinityButton.Enabled := false
	}

	static RemoveVicinityButton_Click(*)
	{
		last := gcVicinityComboBox.Value
		try gcVicinityComboBox.Delete(gcVicinityComboBox.Value)

		try {
			gcVicinityComboBox.Choose(last)
		}
		catch
		{
			try gcVicinityComboBox.Choose(last-1)
		}

		Settings.AddVicinities()

		if (gcVicinityComboBox.Text == "")
		{
			gcAddVicinityButton.Enabled := false
			gcRemoveVicinityButton.Enabled := false
		}

		Settings.WriteVicinity()
	}

	static WriteVicinity()
	{
		;Write vicinity to the location ini file
		sRom := ""
		try sRom := g_mRomsByName[gcROMDropDown.Text]

		if (sRom && !InStr(sRom, "["))
		{
			IniWrite(gcVicinityComboBox.Text, g_sDirectoryFile, sRom, "Vicinity")
		}
	}

